/**app.wxss**/
page {
  background: #ffffff;
}

page{



  --orange-50: #FFF5F0;
  --orange-100:#FFE8D8;
  --orange-200:#FFD0B0;
  --orange-300:#FFB088;
  --orange-400:#FF8A5C;
  --orange-500:#FF6B35;
  --orange-600:#E55A2B;
  --orange-700:#CC4A24;
  --orange-800:#A83D1F;


  --mint-50: #F0FDF7;
  --mint-100:#D1FAE5;
  --mint-200:#A7F3D0;
  --mint-300:#6EE7B7;
  --mint-400:#34D399;
  --mint-500:#10B981;
  --mint-600:#059669;


  --sky-50: #F0F9FF;
  --sky-100:#E0F2FE;
  --sky-200:#BAE6FD;
  --sky-300:#7DD3FC;
  --sky-400:#38BDF8;
  --sky-500:#0EA5E9;
  --sky-600:#0284C7;


  --honey-50: #FFFBEB;
  --honey-100:#FEF3C7;
  --honey-200:#FDE68A;
  --honey-300:#FCD34D;
  --honey-400:#FBBF24;
  --honey-500:#F59E0B;
  --honey-600:#D97706;



  --gray-0: #FFFFFF;
  --gray-50: #FAFAFA;
  --gray-100:#F5F5F7;
  --gray-150:#E5E5EA;
  --gray-200:#D1D1D6;
  --gray-300:#C7C7CC;
  --gray-400:#A1A1A6;
  --gray-500:#8E8E93;
  --gray-600:#6E6E73;
  --gray-700:#48484F;
  --gray-800:#1D1D1F;
  --gray-900:#0A0A0A;


  --success:    var(--mint-500);
  --success-soft:var(--mint-50);
  --warning:    var(--honey-500);
  --warning-soft:var(--honey-50);
  --error:      #EF4444;
  --error-soft: #FEF2F2;


  --surface-page:   #FFFFFF;
  --surface-card:   #FFFFFF;
  --surface-elevated:#FAFAFA;
  --surface-muted:  #F5F5F7;
  --surface-hover:  #F0F0F2;
  --surface-pressed:#E5E5EA;


  --text-primary:   #1D1D1F;
  --text-secondary: #6E6E73;
  --text-tertiary:  #8E8E93;
  --text-disabled:  #C7C7CC;
  --text-inverse:   #FFFFFF;
  --text-brand:     #FF6B35;
  --text-link:      #0EA5E9;


  --border-default: rgba(0,0,0,0.06);
  --border-strong:  rgba(0,0,0,0.10);
  --border-focus:   #FF6B35;
  --border-divider: #E5E5EA;


  --shadow-xs:  0 1px 3px rgba(0,0,0,0.04);
  --shadow-sm:  0 1px 4px rgba(0,0,0,0.05);
  --shadow-md:  0 2px 12px rgba(0,0,0,0.06);
  --shadow-lg:  0 4px 20px rgba(0,0,0,0.08);
  --shadow-xl:  0 8px 30px rgba(0,0,0,0.10);
  --shadow-modal:0 12px 40px rgba(0,0,0,0.15);


  --gradient-brand:     linear-gradient(135deg,#FF8A5C,#FF6B35);
  --gradient-brand-soft:linear-gradient(135deg,#FFB088,#FF8A5C);
  --gradient-surface:   linear-gradient(180deg,#FFFFFF,#FAFAFA);


  --font-sans:"PingFang SC","HarmonyOS Sans SC","MiSans","Noto Sans SC","Microsoft YaHei",-apple-system,"Helvetica Neue",sans-serif;
  --font-serif:var(--font-sans);
  --font-heritage:"Songti SC","Noto Serif SC","STSong",serif;
  --font-stamp:"Courier New",Courier,monospace;

  --text-xs:11px;
  --text-sm:12px;
  --text-base:13px;
  --text-md:13px;
  --text-lg:14px;
  --text-xl:15px;
  --text-2xl:17px;
  --text-3xl:19px;
  --text-4xl:24px;
  --text-5xl:34px;

  --weight-normal:400;
  --weight-medium:500;
  --weight-semibold:600;
  --weight-bold:700;

  --leading-tight:1.2;
  --leading-normal:1.5;
  --leading-relaxed:1.75;
  --leading-loose:2.0;
  --leading-2xl:2.2;


  --space-1:4px;
  --space-2:8px;
  --space-3:12px;
  --space-4:16px;
  --space-5:20px;
  --space-6:24px;
  --space-8:32px;
  --space-10:40px;


  --radius-sm:6px;
  --radius-md:10px;
  --radius-lg:12px;
  --radius-xl:14px;
  --radius-2xl:16px;
  --radius-full:999px;


  --duration-fast:150ms;
  --duration-normal:250ms;
  --duration-slow:350ms;
  --duration-slower:500ms;
  --ease-default:cubic-bezier(0.4,0,0.2,1);
  --ease-bounce:cubic-bezier(0.34,1.56,0.64,1);
  --ease-out:cubic-bezier(0,0,0.2,1);
  --ease-in:cubic-bezier(0.4,0,1,1);
}.serif{font-family:inherit}.lit .serif{font-family:var(--font-serif)}.phone{
    width:390px;
    height:min(780px,calc(100vh - 120px));
    background:var(--surface-page);
    border-radius:var(--radius-2xl);
    box-shadow:var(--shadow-modal);
    overflow:hidden;
    position:relative;
    display:flex;
    flex-direction:column;
  }.screen{flex:1;overflow-y:auto;position:relative}.page{display:none;padding:0 var(--space-4) var(--space-8);animation:fadein var(--duration-normal) var(--ease-default)}.page.active{display:block}.page-head{position:sticky;top:0;z-index:var(--z-sticky);background:var(--surface-page);padding-top:var(--space-1)}@keyframes fadein{from{opacity:0}to{opacity:1}}@keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.02)}}.cta{
    width:100%;
    height:48px;
    border:1.5px solid var(--orange-500);
    border-radius:var(--radius-full);
    background:var(--surface-card);
    color:var(--orange-500);
    font-size:var(--text-xl);
    font-weight:var(--weight-semibold);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
    position:relative;
    overflow:hidden;
  }.cta::before{
    content:"";
    position:absolute;
    inset:0;
    background:var(--gradient-brand);
    opacity:0;
    transition:opacity var(--duration-fast) var(--ease-default);
  }.cta:hover{border-color:var(--orange-600);color:var(--orange-600)}.cta:disabled{opacity:0.45;cursor:default;border-color:var(--gray-300);color:var(--gray-300)}.cta.solid{
    background:var(--gradient-brand);
    color:var(--text-inverse);
    border:none;
    box-shadow:0 2px 8px rgba(255,107,53,0.25);
  }.cta.solid:hover{box-shadow:0 4px 14px rgba(255,107,53,0.35)}.ghost{
    width:100%;
    height:40px;
    border:none;
    border-radius:var(--radius-full);
    background:var(--surface-muted);
    color:var(--text-primary);
    font-size:var(--text-md);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.ghost:hover{background:var(--surface-hover)}.mini-cta{
    height:34px;
    padding:0 20px;
    border:1.5px solid var(--orange-500);
    border-radius:var(--radius-full);
    background:var(--surface-card);
    color:var(--orange-500);
    font-size:var(--text-md);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.mini-cta:hover{background:var(--surface-hover);border-color:var(--orange-600);color:var(--orange-600)}.follow{
    height:30px;
    padding:0 16px;
    border-radius:var(--radius-full);
    border:1.5px solid var(--orange-500);
    background:none;
    color:var(--orange-500);
    font-size:var(--text-base);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    flex:none;
    transition:all var(--duration-fast) var(--ease-default);
  }.follow:hover{background:var(--surface-hover)}.follow.on{
    background:var(--gray-100);
    border-color:var(--gray-200);
    color:var(--text-tertiary);
  }.panel{
    background:var(--surface-card);
    border-radius:var(--radius-xl);
    padding:var(--space-5) var(--space-4);
    box-shadow:var(--shadow-sm);
    border:1px solid var(--border-default);
    transition:box-shadow var(--duration-fast) var(--ease-default);
  }.panel:hover{box-shadow:var(--shadow-md)}.panel-head{
    font-size:var(--text-sm);
    color:var(--text-secondary);
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom:var(--space-3);
    letter-spacing:0.5px;
  }.panel-head .t-b{
    font-size:var(--text-lg);
    color:var(--text-primary);
    font-weight:var(--weight-semibold);
    letter-spacing:0.5px;
  }.work-row{
    background:var(--surface-card);
    border-radius:var(--radius-lg);
    padding:var(--space-3) var(--space-4);
    margin-bottom:var(--space-2);
    box-shadow:var(--shadow-xs);
    border:1px solid var(--border-default);
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:var(--space-3);
    transition:all var(--duration-fast) var(--ease-default);
  }.work-row:hover{box-shadow:var(--shadow-sm);border-color:var(--border-strong)}.empty{
    background:var(--surface-card);
    border-radius:var(--radius-xl);
    padding:var(--space-8) var(--space-6);
    box-shadow:var(--shadow-sm);
    border:1px solid var(--border-default);
    text-align:center;
  }.empty .t-h3{
    font-size:var(--text-2xl);
    font-weight:var(--weight-semibold);
    letter-spacing:0.5px;
    margin-bottom:var(--space-3);
  }.empty .t-p{
    font-size:var(--text-base);
    color:var(--text-secondary);
    line-height:var(--leading-loose);
    margin-bottom:var(--space-5);
    letter-spacing:0.5px;
  }.c1{background:var(--surface-card)}.c2{background:var(--surface-card)}.c3{background:var(--surface-card)}.c4{background:var(--surface-card)}.c5{background:var(--surface-card)}.c6{background:var(--surface-card)}.avatar{
    width:56px;
    height:56px;
    border-radius:50%;
    background:var(--surface-muted);
    color:var(--orange-500);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    font-weight:var(--weight-medium);
  }.badge{
    display:inline-flex;
    align-items:center;
    font-size:var(--text-xs);
    font-weight:var(--weight-semibold);
    padding:2px 8px;
    border-radius:var(--radius-full);
    border:1px solid;
    background:var(--surface-card);
    font-style:normal;
    letter-spacing:1px;
  }.chips{
    display:flex;
    gap:var(--space-2);
    overflow-x:auto;
    padding:var(--space-1) var(--space-1) var(--space-4);
    scrollbar-width:none;
  }.chips::-webkit-scrollbar{display:none}.chip{
    flex:none;
    height:30px;
    padding:0 14px;
    border-radius:var(--radius-full);
    border:1px solid var(--border-default);
    background:var(--surface-card);
    color:var(--text-tertiary);
    font-size:var(--text-base);
    font-weight:var(--weight-medium);
    letter-spacing:0.5px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.chip:hover{border-color:var(--border-strong);color:var(--text-secondary)}.chip.on{
    background:var(--gradient-brand);
    border-color:transparent;
    color:var(--text-inverse);
    font-weight:var(--weight-semibold);
    box-shadow:0 2px 6px rgba(255,107,53,0.20);
  }.chip.on.mint{background:linear-gradient(135deg,#34D399,#10B981);box-shadow:0 2px 6px rgba(16,185,129,0.20)}.chip.on.sky{background:linear-gradient(135deg,#38BDF8,#0EA5E9);box-shadow:0 2px 6px rgba(14,165,233,0.20)}.chip.on.honey{background:linear-gradient(135deg,#FBBF24,#F59E0B);box-shadow:0 2px 6px rgba(245,158,11,0.20)}.chip.on.rose{background:linear-gradient(135deg,#F472B6,#EC4899);box-shadow:0 2px 6px rgba(236,72,153,0.20)}.form-row{margin-bottom:var(--space-4)}.form-row:last-child{margin-bottom:0}.form-row .t-label{
    display:block;
    font-size:var(--text-sm);
    color:var(--text-secondary);
    letter-spacing:1px;
    margin-bottom:var(--space-2);
    font-weight:var(--weight-medium);
  }.fi{
    width:100%;
    border:none;
    background:var(--gray-50);
    border-radius:var(--radius-md);
    padding:var(--space-3) var(--space-4);
    font-size:var(--text-lg);
    font-family:inherit;
    color:var(--text-primary);
    letter-spacing:0.5px;
    outline:none;
    resize:none;
    transition:all var(--duration-fast) var(--ease-default);
  }.fi:hover{background:var(--gray-100)}.fi:focus{
    background:var(--surface-card);
    box-shadow:0 0 0 2px rgba(255,107,53,0.25),0 0 0 4px rgba(255,107,53,0.08);
  }.fi::placeholder{color:var(--text-tertiary)}.seg{display:flex;gap:var(--space-2)}.seg button{
    flex:1;
    height:36px;
    border:1px solid var(--border-default);
    border-radius:var(--radius-full);
    background:var(--surface-card);
    color:var(--text-tertiary);
    font-size:var(--text-md);
    font-weight:var(--weight-medium);
    letter-spacing:0.5px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.seg button:hover{border-color:var(--border-strong);color:var(--text-secondary)}.seg button.on{
    border-color:var(--orange-500);
    color:var(--orange-500);
    font-weight:var(--weight-semibold);
    background:var(--surface-card);
    box-shadow:inset 0 0 0 1.5px var(--orange-500),0 1px 4px rgba(255,107,53,0.10);
  }.ed-card{
    border:1px solid var(--border-default);
    border-radius:var(--radius-lg);
    background:var(--surface-card);
    margin-bottom:var(--space-2);
    overflow:hidden;
    transition:border-color var(--duration-fast) var(--ease-default);
  }.ed-card:hover{border-color:var(--border-strong)}.ed-card.open{border-color:var(--orange-500);box-shadow:0 0 0 1px rgba(255,107,53,0.10)}.ed-head{
    display:flex;
    align-items:center;
    gap:var(--space-2);
    padding:var(--space-3) var(--space-4);
    cursor:pointer;
  }.ed-head .badge{flex:none}.ed-head .t-b{
    flex:1;
    min-width:0;
    font-size:var(--text-lg);
    font-weight:var(--weight-medium);
    letter-spacing:0.5px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }.ed-head .t-b.blank{color:var(--text-tertiary);font-weight:var(--weight-normal)}.ed-head .cnt{font-size:var(--text-xs);color:var(--text-tertiary);flex:none;letter-spacing:0.5px}.ed-head .arr{font-size:var(--text-lg);color:var(--text-tertiary);flex:none;transition:transform var(--duration-fast) var(--ease-default)}.ed-card.open .arr{transform:rotate(90deg)}.ed-body{display:none;padding:var(--space-3);border-top:1px solid var(--border-default)}.ed-card.open .ed-body{display:block}.ed-body .form-row{margin-bottom:var(--space-3)}.ed-del{
    height:32px;
    padding:0 14px;
    border:none;
    border-radius:var(--radius-full);
    background:var(--gray-100);
    color:var(--text-tertiary);
    font-size:var(--text-base);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.ed-del:hover{background:var(--error-soft);color:var(--error)}.ed-add{
    width:100%;
    height:44px;
    border:1.5px dashed var(--orange-500);
    border-radius:var(--radius-lg);
    background:none;
    color:var(--orange-500);
    font-size:var(--text-md);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    cursor:pointer;
    font-family:inherit;
    transition:all var(--duration-fast) var(--ease-default);
  }.ed-add:hover{background:var(--surface-hover)}.price-grid{display:flex;gap:var(--space-2);margin-top:var(--space-2)}.progress{
    height:4px;
    background:var(--gray-100);
    border-radius:var(--radius-full);
    overflow:hidden;
  }.progress .t-i{
    display:block;
    height:100%;
    background:var(--gradient-brand);
    border-radius:var(--radius-full);
    transition:width var(--duration-slow) var(--ease-bounce);
  }.dot{
    width:6px;
    height:6px;
    border-radius:50%;
    background:var(--surface-card);
    border:1.5px solid var(--orange-500);
    flex:none;
  }.dot.faint{background:var(--surface-card);border-color:var(--gray-200)}.tiny{
    font-size:var(--text-base);
    color:var(--text-tertiary);
    text-align:center;
    margin-top:var(--space-3);
    letter-spacing:0.5px;
    line-height:var(--leading-loose);
  }.intro{
    font-size:var(--text-md);
    line-height:var(--leading-loose);
    color:var(--text-secondary);
    letter-spacing:0.5px;
    margin:0 0 var(--space-1);
  }.wordmark{
    font-size:var(--text-lg);
    font-weight:var(--weight-semibold);
    letter-spacing:2px;
    color:var(--text-primary);
  }.today{
    font-size:var(--text-sm);
    color:var(--text-tertiary);
    letter-spacing:1px;
    font-variant-numeric:tabular-nums;
  }.shelf-slogan{
    font-size:var(--text-3xl);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    line-height:var(--leading-relaxed);
    padding:0 var(--space-1) var(--space-1);
    color:var(--text-primary);
  }.shelf-slogan .accent{color:var(--text-brand)}.tagline{
    font-size:var(--text-base);
    color:var(--text-tertiary);
    letter-spacing:1px;
    padding:0 var(--space-1) var(--space-6);
  }.list-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:0 var(--space-1) var(--space-3);
  }.count{
    font-size:var(--text-sm);
    color:var(--text-tertiary);
    font-weight:var(--weight-medium);
    letter-spacing:1px;
    font-variant-numeric:tabular-nums;
  }.sortseg{display:flex;gap:var(--space-4)}.sortseg button{
    background:none;
    border:none;
    font-size:var(--text-base);
    color:var(--text-tertiary);
    cursor:pointer;
    font-weight:var(--weight-medium);
    letter-spacing:0.5px;
    font-family:inherit;
    padding:2px 0;
    border-bottom:2px solid transparent;
    transition:all var(--duration-fast) var(--ease-default);
  }.sortseg button:hover{color:var(--text-secondary)}.sortseg button.on{color:var(--orange-500);border-bottom-color:var(--orange-500)}.shelf-tail{
    text-align:center;
    font-size:var(--text-sm);
    color:var(--text-tertiary);
    letter-spacing:2px;
    margin-top:var(--space-5);
  }#setBody .panel{margin-bottom:var(--space-3)}.rules{
    font-size:var(--text-base);
    color:var(--text-tertiary);
    line-height:var(--leading-loose);
    list-style:none;
    letter-spacing:0.5px;
  }.rules .t-li::before{content:"·";color:var(--orange-500);margin-right:9px;font-weight:var(--weight-bold)}.explain{
    font-size:var(--text-lg);
    line-height:var(--leading-loose);
    margin:auto 0;
    text-align:center;
    letter-spacing:1px;
    font-weight:var(--weight-normal);
    color:var(--text-primary);
  }.lit .explain{font-family:var(--font-serif);font-size:var(--text-lg)}.logo-box{
    width:34px;
    height:34px;
    border-radius:50%;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:var(--text-lg);
    color:var(--orange-500);
    background:var(--surface-muted);
    font-family:var(--font-serif);
    font-weight:var(--weight-medium);
  }.subhead{
    display:flex;
    align-items:center;
    gap:var(--space-3);
    padding:var(--space-1) 0 var(--space-4);
  }.subhead .back{
    width:32px;
    height:32px;
    border-radius:50%;
    border:none;
    background:var(--surface-card);
    box-shadow:var(--shadow-sm);
    border:1px solid var(--border-default);
    font-size:17px;
    color:var(--orange-500);
    cursor:pointer;
    line-height:1;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:all var(--duration-fast) var(--ease-default);
  }.subhead .back:hover{background:var(--surface-hover)}.subhead .t-span{
    font-size:var(--text-xl);
    letter-spacing:1px;
    color:var(--text-primary);
    font-weight:var(--weight-medium);
  }.banner .t-b{
    font-size:var(--text-md);
    font-weight:var(--weight-semibold);
    letter-spacing:0.5px;
    flex:1;
    color:var(--text-primary);
  }.banner .t-span{
    font-size:var(--text-sm);
    color:var(--text-brand);
    letter-spacing:0.5px;
    font-weight:var(--weight-medium);
  }.stats{display:flex;gap:var(--space-2);margin-bottom:var(--space-3)}.stat{
    flex:1;
    background:var(--surface-card);
    border-radius:var(--radius-lg);
    padding:var(--space-3) var(--space-2);
