.rules-close{position:absolute;top:14px;right:16px;z-index:2}
.rules-kicker{font-size:11px;letter-spacing:3px;color:var(--ink-3)}
/* ═══ 每日提醒设置弹层（订阅消息 V1） ═══ */
.remind-desc{margin-top:10px;font-size:13px;line-height:1.7;color:var(--ink-2)}
.remind-time{display:flex;align-items:center;justify-content:space-between;
