/* ══════════════════════════════════════════════════════════
   V2.7 · 暖纸系统（设计 token 覆盖）
   纸层 / 暖灰墨层 / 珊瑚层 / 校准彩墨层 / 集齐金
   ══════════════════════════════════════════════════════════ */
page{
  --paper:#FFFFFF;
  --paper-page:var(--paper);  --paper-card:#FFFFFF;  --paper-deep:#F5F5F7;
  /* ═══ V1 · 纸品印刷系统 ═══ */
  --paper-face:#FAF6EF;
  --paper-env:#F3EBDD;
  --paper-env-deep:#EADFC9;
  --gold:#AE8A4E;
  --gold-soft:rgba(174,138,78,.4);
  --wax:#F2600F;
  --weave:repeating-linear-gradient(0deg,rgba(43,43,51,.016) 0 1px,transparent 1px 3px),
          repeating-linear-gradient(90deg,rgba(43,43,51,.016) 0 1px,transparent 1px 3px);
  --ink-1:#1D1D1F;  --ink-2:#6E6E73;  --ink-3:#8E8E93;  --ink-4:#C7C7CC;
  --ink-soft:var(--ink-3);  --ink-faint:var(--ink-4);
  --hairline:#E5E5EA;

  --brand:#FF6B35;  --brand-deep:#E5541F;  --brand-text:#FF6B35;  --brand-tint:#FFF1E8;
  --gold-deep:#7A5410;  --gold-mid:#D9A227;  --gold-light:#F0CF7E;

  --shadow-card:0 2px 8px rgba(0,0,0,0.06);
  --shadow-cta:0 2px 8px rgba(255,107,53,0.25);
  --r-card:10px;  --r-pill:999px;

  --font-mono:var(--font-sans);
  --font-serif:var(--font-sans);
  --font-heritage:"PosterSerif","Songti SC","Noto Serif SC","STSong",serif;
  --font-stamp:"Courier New",Courier,monospace;

  /* 映射现有 token，全局一次换底 */
  --surface-page:var(--paper-page);
  --surface-card:var(--paper-card);
  --surface-elevated:#FAFAFA;
  --surface-muted:var(--paper-deep);
  --surface-hover:#F0F0F2;
  --surface-pressed:#E5E5EA;

  --text-primary:var(--ink-1);
  --text-secondary:var(--ink-2);
  --text-tertiary:var(--ink-3);
  --text-disabled:var(--ink-4);
  --text-brand:var(--brand);
  --text-link:var(--sky-500);

  --border-default:rgba(0,0,0,0.06);
  --border-strong:rgba(0,0,0,0.10);
  --border-divider:var(--hairline);
  --border-focus:var(--brand);

  --orange-50:var(--brand-tint);
  --orange-100:#FFE8D8;
  --orange-200:#FFD0B0;
  --orange-300:#FFB088;
  --orange-400:#FF8A5C;
  --orange-500:var(--brand);
  --orange-600:var(--brand-deep);
  --orange-700:var(--brand-text);
  --orange-800:#9E3710;

  --mint-50:#F0FDF7;  --mint-100:#D1FAE5;  --mint-200:#A7F3D0;
  --mint-300:#6EE7B7; --mint-400:#34D399;  --mint-500:#10B981; --mint-600:#059669;
  --sky-50:#F0F9FF;   --sky-100:#E0F2FE;   --sky-200:#BAE6FD;
  --sky-300:#7DD3FC;  --sky-400:#38BDF8;   --sky-500:#0EA5E9; --sky-600:#0284C7;
  --honey-50:#FFFBEB; --honey-100:#FEF3C7; --honey-200:#FDE68A;
  --honey-300:#FCD34D;--honey-400:#FBBF24; --honey-500:#F59E0B; --honey-600:#D97706;
  --gold-300:var(--gold-light); --gold-400:#E8B84F;
  --gold-500:var(--gold-mid);   --gold-600:#B78413; --gold-700:var(--gold-deep);

  --gradient-brand:linear-gradient(135deg,#FF8A5C,#FF6B35);
  --gradient-brand-soft:linear-gradient(135deg,#FFB088,#FF8A5C);
  --gradient-surface:linear-gradient(180deg,#FFFFFF,#FAFAFA);

  --shadow-xs:0 1px 3px rgba(0,0,0,0.04);
  --shadow-sm:0 1px 4px rgba(0,0,0,0.05);
  --shadow-md:0 2px 12px rgba(0,0,0,0.06);
  --shadow-lg:0 4px 20px rgba(0,0,0,0.08);
  --shadow-xl:0 8px 30px rgba(0,0,0,0.10);
  --shadow-modal:0 12px 40px rgba(0,0,0,0.15);
}

/* P0 · CTA / 火漆 / 日期：纯珊瑚 + 暖阴影 */
.cta.solid{background:var(--gradient-brand);box-shadow:var(--shadow-cta);border:none}

.today{font-family:var(--font-mono);letter-spacing:.5px}
/* 情绪的声音：卡词 / 解签统一宋体 */


/* 彩墨只做小面积语言：地图点位用校准稀有度色 */


/* 集名 / 书脊：情绪的声音 */



/* 数字 / 计数：邮戳的声音 */
.stat .t-b,.count,.txn .td,.txn .ta{font-family:var(--font-mono)}

/* 阅读页去盒子化：订阅 / 全图（发现列表恢复浮起方框卡） */





#page-cards .stats{
  background:transparent;gap:0;border-top:1px solid var(--hairline);
  border-bottom:1px solid var(--hairline);padding:12px 0;margin-bottom:24px;
}
#page-cards .stat{
  background:transparent;border:none;box-shadow:none;border-radius:0;
  position:relative;padding:8px 6px;
}
#page-cards .stat + .stat::before{
  content:'';position:absolute;left:0;top:10px;bottom:10px;
  width:1px;background:var(--hairline);
}







#page-map .panel{background:transparent;border:none;box-shadow:none;padding:0}
#page-map .panel:hover{box-shadow:none}
#page-map .panel-head .t-b{font-family:var(--font-serif);font-size:20px;font-weight:600}





/* ══════ V2.8 · 详情页：纸面直排 ══════ */


#sp-intro-end{height:1px}

/* ══════ V2.9 · 抽卡页：三组法则 ══════ */
#page-draw{padding:var(--navtop, 0px) 0 0;background:var(--paper-page)}
.dw{
  min-height:calc(100vh - var(--navtop, 0px));
  box-sizing:border-box;background:var(--paper-page);
  display:flex;flex-direction:column;position:relative;
  padding:0 24px calc(32px + env(safe-area-inset-bottom));
}

/* 组③ 动作 */
.dw-actions{margin-top:22px;display:flex;flex-direction:column;align-items:center;}
.dw-btn{
  min-width:214px;height:52px;padding:0 32px;margin:0;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.dw-btn::after{border:none;}
.dw-btn.brand{background:var(--gradient-brand);color:#FFFFFF;box-shadow:var(--shadow-cta);}
.dw-btn.gold{background:var(--gold-mid);color:#FFFFFF;box-shadow:0 4px 14px rgba(217,162,39,.35);}
.dw-btn.ghost{
  background:transparent;color:var(--ink-2);height:40px;
  font-size:13px;font-weight:400;min-width:150px;border:1px solid var(--hairline);
}
.dw-btn + .dw-btn{margin-top:10px;}

/* ══════ V2.9 · 抽空页：金色时刻 ══════ */
.dp{
  position:fixed;left:0;top:0;right:0;bottom:0;z-index:var(--z-dp);
  background:var(--paper-deep);
  display:flex;align-items:center;justify-content:center;
  animation:dp-fade .4s ease both;
}
@keyframes dp-fade{from{opacity:0;}to{opacity:1;}}
.dp-inner{
  display:flex;flex-direction:column;align-items:center;
  padding:0 32px calc(24px + env(safe-area-inset-bottom));
}
.dp-eyebrow{
  font-family:var(--font-mono);font-size:11px;
  letter-spacing:3px;color:var(--ink-3);
}
.dp-title{
  margin-top:14px;font-family:var(--font-serif);font-weight:700;
  font-size:var(--text-5xl);color:var(--ink-1);animation:dp-rise .5s ease .1s both;
}
.dp-setname{
  margin-top:10px;font-family:var(--font-serif);font-size:16px;
  color:var(--ink-2);animation:dp-rise .5s ease .18s both;
}
.dp-goldline{
  margin-top:18px;width:40px;height:2px;
  background:linear-gradient(90deg,var(--gold-light),var(--gold-mid),var(--gold-deep));
  animation:dp-rise .5s ease .24s both;
}
@keyframes dp-rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
.dp-dots{margin-top:26px;display:flex;flex-wrap:wrap;justify-content:center;max-width:240px;}
.dp-dot{
  width:8px;height:8px;margin:7px;border-radius:50%;
  border:1.5px solid var(--ink-4);box-sizing:border-box;
}
.dp-dot.on{
  border-color:var(--ink-1);background:var(--ink-1);
  animation:dp-dot-in .32s ease both;
}
@keyframes dp-dot-in{from{transform:scale(.2);opacity:0;}to{transform:scale(1);opacity:1;}}
.dp-note{
  margin-top:20px;font-family:var(--font-mono);font-size:12px;
  letter-spacing:1px;color:var(--ink-3);
}
.dp-actions{
  margin-top:34px;display:flex;flex-direction:column;align-items:center;
  opacity:0;transform:translateY(12px);pointer-events:none;
  transition:opacity .35s ease,transform .35s ease;
}
.dp-actions.show{opacity:1;transform:none;pointer-events:auto;}
.dp-btn{
  min-width:214px;height:52px;padding:0 32px;margin:0;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.dp-btn::after{border:none;}
.dp-btn.gold{background:var(--gold-mid);color:#FFFFFF;box-shadow:0 4px 14px rgba(217,162,39,.35);}
.dp-btn.ghost{
  background:transparent;color:var(--ink-2);height:40px;
  font-size:13px;font-weight:400;min-width:150px;border:1px solid var(--hairline);
}
.dp-btn + .dp-btn{margin-top:10px;}

/* ══════ V3.0 · 订阅页 / 我的收藏册 ══════ */
#page-cards{padding:var(--navtop, 0px) 0 90px;background:var(--paper-page)}
#page-me{padding:var(--navtop, 0px) var(--space-4) 90px;background:var(--paper-page)}











.sb-cover.gold{border-color:var(--gold-mid);box-shadow:0 2px 8px rgba(217,162,39,.18)}





.sb-status.wait{color:var(--orange-500)}
.sb-status.ready{color:var(--orange-500);font-weight:600}
.sb-status.quiet{font-family:var(--font-mono);font-size:11px;letter-spacing:.5px;color:var(--ink-3)}
.sb-status.gold{color:var(--gold-deep);font-weight:600}




.sb-empty{margin-top:16vh;display:flex;flex-direction:column;align-items:center;text-align:center}
.sb-empty-title{font-family:var(--font-serif);font-size:17px;color:var(--ink-2)}
.sb-empty-sub{margin-top:10px;font-family:var(--font-mono);font-size:12px;letter-spacing:1px;color:var(--ink-3)}
.sb-btn{
  margin-top:28px;min-width:160px;height:44px;padding:0 28px;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;font-weight:600;letter-spacing:1px;line-height:1;
}
.sb-btn::after{border:none}
.sb-btn.ghost{background:transparent;color:var(--ink-2);border:1px solid var(--hairline)}





























/* 首页整页滚动：页头随内容一起上移，把高度让给卡集列表 */
#page-home .page-head{position:static;top:auto}
