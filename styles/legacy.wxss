.stats-empty-s{margin-top:3px;font-size:11px;color:var(--text-tertiary);letter-spacing:.03em}

/* ══════════════════════════════════════════════════════════
   V4 · 抽卡页卡本位（信封退役）
   状态类挂 .dw：is-idle / is-drawn / is-flipped / is-sealed / is-visited / unsealing
   依赖既有：dw-btn / dw-back / dw-hint / dw-actions / sigStampIn
   纪律：画布 #FFFFFF，暖纸只铺在抽卡舞台 .dw；卡面墨色由 --ink 内联注入
   ══════════════════════════════════════════════════════════ */
#page-draw{
  --ink:var(--ink-1);
  --ink-line:rgba(43,43,51,.30);
  --card-frame:12px;
  --dk-h:546px;
  --stack-2:#E4D4BA; --stack-3:#DDCBA9; --stack-4:#D5C099;
  background:var(--paper-page);
}
.dw{
  padding:0 0 calc(24px + env(safe-area-inset-bottom));
  background:var(--paper-env);
  overflow:hidden;                 /* 裁掉满幅卡 -1deg 与封条的外溢，防横向滚动 */
}

/* 顶栏 */
.dk-top{position:relative;height:56px;display:flex;align-items:center;justify-content:center}
.dk-top .dw-back{position:absolute;left:4px;top:12px}
.dk-title{font-family:var(--font-heritage);font-size:16px;font-weight:600;
  letter-spacing:.1em;color:var(--ink);max-width:60%;
  overflow:hidden;white-space:nowrap;text-overflow:ellipsis}

/* 舞台与满幅卡（5:7，高定宽） */
.dk-stage{position:relative;width:100%;display:flex;justify-content:center;
  padding-top:4px}
.dk-card{position:relative;height:var(--dk-h);width:calc(var(--dk-h)*5/7);
  max-width:100%;perspective:1200px;box-shadow:0 8px 24px rgba(43,43,51,.10)}

/* 卡堆边缘：e2/e3/e4 逐层下沉，形成可见的后卡堆 */
.dk-edge{position:absolute;inset:0;border-radius:2px;background:var(--stack-2);
  box-shadow:0 2px 6px rgba(43,43,51,.08);z-index:0;transform-origin:top center;
  transition:transform .28s var(--ease-out),opacity .28s var(--ease-out)}
.dk-edge.e2{transform:translateY(6px) scaleX(.986)}
.dk-edge.e3{background:var(--stack-3);transform:translateY(12px) scaleX(.972);transition-delay:.04s}
.dk-edge.e4{background:var(--stack-4);transform:translateY(18px) scaleX(.958);transition-delay:.08s}
.dw.is-drawn .dk-edge,.dw.is-flipped .dk-edge{
  opacity:0;transform:translateY(30px) scaleX(.96)}

/* 翻面容器 */
.dk-flip{position:absolute;inset:0;z-index:1;transform-style:preserve-3d;
  transition:transform .55s cubic-bezier(.32,.72,.28,1)}
.dk-flip.on{transform:rotateY(180deg)}
.dk-face{position:absolute;inset:0;backface-visibility:hidden;
  -webkit-backface-visibility:hidden;border-radius:2px;overflow:hidden}

/* 统一卡背 */
.dk-face.back{background-color:var(--paper-env-deep);background-image:var(--weave);
  display:flex;flex-direction:column;align-items:center;justify-content:center}

/* 正面：印刷面（一墨到底） */
.dk-face.front{transform:rotateY(180deg);
  background-color:var(--paper-face);background-image:var(--weave)}
.dk-face.front.sig .dk-keyline{display:block}

/* 题眼卡：金框 + 金印 */
.dk-face.front.sig .dk-frame{border-color:var(--gold);
  box-shadow:inset 0 0 0 3px var(--paper-face),inset 0 0 0 4px var(--gold-soft)}
.dk-goldmark{position:absolute;right:calc(var(--card-frame) + 10px);
  bottom:calc(var(--card-frame) + 46px);border:1px solid var(--gold);color:var(--gold);
  border-radius:2px;padding:4px 5px;display:flex;flex-direction:column;
  align-items:center;gap:1px;font-family:var(--font-heritage);
  font-size:calc(var(--dk-h)*.022);opacity:0}
.dw.is-flipped .dk-face.front.sig .dk-goldmark{opacity:1;
  animation:sigStampIn .62s cubic-bezier(.2,1.4,.4,1) .2s both}
.dw.is-visited .dk-goldmark{opacity:1;animation:none}

/* 金封条（付费墙） */
.dk-seal{position:absolute;top:30%;left:-4%;width:108%;height:26px;
  transform:rotate(-3deg);z-index:3}
.dk-seal-half{position:absolute;top:0;bottom:0;width:50%;
  background:linear-gradient(90deg,var(--gold-light),var(--gold-mid))}
.dk-seal-half.l{left:0}
.dk-seal-half.r{right:0;background:linear-gradient(90deg,var(--gold-mid),var(--gold-600))}
.dk-seal-txt{position:absolute;inset:0;display:flex;align-items:center;
  justify-content:center;font-size:12px;font-weight:600;letter-spacing:.12em;
  color:var(--gold-deep);text-shadow:0 1px 0 rgba(255,255,255,.35)}
.dw.unsealing .dk-seal-half.l{animation:sealFallL .3s ease-in forwards}
.dw.unsealing .dk-seal-half.r{animation:sealFallR .3s ease-in forwards}
.dw.unsealing .dk-seal-txt{opacity:0;transition:opacity .15s}
@keyframes sealFallL{to{transform:translate(-12px,16px) rotate(-14deg);opacity:0}}
@keyframes sealFallR{to{transform:translate(12px,16px) rotate(12deg);opacity:0}}

/* D1 抽出 */
.dw.is-drawn .dk-card{animation:dkDraw .36s var(--ease-out) both}
@keyframes dkDraw{0%{transform:none}55%{transform:translateY(-14px) rotate(-1.2deg)}100%{transform:none}}

/* 已抽回访：今日卡正面朝上平放（JS 同步加 .on，此处兜底） */
.dw.is-visited .dk-card{transform:rotateZ(-1deg)}
.dw.is-visited .dk-flip{transform:rotateY(180deg)}

/* 动作区切换：is-drawn 隐藏动作，只留翻面提示 */
.dk-act{display:none;flex-direction:column;align-items:center;
  animation:dkActIn .25s var(--ease-out) both}
.dw.is-idle .dk-act-idle{display:flex}
.dw.is-flipped .dk-act-done,.dw.is-visited .dk-act-done{display:flex}
@keyframes dkActIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.dw.is-flipped .dw-hint,.dw.is-visited .dw-hint{display:none}
.dw-actions{width:100%;padding:0 24px;box-sizing:border-box}
.dw-echo{margin-top:18px;padding:0 24px;box-sizing:border-box}
.dw-error{padding:0 24px;box-sizing:border-box}
.draw-rec{box-sizing:border-box;padding:18px 24px 0}

/* 已盖戳禁用态 */
.dw-btn:disabled,.dw-btn.is-disabled{
  background:transparent;color:var(--ink-4);
  border:1px solid var(--hairline);box-shadow:none;opacity:1;
}

/* ══════════════════════════════════════════════════════════
   V4 · 盖戳页满幅化（卡背 = 你的一天）
   状态类：.st-page.is-empty / .is-photo / .is-stamped
   注意：图片用 .st-photo，fallback 用 .st-empty，均与状态类分开
   ══════════════════════════════════════════════════════════ */
.modal.st-modal{
  align-items:stretch;justify-content:flex-start;padding:0;
  background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none;
}
.st-page{position:absolute;inset:0;width:100%;height:100%;
  background-color:var(--paper-face);background-image:var(--weave);overflow:hidden}
.st-photo{position:absolute;inset:0;width:100%;height:100%}
.st-veil{position:absolute;left:0;right:0;bottom:0;height:38%;
  background:linear-gradient(180deg,transparent,rgba(43,43,51,.16));pointer-events:none}

/* 关闭 + 左上铭牌 */
.st-close{position:absolute;top:calc(var(--navtop,0px) + 10px);left:12px;z-index:5;
  width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.9);border:1px solid rgba(43,43,51,.16);
  color:var(--ink-1);font-size:18px;line-height:1}
.st-plaque{position:absolute;top:calc(var(--navtop,0px) + 16px);left:54px;z-index:3;
  max-width:calc(100% - 176px);
  background:rgba(255,255,255,.92);border:1px solid rgba(43,43,51,.35);
  border-radius:2px;padding:4px 8px;display:flex;align-items:baseline;gap:8px;
  font-size:10px;letter-spacing:.12em;color:var(--ink-1)}
.st-plaque .st-no{opacity:.6;font-variant-numeric:tabular-nums}
.st-plaque .st-set{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}

/* 右上钢印：复用 .stamp 全套视觉，只覆盖定位与底垫 */
.st-stamp{position:absolute;top:calc(var(--navtop,0px) + 16px);right:16px;z-index:3;
  background:rgba(255,255,255,.82);mix-blend-mode:normal}
.st-stamp::before,.st-stamp::after{content:none}

/* 底部一句话纸条 */
.st-note{position:absolute;left:16px;right:16px;z-index:3;
  bottom:calc(140px + env(safe-area-inset-bottom));
  background:rgba(255,255,255,.88);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  border:1px solid rgba(43,43,51,.14);border-radius:10px;
  padding:12px 14px 20px;min-height:44px;
  font-size:15px;line-height:1.7;color:var(--ink-1);
  transition:transform .25s var(--ease-out)}
.st-note-input{width:100%;min-height:44px;background:transparent;
  font-size:15px;line-height:1.7;color:var(--ink-1)}
.st-note-input[disabled]{color:var(--ink-1);opacity:1}
.st-note-count{position:absolute;right:12px;bottom:6px;font-size:10px;
  color:var(--ink-3);font-variant-numeric:tabular-nums}
.st-page.is-stamped .st-note{transform:translateY(2px)}

/* 无照片 fallback：纸面 + 题眼水印 */
.st-empty{position:absolute;inset:0;z-index:2;background-color:var(--paper-face);
  background-image:var(--weave);display:flex;flex-direction:column;
  align-items:center;justify-content:center;padding:0 32px}
.st-empty-word{font-family:var(--font-heritage);font-size:34px;font-weight:600;
  color:var(--ink-1);opacity:.14;letter-spacing:.1em;text-align:center}
.st-empty-hint{margin-top:10px;font-size:12px;color:var(--ink-3);letter-spacing:1px}

/* 照片移除（仅未盖戳时） */
.st-photo-del{position:absolute;top:calc(var(--navtop,0px) + 64px);right:16px;z-index:3;
  width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.45);color:#FFF;font-size:16px;line-height:1}

/* 动作区 */
.st-actions{position:absolute;left:0;right:0;z-index:4;
  bottom:calc(20px + env(safe-area-inset-bottom));
  display:flex;flex-direction:column;align-items:center;gap:10px;padding:0 16px}
.st-actions .dw-btn{width:100%;max-width:280px}
.st-actions .dw-btn.ghost{background:rgba(255,255,255,.86)}

/* ══════════════════════════════════════════════════════════
   V5 · 颜色与触感闭环（覆盖层）
   token 终版 + 对比度扫尾 + 按压统一 + 兼容兜底
   ══════════════════════════════════════════════════════════ */
page{
  /* 对比度 token */
  --ink-3:#77777D;
  --orange-700:#CC4A24;

  /* 暖灰替换冷灰 */
  --paper-deep:#F3EEE3;
  --surface-muted:var(--paper-deep);
  --surface-elevated:#FBF8F1;
  --hairline:#E7E2D5;
  --border-divider:var(--hairline);
  --border-default:rgba(43,43,51,.06);
  --border-strong:rgba(43,43,51,.10);

  /* 阴影统一暖黑 */
  --shadow-xs:0 1px 3px rgba(43,43,51,.05);
  --shadow-sm:0 1px 4px rgba(43,43,51,.06);
  --shadow-md:0 2px 12px rgba(43,43,51,.07);
  --shadow-lg:0 4px 20px rgba(43,43,51,.09);
  --shadow-xl:0 8px 30px rgba(43,43,51,.11);
  --shadow-modal:0 12px 40px rgba(43,43,51,.16);
  --shadow-card:0 2px 8px rgba(43,43,51,.07);

  /* 别名与数字梯度 */
  --text-md:var(--text-base);
  --num-sm:22px; --num-md:26px; --num-lg:32px; --num-xl:42px;

  /* z 阶梯 */
  --z-sticky:20; --z-status:30; --z-tabbar:50; --z-float:70;
  --z-modal:80; --z-poster:90; --z-dp:100; --z-guide:120;
  --z-comments:130; --z-toast:140;
}

/* 扫尾 B：≤13px 橙字统一加深 */
.set-heat,.weekly-kicker,.cs-badge,.rules-entry-more,.rules-h,.rules-n,.rec-tab.on,
.rec-badge,.dp-next-more,.weekly-cta,.dw-echo-like.on,
.rule-brief-k,.ob-kicker{
  color:var(--orange-700);
}

/* 扫尾 C：金底按钮与哑金文字 */
.dw-btn.gold,.dp-btn.gold{background:linear-gradient(135deg,var(--gold-600),var(--gold-700));color:#FFF8ED}
.cta.solid.gold{background:linear-gradient(135deg,var(--gold-500),var(--gold-700))}
.spv2-chip,.sb-status.gold{color:var(--gold-700)}

/* V5 · 触感统一：下沉 1px + 降透明度 */
.cta,.ghost,.mini-cta,.follow,.dw-btn,.dp-btn,.sb-btn,
.rec-card,.stats-card,.ob-cta,.dw-echo-like,.subhead .back,.close-btn{
  transition:transform .12s var(--ease-out),opacity .12s var(--ease-out);
}.dw-btn-press,.dp-btn-press,.sb-btn-press,.hm-press,
.rec-card-press,.dw-echo-press,.sp-social-press,.ob-cta-press,.stats-card-press,.rules-entry-press,
.rule-brief-press{
  transform:translateY(1px);
  opacity:.86;
}

/* 兼容性兜底 */
@supports not (aspect-ratio:3/4){
  .rc-photo,.pc-photo.has-img,.poster-rec .pc-photo,.bk-postcard .pc-photo{
    aspect-ratio:auto;height:0;padding-top:133.33%;overflow:hidden;}
  .rc-photo .t-img,.pc-photo .t-img{position:absolute;inset:0;height:100%}
}
@supports not (clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)){
  .dk-star{clip-path:none;width:10px;height:10px;border-radius:50%}
}
