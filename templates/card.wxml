<!-- templates/card.wxml · V6 卡面（大卡 / 统计卡） -->
<!-- V6 · 大卡 / 统计卡：白底橙字，替代旧 POST CARD 纸品面 -->
<template name="v6CardWord">
  <text class="v6-card-no">NO. {{c.no}}</text>
  <text class="v6-card-word {{c.kwCls}}">{{c.word}}</text>
  <text class="v6-card-hint">轻触卡片，看看解读</text>
  <text class="v6-card-set">{{c.series}}</text>
  <view class="v6-big-keymark" wx:if="{{c.isKey}}">题眼</view>
</template>

<template name="v6CardExplain">
  <block wx:if="{{c.photoMode}}">
    <view class="v6-big-photo-top">
      <image class="v6-big-photo-img" src="{{c.photo}}" mode="aspectFill"/>
      <view class="v6-big-keymark" wx:if="{{c.isKey}}">题眼</view>
      <view class="v6-big-photo-date" wx:if="{{c.pmkDate}}">{{c.pmkDate}}</view>
    </view>
    <view class="v6-big-photo-body">
      <text class="v6-big-photo-explain">{{c.backText}}</text>
      <text class="v6-big-photo-note" wx:if="{{c.note}}">「{{c.note}}」</text>
      <view class="v6-big-photo-meta">
        <text>@{{c.creator}}</text>
        <text>{{c.title}}</text>
      </view>
    </view>
  </block>
  <block wx:else>
    <text class="v6-card-no">TODAY'S CARD</text>
    <text class="v6-exp-word">{{c.word}}</text>
    <text class="v6-exp-text v6-big-exp-text">{{c.backText}}</text>
    <view class="v6-big-note" wx:if="{{c.stamped}}">
      <image wx:if="{{c.photo}}" class="v6-big-note-img" src="{{c.photo}}" mode="aspectFill"/>
      <view class="v6-big-note-main">
        <text class="v6-big-note-date">{{c.pmkDate}} · 已盖戳</text>
        <text class="v6-big-note-t">{{c.note || '今天盖了一个戳。'}}</text>
      </view>
    </view>
    <text wx:else class="v6-big-note-empty">还没盖戳 · 留一句话给今天</text>
    <text class="v6-exp-source">@{{c.creator}} · {{c.title}}</text>
    <view class="v6-big-keymark" wx:if="{{c.isKey}}">题眼</view>
  </block>
</template>

<template name="v6CardMini">
  <view class="v6-mini {{c.isKey ? 'is-key' : ''}}">
    <text class="v6-mini-no">NO.{{c.no}}</text>
    <text class="v6-mini-word {{c.kwCls}}">{{c.word}}</text>
    <view class="v6-mini-key" wx:if="{{c.isKey}}">题</view>
  </view>
</template>
