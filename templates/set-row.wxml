<!-- templates/set-row.wxml — 卡集行唯一结构；页面只传 item / 少量上下文 -->
<import src="/templates/cover.wxml"/>

<!-- 发现 / 搜索：公开卡集行 -->
<template name="setRowPublic">
  <view class="v6-set-row" bindtap="openSet" data-id="{{item.id}}" data-from="{{from}}" hover-class="hm-press">
    <template is="coverArt" data="{{item: item.cover}}" />
    <view class="v6-set-content">
      <view class="v6-set-top">
        <text class="v6-set-cat">{{item.catName}}</text>
        <text class="v6-set-price">{{item.priceText}}</text>
      </view>
      <text class="v6-set-title">{{item.title}}</text>
      <text class="v6-set-sub">{{item.subText}}</text>
      <text class="v6-set-meta">{{item.metaText}}</text>
    </view>
  </view>
</template>

<!-- 订阅页：今日 / 等回信 / 已集齐 -->
<template name="setRowCards">
  <view class="v6-set-row" hover-class="hm-press"
        data-sid="{{item.id}}" data-tap="{{item.tap}}" data-idx="{{item.idx}}" data-from="cards"
        bindtap="tapSubsRow">
    <template wx:if="{{item.cover}}" is="coverArt" data="{{item: item.cover}}" />
    <view class="v6-set-content">
      <view class="v6-set-top">
        <text class="v6-set-cat">{{item.catName}}</text>
        <text class="v6-lib-prog">{{item.prog}}</text>
      </view>
      <text class="v6-set-title">{{item.title}}</text>
      <view class="v6-lib-status {{item.statusCls}}">
        <view class="v6-lib-dot"></view>
        <text>{{item.status}}</text>
      </view>
      <text class="v6-lib-meta">{{item.metaText}}</text>
    </view>
  </view>
</template>

<!-- 创作中心：已上架 / 审核中 / 草稿 -->
<template name="setRowCraft">
  <view class="v6-set-row" hover-class="hm-press"
        bindtap="craftRowTap" data-kind="{{kind}}" data-id="{{item.id}}">
    <template is="coverArt" data="{{item: item.cover}}" />
    <view class="v6-set-content">
      <view class="v6-set-top">
        <text class="v6-set-cat">{{item.badgeText}}</text>
        <text class="v6-set-price">{{groupName}}</text>
      </view>
      <text class="v6-set-title">{{item.title}}</text>
      <text class="v6-set-sub">{{item.meta}}</text>
    </view>
  </view>
</template>

<!-- 作者主页：作品行 -->
<template name="setRowAuthor">
  <view class="v6-set-row" bindtap="openSet" data-id="{{item.id}}" data-from="author" hover-class="hm-press">
    <template is="coverArt" data="{{item: item.cover}}" />
    <view class="v6-set-content">
      <view class="v6-set-top">
        <text class="v6-set-cat">{{item.meta1}}</text>
        <text class="v6-set-price">{{item.meta2}}</text>
      </view>
      <text class="v6-set-title">{{item.title}}</text>
    </view>
  </view>
</template>
