  "description": "今日做点小事 · 微信小程序（前端 + mock 契约测试）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tools/test/*.test.js",
    "test:static": "node --test tools/test/static.test.js",
