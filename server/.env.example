# 复制为 shared/.env 后填写；该文件含密钥，绝不提交仓库。
APP_ENV=test
HOST=127.0.0.1
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

# MySQL（本机）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rt_test
DB_PASSWORD=CHANGE_ME
DB_NAME=randomtouch_test
DB_POOL=10

# Redis（本机；测试环境用 db 1 + 前缀隔离）
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=1
REDIS_PREFIX=rt:test:

# 登录态
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE=30d

# 微信小程序（AppSecret 只放这里）
WX_APPID=wx9ad4f56f0b9d1dbc
WX_SECRET=CHANGE_ME

# 腾讯云 COS
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_BUCKET=randomtouch-test-1250000000
COS_REGION=ap-shanghai
# 图片对外访问前缀（COS 默认域名或自定义 CDN 域名，需加入 downloadFile 合法域名）
# 仅用于把历史 public URL 解析回对象 key；客户端不再直读。
# COS 桶必须为私有（private），读取一律走签名 URL。
COS_PUBLIC_BASE=https://randomtouch-test-1250000000.cos.ap-shanghai.myqcloud.com
# 对象 key 前缀（测试环境 test，生产可用 prod）
COS_PREFIX=test
# 签名 URL 有效期（秒）；默认 24 小时。建议桶私有，客户端只读签名 URL。
COS_URL_EXPIRE=86400

# 内容安全：mock = 测试环境直接放行；real = 调微信 msgSecCheck / mediaCheckAsync
SEC_MODE=mock

# 提现门槛（元）
WITHDRAW_THRESHOLD=100
