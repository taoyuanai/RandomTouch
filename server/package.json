{
  "name": "randomtouch-server",
  "private": true,
  "version": "1.0.0",
  "description": "今日做点小事 · 自建后端 API（Node + MySQL + Redis + COS）",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:schema": "node scripts/run-schema.js",
    "db:seed": "node db/seed.js",
    "smoke": "node scripts/smoke.js",
