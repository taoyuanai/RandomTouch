/* ══════════════════════════════════════════════════════════
   微信小程序适配层
   - 页面自身滚动（不使用 .phone 固定高度）
   - 自定义导航安全区 / 底部 tabbar / 弹层 / 安全区
   - 原生 button 重置
   - WXML 标签映射（.t-*）与图标/印戳适配
   ══════════════════════════════════════════════════════════ */
page{
  background: var(--surface-page);
  font-family: var(--font-sans);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
view, text, button, input, textarea, image{
  box-sizing: border-box;
}
button{
  width: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: inherit;
  overflow: visible;
}
button::after{ border: none; }
/* 微信原生 button 默认宽度为 184px，需按用途覆写 */
page button{ width: auto; }
page .cta,
page .ghost,
page .newcraft-btn,
page .ed-add{ width: 100%; }
page .close-btn{ width: 32px; }
input, textarea{
  font-family: inherit;
  color: inherit;
  background: transparent;
  border: none;
  outline: none;
}
input::placeholder, textarea::placeholder{ color: var(--text-tertiary); }

.phone{
  width: 100%;
  height: auto;
  min-height: 100vh;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
  display: block;
  position: relative;
  background: var(--surface-page);
}
.screen{
  overflow: visible;
  position: static;
  flex: none;
}
.page{
  display: block;
  min-height: 100vh;
  padding-top: var(--navtop, var(--statusbar, 0px));
  padding-bottom: 110px;
}
.page-head{
  top: var(--navtop, var(--statusbar, 0px));
}
.status-spacer{
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navtop, var(--statusbar, 0px));
  background: var(--surface-page);
  z-index: 30;
  pointer-events: none;
}

/* 底部导航：固定在视口底部 */
.tabbar{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar .t-svg{
  display: block;
  width: 22px;
  height: 22px;
  margin: 0 auto 3px;
}

/* 吸底按钮 / 弹层 / Toast */

#page-set{ padding-bottom: 160px; }
.modal{
  position: fixed;
  z-index: 80;
}
.sheet{
  padding-bottom: calc(var(--space-5) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
}
.modal.centered{
  padding-top: calc(var(--navtop, 0px) + var(--space-3));
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  align-items: center;
}
.modal.centered .sheet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}
.toast{
  bottom: calc(100px + constant(safe-area-inset-bottom));
  bottom: calc(100px + env(safe-area-inset-bottom));
  z-index: 140;
}
.poster-sheet.booklet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}


.bottom-sheet{
  max-height: calc(100vh - 40px);
  overflow-y: auto;
}
.toast{
  white-space: normal;
  line-height: 1.5;
}
#posterModal .poster-card{
  padding-top: calc(var(--space-5) + 26px);
}
#posterModal .poster-actions{
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
}

/* 卡背容器 */


/* 解签内容：在空白区域垂直居中 */



/* 印戳：用真实文本替代 CSS attr()，避免小程序不支持 */
.stamp::before,
.stamp::after,
.bk-stamp::before,
.bk-stamp::after{
  content: none !important;
  display: none !important;
}
.stamp-text{
  position: relative;
  z-index: 1;
  font: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  color: inherit;
}

/* 图标（PNG）保持与原型 SVG 相同尺寸/占位 */
image.t-svg{ display: inline-block; vertical-align: middle; }
.tabbar button image.t-svg{ display: block; }
.search-bar image.t-svg{ width: 18px; height: 18px; flex: none; }

.set-heat image.t-svg{ width: 14px; height: 14px; }

.rec-slot.empty image.t-svg{ width: 18px; height: 18px; flex: none; }
.rc-photo-empty image.t-svg{ width: 26px; height: 26px; }


/* 图片组件默认宽高重置 */
image.t-img{
  width: 100%;
  height: 100%;
  display: block;
}

/* 长文本换行 */
.draw-tail{ white-space: pre-line; }

/* 输入控件（原生 input/textarea） */
.fi{
  width: 100%;
  font-size: var(--text-lg);
  line-height: 1.5;
  letter-spacing: 0.5px;
  padding: var(--space-3);
  background: var(--surface-muted);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  text-align: left;
}
.fi:focus{ border-color: var(--border-focus); background: var(--surface-card); }
input.fi{ height: 44px; padding: 0 var(--space-3); }
textarea.fi{ height: 84px; min-height: 84px; }

/* 页面切换动画 */
.page{ animation: fadein var(--duration-normal) var(--ease-default); }

/* 禁止长按选中 */
.page, .tabbar, .modal{ -webkit-user-select: none; user-select: none; }
input, textarea, .stamp, .stamp-text, .bk-stamp{ -webkit-user-select: auto; user-select: auto; }


/* ── 原生 button / 导航安全区补充 ── */
#page-create{ padding-top: calc(var(--navtop, var(--statusbar, 0px)) + var(--space-1)); }
#page-me{ padding-top: var(--navtop, var(--statusbar, 0px)); }

.cta,
.ghost,
.mini-cta,
.follow,
.ed-add,
.ed-del,
.seg button,
.subhead .back{
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar button{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 输入框在小程序原生组件下的保底样式 */


/* ══════ V2.5 · 抽卡页动作区：主次分层 ══════ */







/* ══════ V2.6 · 大卡操作行 + 海报层级 ══════ */
.bigcard-actions{display:flex;justify-content:center;margin-top:var(--space-3)}
.bigcard-actions .cta{min-width:220px;height:44px}
/* 海报会从大卡弹层内部打开，必须压在大卡之上 */
#posterModal{z-index:90}

/* ══════ V2.6 · 周记 / 朋友圈 9:16 海报 ══════ */

/* 9:16 海报较高，弹层允许内部滚动 */
.poster-sheet.scroll{overflow-y:auto !important}
.poster-sheet.scroll .poster-actions{
  position:sticky;bottom:0;z-index:2;
  padding:var(--space-2) var(--space-3) var(--space-3);gap:6px;
}
.poster-sheet.scroll .poster-actions .cta{height:42px}
.poster-sheet.scroll .poster-actions .ghost{height:34px}
.poster-sheet.scroll .poster-ratio button{height:26px}

/* 海报比例切换 */
.poster-ratio{
  display:flex;gap:6px;justify-content:center;
  background:var(--surface-muted);border-radius:var(--radius-full);padding:3px;
}
.poster-ratio button{
  flex:1;height:30px;border:none;border-radius:var(--radius-full);
  background:transparent;color:var(--text-tertiary);
  font-size:var(--text-xs);font-weight:var(--weight-medium);letter-spacing:1px;
  font-family:inherit;cursor:pointer;
  transition:all var(--duration-fast) var(--ease-default);
}
.poster-ratio button.on{background:var(--surface-card);color:var(--text-primary);box-shadow:var(--shadow-xs)}

/* 朋友圈大 QR */
.poster-qr.big{
  width:60px;height:60px;border-radius:8px;border:8px solid #FFF;
  box-shadow:0 0 0 1px var(--border-default);font-size:var(--text-sm);
}

/* ── 周记 3:4 ── */
.poster-weekly{padding:var(--space-5)}
.weekly-head{margin-bottom:8px;padding-bottom:8px}
.weekly-kicker{font-size:12px;color:var(--orange-500);letter-spacing:2px;margin-top:8px}
.weekly-title{
  font-family:var(--font-heritage);font-size:24px;line-height:1.4;
  font-weight:var(--weight-semibold);color:var(--gray-800);
  margin:6px 0 12px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.weekly-wall{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin:0 0 12px}
.weekly-card{
  position:relative;width:calc((100% - 27px)/4);aspect-ratio:3/4;
  background:#FFF;border:1px solid var(--orange-100);border-radius:7px;
  box-shadow:var(--shadow-xs);
  display:flex;align-items:center;justify-content:center;
  padding:8px 5px;overflow:hidden;
}
.weekly-card .wc-bar{position:absolute;top:0;left:0;right:0;height:4px;background:var(--mint-400)}
.weekly-card.N .wc-bar{background:var(--mint-400)}
.weekly-card.R .wc-bar{background:var(--sky-400)}
.weekly-card.SR .wc-bar{background:var(--honey-400)}
.weekly-card.SSR .wc-bar{background:var(--gradient-ssr)}
.weekly-card .wc-word{
  font-family:var(--font-heritage);font-size:15px;line-height:1.25;
  letter-spacing:0.5px;text-align:center;color:var(--text-primary);word-break:break-word;
}
.weekly-card .wc-word.bw-6{font-size:13px}
.weekly-card .wc-word.bw-7{font-size:12px}
.weekly-card.blank{
  border-style:dashed;border-color:var(--gray-200);
  background:transparent;box-shadow:none;color:var(--gray-300);
}
.weekly-card.blank text{font-size:11px;letter-spacing:2px}

/* 照片版：拍立得拼贴 */
.weekly-collage{position:relative;height:190px;margin:4px 0 8px}
.weekly-polaroid{
  position:absolute;background:#FFF;padding:7px 7px 20px;
  border:1px solid var(--border-default);box-shadow:0 6px 16px rgba(0,0,0,0.08);
}
.weekly-polaroid image{width:100%;height:100%;display:block;object-fit:cover}
.weekly-polaroid.main{width:64%;height:150px;left:10%;top:0;transform:rotate(-2deg);z-index:2}
.weekly-polaroid.sub{width:42%;height:112px;right:5%;top:52px;transform:rotate(2.5deg);z-index:1;padding-bottom:7px}
.polaroid-date{
  position:absolute;left:0;right:0;bottom:3px;text-align:center;
  font-family:var(--font-heritage);font-size:11px;color:var(--gray-500);letter-spacing:0.5px;
}
.weekly-words{
  font-size:12px;color:var(--gray-500);letter-spacing:0.5px;margin:0 0 10px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* 邮戳带：一周七格 */
.weekly-stamps{display:flex;gap:7px;justify-content:center;margin:6px 0 10px}
.weekly-stamp{
  flex:1;max-width:44px;height:16px;border:1px dashed var(--gray-300);border-radius:2px;
  display:flex;align-items:center;justify-content:center;
  font-family:'Courier New',Courier,monospace;font-size:8px;letter-spacing:0;
  color:var(--gray-300);opacity:0.55;line-height:1;
}
.weekly-stamp.on{border:1.5px solid rgba(30,30,30,0.9);color:rgba(30,30,30,0.9);opacity:1}

/* 数据行 */
.weekly-data{
  display:flex;justify-content:center;gap:10px;flex-wrap:wrap;
  font-size:12px;color:var(--gray-600);letter-spacing:0.3px;margin-bottom:8px;
}
.weekly-data .b{
  font-size:14px;font-weight:var(--weight-bold);color:var(--gray-800);
  font-variant-numeric:tabular-nums;
}
.weekly-quote{
  font-family:var(--font-heritage);font-size:13px;line-height:20px;color:var(--gray-700);
  letter-spacing:0.5px;margin-bottom:6px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.weekly-footer{margin-top:6px;padding-top:8px;border-top:1px dashed var(--border-divider);align-items:flex-end}
.weekly-foot-right{display:flex;align-items:center;gap:8px}
.weekly-cta{font-size:12px;font-weight:var(--weight-semibold);color:var(--orange-600);letter-spacing:0.5px}

/* ── 周记 9:16（4 列双行卡墙，第 8 槽虚线「明天」） ── */
.weekly-916{padding:var(--space-5)}
.weekly-916 .weekly-head{margin-bottom:6px;padding-bottom:8px}
.weekly-916 .weekly-kicker{margin-top:4px;font-size:12px;letter-spacing:2px}
.weekly-916 .weekly-title{font-size:30px;line-height:1.33;margin:6px 0 10px}
.weekly-916 .weekly-wall{gap:8px;margin-bottom:10px}
.weekly-916 .weekly-wall .weekly-card{width:calc((100% - 24px)/4);padding:7px 3px}
.weekly-916 .weekly-card .wc-word{font-size:12px}
.weekly-916 .weekly-card .wc-word.bw-6{font-size:10.5px}
.weekly-916 .weekly-card .wc-word.bw-7{font-size:9.5px}
.weekly-916 .weekly-stamps{gap:5px;margin:6px 0 8px}
.weekly-916 .weekly-stamp{max-width:38px;height:14px;font-size:7.5px}
.weekly-916 .weekly-quote{font-size:14px;line-height:22px;-webkit-line-clamp:2;margin-bottom:6px}
.weekly-916 .weekly-cta{font-size:14px;font-weight:var(--weight-bold)}
.weekly-916 .weekly-collage{height:230px}
.weekly-916 .weekly-footer{margin-top:auto;padding-top:10px}

/* ── 抽卡明信片 9:16 ── */
.poster-h916{
  position:relative;padding:var(--space-5);aspect-ratio:9/16;
  display:flex;flex-direction:column;overflow:hidden;
  background:linear-gradient(160deg,var(--orange-50),#FFF 55%);
}
.poster-h916 .h916-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.poster-h916 .h916-veil{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(255,255,255,0.10) 0%,rgba(255,255,255,0.78) 42%,#FFF 85%);
}
.h916-inner{position:relative;z-index:2;display:flex;flex-direction:column;height:100%}
.h916-head{margin-bottom:6px}
.h916-body{position:relative;flex:1;display:flex;align-items:center;justify-content:center;padding:6px 0 0}
.h916-card{
  position:relative;width:66%;aspect-ratio:2/3;background:#FFF;
  border-radius:14px;border:1px solid var(--border-default);
  box-shadow:0 12px 30px rgba(0,0,0,0.10);
  transform:rotate(-1.5deg);padding:14px;display:flex;flex-direction:column;
}
.h916-bar{position:absolute;top:0;left:0;right:0;height:6px;border-radius:14px 14px 0 0}
.h916-bar.N{background:linear-gradient(90deg,var(--mint-300),var(--mint-500))}
.h916-bar.R{background:linear-gradient(90deg,var(--sky-300),var(--sky-500))}
.h916-bar.SR{background:linear-gradient(90deg,var(--honey-300),var(--honey-500))}
.h916-bar.SSR{background:var(--gradient-ssr)}
.h916-cardtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.h916-no{font-size:11px;color:var(--text-tertiary);letter-spacing:0.5px}
.h916-word{
  flex:1;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-heritage);font-size:40px;font-weight:var(--weight-semibold);
  letter-spacing:2px;color:var(--gray-900);text-align:center;line-height:1.2;padding:8px 0;
}
.h916-word.bw-6{font-size:34px}
.h916-word.bw-7{font-size:30px}
.h916-explain{
  font-family:var(--font-heritage);font-size:12px;line-height:17px;color:var(--text-secondary);
  text-align:center;padding:0 6px 6px;letter-spacing:0.5px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.h916-set{text-align:center;font-size:11px;color:var(--text-tertiary);letter-spacing:0.5px}
.h916-stamp{
  position:absolute;right:2%;top:6%;width:52px;height:20px;
  border:1.5px solid #1E1E1E;border-radius:2px;transform:rotate(-4deg);opacity:0.9;
  display:flex;align-items:center;justify-content:center;gap:3px;
  background:rgba(255,255,255,0.72);
}

.h916-stamp-date{font-family:'Courier New',Courier,monospace;font-size:8px;color:#1E1E1E;letter-spacing:0}
.h916-quote{
  font-family:var(--font-heritage);font-size:15px;line-height:24px;color:var(--gray-800);
  text-align:center;margin:10px 2px 4px;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}
.h916-src{text-align:center;font-size:12px;color:var(--gray-500);letter-spacing:0.5px;margin-bottom:8px}
.h916-foot{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  border-top:1px dashed var(--border-divider);padding-top:10px;
}
.h916-cta{font-size:13px;font-weight:var(--weight-semibold);color:var(--orange-600);letter-spacing:0.5px}

/* ── 集齐纪念 9:16 ── */
.poster-m916{aspect-ratio:9/16;display:flex;flex-direction:column;padding:var(--space-5)}
.m916-title{
  font-family:var(--font-heritage);font-size:34px;font-weight:var(--weight-bold);
  letter-spacing:3px;text-align:center;color:var(--text-primary);margin:10px 0 4px;
}
.m916-sub{text-align:center;font-size:var(--text-md);letter-spacing:1px;color:var(--text-secondary);margin-bottom:18px}
.m916-stats{display:flex;justify-content:space-around;margin-bottom:20px}
.m916-stat{text-align:center}
.m916-stat .t-b{
  display:block;font-size:32px;font-weight:var(--weight-bold);color:var(--text-primary);
  line-height:1.1;font-variant-numeric:tabular-nums;
}
.m916-stat .t-b.gold-num{
  background:linear-gradient(135deg,var(--gold-300),var(--gold-600));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.m916-stat .t-span{font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:1px}
.m916-timeline{position:relative;padding-left:20px;margin:0 6px 16px}
.m916-timeline::before{
  content:"";position:absolute;left:5px;top:6px;bottom:6px;width:3px;
  border-radius:99px;background:linear-gradient(180deg,var(--gold-200),var(--gold-400));
}
.m916-node{position:relative;margin-bottom:14px}
.m916-node::before{
  content:"";position:absolute;left:-20px;top:3px;width:10px;height:10px;
  border-radius:50%;background:#FFF;border:3px solid var(--gold-500);
  box-shadow:0 1px 3px rgba(217,162,39,0.25);
}
.m916-node-date{display:block;margin-bottom:2px}
.m916-node .t-b{font-size:var(--text-md);color:var(--text-primary);margin-bottom:2px}
.m916-node .t-span{font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:0.5px}
.m916-quote{
  font-family:var(--font-heritage);font-size:var(--text-md);line-height:1.9;
  color:var(--text-secondary);text-align:center;
  background:rgba(255,255,255,0.6);border-radius:var(--radius-lg);
  padding:12px 14px;margin-bottom:6px;
}
.m916-foot{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  border-top:1px dashed var(--border-divider);padding-top:10px;
}
/* m916 新数据：末节点金色、SSR 引言 / 无 SSR 钢戳说明 */
.m916-node.last::before{
  background:var(--gold-500);border-color:var(--gold-700);
  box-shadow:0 1px 3px rgba(217,162,39,0.3);
}
.m916-node.last .t-b{color:var(--gold-700);font-weight:var(--weight-bold)}
.m916-quote-word{
  font-family:var(--font-heritage);font-size:24px;font-weight:var(--weight-bold);
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.m916-quote-text{
  font-family:var(--font-heritage);font-size:13px;color:var(--text-secondary);
  margin-top:6px;line-height:1.7;
}
.m916-stampnote{
  text-align:center;font-size:12px;color:var(--text-tertiary);
  line-height:1.7;margin:10px 6px;
}

/* ── 集齐纪念 3:4 预览（pm，与 Canvas 字段同源） ── */
.pm{margin-top:4px}
.pm-eyebrow{font-size:11px;color:var(--text-brand);letter-spacing:2px;text-align:center}
.pm-title{
  font-family:var(--font-heritage);font-weight:var(--weight-bold);
  font-size:24px;text-align:center;margin-top:4px;color:var(--text-primary);
}
.pm-settitle{
  font-family:var(--font-heritage);font-size:13px;color:var(--text-secondary);
  text-align:center;margin-top:2px;
}
.pm-stats{display:flex;margin-top:14px}
.pm-stat{flex:1;text-align:center;position:relative}
.pm-stat + .pm-stat::before{
  content:'';position:absolute;left:0;top:4px;bottom:4px;width:1px;background:var(--border-divider);
}
.pm-n{display:block;font-size:22px;font-weight:var(--weight-bold);color:var(--text-primary)}
.pm-n-gold{
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.pm-l{display:block;font-size:11px;color:var(--text-tertiary);letter-spacing:2px;margin-top:2px}
.pm-timeline{display:flex;justify-content:space-between;margin-top:16px;padding:0 8px;position:relative}
.pm-timeline::before{
  content:'';position:absolute;left:14px;right:14px;top:26px;height:1.5px;background:var(--gold-300);
}
.pm-node{display:flex;flex-direction:column;align-items:center;width:33%}
.pm-node-date{font-size:11px;color:var(--text-tertiary)}
.pm-node-dot{
  width:8px;height:8px;border-radius:50%;background:#FFF;
  border:2px solid var(--gold-500);margin:3px 0;
}
.pm-node.last .pm-node-dot{background:var(--gold-500);border-color:var(--gold-700)}
.pm-node-cap{font-size:11px;color:var(--text-secondary)}
.pm-node.last .pm-node-cap{color:var(--gold-700);font-weight:var(--weight-bold)}
.pm-quote{margin-top:16px;text-align:center}
.pm-quote-word{
  font-family:var(--font-heritage);font-size:17px;font-weight:var(--weight-bold);
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.pm-quote-text{
  font-family:var(--font-heritage);font-size:12px;color:var(--text-secondary);
  margin-top:6px;line-height:1.6;
}
.pm-stampnote{margin-top:18px;text-align:center;font-size:11px;color:var(--text-tertiary)}

/* ── 周记入口 ── */






.weekly-banner .wb-text .t-b{
  font-size:var(--text-md);color:var(--text-primary);font-weight:var(--weight-medium);
  letter-spacing:0.5px;margin-bottom:2px;
}
.weekly-banner .wb-text .t-span{font-size:var(--text-sm);color:var(--text-tertiary);letter-spacing:0.5px}

/* ══════════════════════════════════════════════════════════
   V2.7 · 暖纸系统（设计 token 覆盖）
   纸层 / 暖灰墨层 / 珊瑚层 / 校准彩墨层 / 集齐金
   ══════════════════════════════════════════════════════════ */
page{
  --paper:#FFFFFF;
  --paper-page:var(--paper);  --paper-card:#FFFFFF;  --paper-deep:#F7F7F8;
  /* ═══ V1 · 纸品印刷系统 ═══ */
  --paper-face:#FFFFFF;
  --paper-env:#FFFFFF;
  --paper-env-deep:#FFFFFF;
  --gold:#D9A227;
  --gold-soft:rgba(217,162,39,.44);
  --wax:#F2600F;
  --weave:none;
  --ink-1:#1D1D1F;  --ink-2:#6E6E73;  --ink-3:#8E8E93;  --ink-4:#C7C7CC;
  --ink-soft:var(--ink-3);  --ink-faint:var(--ink-4);
  --hairline:#F0F0F2;

  --brand:#FF6B35;  --brand-deep:#E8541F;  --brand-text:#FF6B35;  --brand-tint:#FFF4ED;
  --rar-N:#10B981;  --rar-R:#0EA5E9;  --rar-SR:#F59E0B;  --rar-SSR:#D9A227;
  --gold-deep:#7A5410;  --gold-mid:#D9A227;  --gold-light:#F0CF7E;

  --shadow-card:0 2px 8px rgba(0,0,0,0.06);
  --shadow-cta:0 2px 8px rgba(255,107,53,0.25);
  --r-card:10px;  --r-pill:999px;

  --font-mono:var(--font-sans);
  --font-serif:var(--font-sans);
  --font-heritage:"PosterSerif","Songti SC","Noto Serif SC","STSong",serif;
  --font-stamp:"Courier New",Courier,monospace;

  /* 映射现有 token，全局一次换底 */
  --surface-page:var(--paper-page);
  --surface-card:var(--paper-card);
  --surface-elevated:#FAFAFA;
  --surface-muted:var(--paper-deep);
  --surface-hover:#F5F5F7;
  --surface-pressed:#E5E5EA;

  --text-primary:var(--ink-1);
  --text-secondary:var(--ink-2);
  --text-tertiary:var(--ink-3);
  --text-disabled:var(--ink-4);
  --text-brand:var(--brand);
  --text-link:var(--rar-R);

  --border-default:rgba(0,0,0,0.06);
  --border-strong:rgba(0,0,0,0.10);
  --border-divider:var(--hairline);
  --border-focus:var(--brand);

  --orange-50:var(--brand-tint);
  --orange-100:#FFE8D8;
  --orange-200:#FFD0B0;
  --orange-300:#FFB088;
  --orange-400:#FF8A5C;
  --orange-500:var(--brand);
  --orange-600:var(--brand-deep);
  --orange-700:var(--brand-text);
  --orange-800:#9E3710;

  --mint-50:#F0FDF7;  --mint-100:#D1FAE5;  --mint-200:#A7F3D0;
  --mint-300:#6EE7B7; --mint-400:#34D399;  --mint-500:var(--rar-N); --mint-600:#059669;
  --sky-50:#F0F9FF;   --sky-100:#E0F2FE;   --sky-200:#BAE6FD;
  --sky-300:#7DD3FC;  --sky-400:#38BDF8;   --sky-500:var(--rar-R); --sky-600:#0284C7;
  --honey-50:#FFFBEB; --honey-100:#FEF3C7; --honey-200:#FDE68A;
  --honey-300:#FCD34D;--honey-400:#FBBF24; --honey-500:var(--rar-SR); --honey-600:#D97706;
  --gold-300:var(--gold-light); --gold-400:#E8B84F;
  --gold-500:var(--gold-mid);   --gold-600:#B78413; --gold-700:var(--gold-deep);

  --gradient-brand:linear-gradient(135deg,#FF8A5C,#FF6B35);
  --gradient-brand-soft:linear-gradient(135deg,#FFB088,#FF8A5C);
  --gradient-surface:linear-gradient(180deg,#FFFFFF,#FAFAFA);

  --shadow-xs:0 1px 3px rgba(0,0,0,0.04);
  --shadow-sm:0 1px 4px rgba(0,0,0,0.05);
  --shadow-md:0 2px 12px rgba(0,0,0,0.06);
  --shadow-lg:0 4px 20px rgba(0,0,0,0.08);
  --shadow-xl:0 8px 30px rgba(0,0,0,0.10);
  --shadow-modal:0 12px 40px rgba(0,0,0,0.15);
}

/* P0 · CTA / 火漆 / 日期：纯珊瑚 + 暖阴影 */
.cta.solid{background:var(--gradient-brand);box-shadow:var(--shadow-cta);border:none}
.cta.solid:active{background:var(--orange-600);transform:scale(0.985);box-shadow:0 1px 4px rgba(255,107,53,0.20)}
.cta-fixed-wrap .cta{box-shadow:var(--shadow-cta)}

.today{font-family:var(--font-mono);letter-spacing:.5px}
/* 情绪的声音：卡词 / 解签统一宋体 */


/* 彩墨只做小面积语言：地图点位用校准稀有度色 */
.rdot.N{background:var(--rar-N);border-color:var(--rar-N)}
.rdot.R{background:var(--rar-R);border-color:var(--rar-R)}
.rdot.SR{background:var(--rar-SR);border-color:var(--rar-SR)}
.rdot.SSR{background:var(--rar-SSR);border-color:var(--rar-SSR)}

/* 集名 / 书脊：情绪的声音 */



/* 数字 / 计数：邮戳的声音 */
.stat .t-b,.count,.progress-hero .ph-right,.txn .td,.txn .ta{font-family:var(--font-mono)}

/* 物理按压：沉下去 1px，而不是发光 */

.cta:active,.ghost:active,.mini-cta:active,.follow:active,.chip:active{
  transform:translateY(1px);
}

/* 阅读页去盒子化：订阅 / 全图（发现列表恢复浮起方框卡） */





#page-cards .stats{
  background:transparent;gap:0;border-top:1px solid var(--hairline);
  border-bottom:1px solid var(--hairline);padding:12px 0;margin-bottom:24px;
}
#page-cards .stat{
  background:transparent;border:none;box-shadow:none;border-radius:0;
  position:relative;padding:8px 6px;
}
#page-cards .stat + .stat::before{
  content:'';position:absolute;left:0;top:10px;bottom:10px;
  width:1px;background:var(--hairline);
}







#page-map .panel{background:transparent;border:none;box-shadow:none;padding:0}
#page-map .panel:hover{box-shadow:none}
#page-map .panel-head .t-b{font-family:var(--font-serif);font-size:20px;font-weight:600}





/* ══════ V2.8 · 详情页：纸面直排 ══════ */


#sp-intro-end{height:1px}
































.sp-rule{width:40px;height:1px;background:var(--hairline);margin:44px auto 0}
.sp-picks{margin-top:28px;padding:0 4px}
.sp-pick + .sp-pick{margin-top:30px}
.sp-pick-head{display:flex;align-items:center}
.sp-pick-stamp{
  transform:rotate(-3deg);
  border:1.5px solid var(--ink-1);border-radius:3px;
  padding:3px 7px;opacity:.85;
  font-family:var(--font-mono);font-size:10px;font-weight:700;
  color:var(--ink-1);letter-spacing:.5px;
}
.sp-pick-meta{
  margin-left:12px;
  font-family:var(--font-mono);font-size:11px;
  color:var(--ink-3);letter-spacing:.5px;
}
.sp-pick-note{
  margin-top:10px;
  font-family:var(--font-serif);font-size:15px;
  line-height:1.7;color:var(--ink-1);
  display:-webkit-box;-webkit-box-orient:vertical;
  -webkit-line-clamp:3;overflow:hidden;
}
.sp-tail{margin:18px 0 24px;display:flex;flex-direction:column;align-items:center}
.sp-cta{
  min-width:236px;height:52px;padding:0 34px;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.sp-cta::after{border:none}
