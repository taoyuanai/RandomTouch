/* D7 · 信封动画 fast 档（400ms 节奏） */



/* D8 · 首抽引导屏 */
.ob-mask{position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center;
background:rgba(28,25,23,.45)}
.ob-card{width:78%;max-width:320px;background:var(--paper-card);border-radius:20px;
padding:26px 22px 20px;box-shadow:0 18px 50px rgba(28,25,23,.28);
display:flex;flex-direction:column;align-items:center;
animation:obIn .32s cubic-bezier(.2,.9,.3,1.2)}
@keyframes obIn{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:none}}
.ob-kicker{font-family:var(--font-mono);font-size:11px;letter-spacing:2px;color:var(--orange-600)}
.ob-title{font-size:20px;font-weight:700;color:var(--ink-1);margin:8px 0 4px;letter-spacing:1px}
.ob-steps{width:100%;margin-top:14px}
