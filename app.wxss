/* V2 · 保留组合数字规则（移除旧 map-cell） */
.count,.today,.cf-top .no,.card-row .s{font-variant-numeric:tabular-nums}

/* ═══ V3 · 卡背双态（信纸 / 照片）═══ */
.cw{position:relative;width:var(--cw,240px);height:var(--ch,340px);border-radius:10px;
background-color:var(--paper-face);background-image:var(--weave);
box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 2px 5px rgba(43,43,51,.08),0 8px 20px rgba(43,43,51,.13);
display:flex;flex-direction:column;box-sizing:border-box;
padding:calc(var(--cw)*.0625) calc(var(--cw)*.075)}
.cw-frame{position:absolute;inset:8px;border:1px solid var(--ink-faint);border-radius:6px;pointer-events:none}
.cw-head{flex:none;display:flex;justify-content:space-between;align-items:baseline}
.cw-series{font-size:calc(var(--cw)*.046);letter-spacing:.1em;color:var(--ink);opacity:.75;
max-width:62%;overflow:hidden;white-space:nowrap}
.cw-tag{font-size:calc(var(--cw)*.0375);letter-spacing:.22em;color:var(--ink);opacity:.45}

.cw-hrule{flex:none;height:1px;background:var(--ink-line);opacity:.5;margin-top:calc(var(--cw)*.025)}
.cw-slotrow{flex:none;display:flex;align-items:center;justify-content:flex-end;
height:calc(var(--cw)*.2167);margin-top:calc(var(--cw)*.0417)}
.cw-slot{width:calc(var(--cw)*.1833);height:100%;border:1px dashed var(--ink-line);border-radius:2px;
display:flex;align-items:center;justify-content:center;transform:rotate(-2deg)}
.cw-slot-t{font-size:calc(var(--cw)*.0375);letter-spacing:.14em;color:var(--ink);opacity:.5}
.cw-in{flex:1;min-height:0;margin-top:calc(var(--cw)*.05);display:flex;align-items:center}
.cw-in-t{font-size:calc(var(--cw)*.054);line-height:1.9;letter-spacing:.02em;color:var(--ink);
opacity:.82;text-align:center;word-break:break-word}
.cw-mid{flex:none;display:flex;align-items:center;gap:calc(var(--cw)*.0333);
margin:calc(var(--cw)*.0417) 0}
.cw-mid-l{flex:1;height:1px;background:var(--ink-line);opacity:.5}
.cw-mid-x{font-size:calc(var(--cw)*.05);line-height:1;color:var(--ink);opacity:.55}
.cw-out{flex:1;position:relative;min-height:0;overflow:hidden;--pitch:calc(var(--cw)*.0833);
background:repeating-linear-gradient(180deg,transparent 0,transparent calc(var(--pitch) - 1px),
var(--ink-faint) calc(var(--pitch) - 1px),var(--ink-faint) var(--pitch))}
.cw-out-t{position:absolute;left:0;top:0;width:100%;line-height:var(--pitch);
font-size:calc(var(--cw)*.054);color:var(--ink);opacity:.9;word-break:break-all}
.cw-out-ph{position:absolute;left:0;top:0;width:100%;line-height:var(--pitch);
font-size:calc(var(--cw)*.042);letter-spacing:.08em;color:var(--ink);opacity:.3}

.cw-photo{flex:none;position:relative;height:calc(var(--ch)*.52);
margin:calc(var(--cw)*.0375) calc(var(--cw)*-.025) 0;background:#FFF;
padding:calc(var(--cw)*.0208);border-radius:3px;box-shadow:0 2px 6px rgba(43,43,51,.14)}
.cw-photo-img{width:100%;height:100%;display:block;border-radius:2px}
.cw-cap{flex:1;position:relative;min-height:0;overflow:hidden;--pitch:calc(var(--cw)*.0833);
margin-top:calc(var(--cw)*.0417);
background:repeating-linear-gradient(180deg,transparent 0,transparent calc(var(--pitch) - 1px),
var(--ink-faint) calc(var(--pitch) - 1px),var(--ink-faint) var(--pitch))}
.cw-cap-t{position:absolute;left:0;top:0;width:100%;line-height:var(--pitch);
font-size:calc(var(--cw)*.054);color:var(--ink);opacity:.9;word-break:break-all}
.cw-src{flex:none;display:flex;align-items:baseline;gap:calc(var(--cw)*.0167);
margin-top:calc(var(--cw)*.025)}
.cw-src-t{flex:1;min-width:0;font-size:calc(var(--cw)*.046);line-height:1.5;color:var(--ink);
opacity:.55;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cw-src-mark{flex:none;font-size:calc(var(--cw)*.042);letter-spacing:.08em;color:var(--ink);opacity:.45}

.cw-pmk{position:relative;width:calc(var(--cw)*.19);height:calc(var(--cw)*.19);border-radius:50%;
border:1px dashed var(--ink-line);display:flex;flex-direction:column;align-items:center;
justify-content:center;gap:1px;transform:rotate(-8deg);z-index:4}
.cw-pmk::after{content:'';position:absolute;inset:calc(var(--cw)*.0104);
border:1px solid var(--ink-faint);border-radius:50%}
.cw-pmk.on-img{position:absolute;right:calc(var(--cw)*-.0208);bottom:calc(var(--cw)*-.0208);
background:rgba(255,255,255,.92);box-shadow:0 1px 4px rgba(43,43,51,.18)}
.cw-pmk-date{font-size:calc(var(--cw)*.046);font-weight:600;color:var(--ink);
font-variant-numeric:tabular-nums}
.cw-pmk-day{font-size:calc(var(--cw)*.0375);color:var(--ink);opacity:.6;letter-spacing:.1em}
.cw-pmk.pop{animation:pmkPress .55s cubic-bezier(.16,1.1,.3,1)}

/* C1 · 知识类免责 */
.sp-disclaim{margin-top:10px;font-size:11px;color:var(--text-tertiary);
letter-spacing:.02em;text-align:center}

/* 长引文：>10 字改为两行小号印刷 */
.cf-word.w4{gap:calc(var(--cw,240px)*.012)}
.cf-word.w4 .cf-word-row{font-size:calc(var(--cw,240px)*.075);letter-spacing:.03em;line-height:1.55;
color:var(--ink);font-weight:600;text-shadow:0 1px 0 rgba(255,255,255,.8)}

/* ═══ 搜索页 ═══ */
#page-search{padding-top:8px}
.srch-head{display:flex;align-items:center;gap:12px;padding:8px 0 14px;
  background:var(--surface-page);position:sticky;top:0;z-index:20}
.srch-box{flex:1;display:flex;align-items:center;gap:8px;min-width:0;
  height:42px;padding:0 12px;background:var(--surface-card);
  border:1px solid var(--border-default);border-radius:var(--radius-full);
  box-shadow:var(--shadow-xs);transition:all var(--duration-fast) var(--ease-default)}
.srch-box:focus-within{border-color:var(--border-strong);box-shadow:var(--shadow-sm)}
.srch-box .t-svg{width:18px;height:18px;flex:none}
.srch-input{flex:1;min-width:0;height:40px;font-size:15px;color:var(--text-primary);
  background:transparent;letter-spacing:.02em}
.srch-clear{flex:none;width:22px;height:22px;line-height:20px;text-align:center;
  border-radius:50%;background:var(--gray-200);color:var(--text-secondary);
  font-size:16px;font-weight:500}
.srch-clear:active{opacity:.65}
.srch-cancel{flex:none;padding:8px 2px;font-size:14px;color:var(--text-secondary);letter-spacing:.05em}
.srch-body{padding-top:4px}
.srch-hint{font-size:13px;line-height:1.8;color:var(--text-tertiary);letter-spacing:.03em}
.srch-sug-title{margin-top:26px;font-size:12px;color:var(--text-tertiary);letter-spacing:.12em}
.srch-sugs{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.srch-sug{padding:7px 15px;border:1px solid var(--border-default);border-radius:var(--radius-full);
  background:var(--surface-card);font-size:13px;color:var(--text-secondary);letter-spacing:.04em}
.srch-sug:active{opacity:.65}
.srch-meta{padding:2px 0 12px;font-size:12px;color:var(--text-tertiary);letter-spacing:.04em}
.srch-nothing{padding:56px 0 24px;text-align:center}
.srch-nothing-t{font-family:var(--font-serif);font-size:17px;color:var(--text-primary);letter-spacing:.04em}
.srch-nothing-s{margin-top:8px;font-size:12px;color:var(--text-tertiary);letter-spacing:.03em}
.srch-nothing-clear{display:inline-block;margin-top:20px;padding:8px 16px;
  border:1px solid var(--border-default);border-radius:var(--radius-full);
  font-size:13px;color:var(--text-secondary)}
.srch-nothing-clear:active{opacity:.65}

/* 故事开头：>18 字，两行更小字号 */
.cf-word.w5{gap:calc(var(--cw,240px)*.012)}
.cf-word.w5 .cf-word-row{font-size:calc(var(--cw,240px)*.0625);letter-spacing:.02em;line-height:1.65;
color:var(--ink);font-weight:600;text-shadow:0 1px 0 rgba(255,255,255,.8)}

/* ═══ 分类索引页（九类 · 2 列）═══ */
#page-categories{padding-top:12px;padding-bottom:100px}
.cat-lead{padding:2px 2px 16px}
.cat-lead-t{font-family:var(--font-serif);font-size:17px;font-weight:600;color:var(--ink-1);letter-spacing:.06em}
.cat-lead-s{margin-top:5px;font-size:11px;color:var(--text-tertiary);letter-spacing:.08em}
.cat-grid{display:flex;flex-wrap:wrap;gap:12px}
.cat-card{width:calc((100% - 12px)/2);min-height:114px;box-sizing:border-box;
  display:flex;align-items:center;gap:10px;padding:12px;
  background:var(--surface-card);border:1px solid var(--border-default);border-radius:14px;
  box-shadow:var(--shadow-xs)}
.cat-press{opacity:.78}
.cat-card.empty{opacity:.62}
.cat-cover{position:relative;width:64px;height:90px;flex:none;border-radius:6px;overflow:hidden;
  background-color:var(--paper-face);background-image:var(--weave);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 2px 5px rgba(43,43,51,.10)}
.cat-cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}
.cat-cover-wash{position:absolute;inset:0;mix-blend-mode:multiply;opacity:.9}
.cat-cover-no{position:absolute;top:6px;left:7px;font-size:7px;letter-spacing:.12em;
  color:var(--ink);opacity:.55;font-variant-numeric:tabular-nums;z-index:2}
.cat-cover-label{position:absolute;left:7px;right:7px;top:24px;padding:5px 3px;
  background:rgba(255,255,255,.94);border:1px solid rgba(43,43,51,.16);border-radius:3px;
  text-align:center;z-index:2}
.cat-cover-label text{display:block;font-size:10px;font-weight:600;letter-spacing:.05em;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cat-cover.is-empty{background:var(--surface-page);border:1px dashed var(--border-strong);
  box-shadow:none;display:flex;align-items:center;justify-content:center}
.cat-empty-t{font-size:9px;letter-spacing:.12em;color:var(--text-tertiary)}
.cat-info{flex:1;min-width:0}
.cat-name{font-size:16px;font-weight:600;color:var(--ink-1);letter-spacing:.06em}
.cat-count{margin-top:6px;font-size:11px;color:var(--text-tertiary);letter-spacing:.04em}

/* 卡集订阅入口 */
.sp-subrow{margin-top:10px;display:flex;justify-content:center}
.sp-sub{height:34px;padding:0 18px;border-radius:999px;border:1px solid var(--border-default);
  background:var(--surface-card);font-size:12px;color:var(--text-secondary);letter-spacing:.05em}
.sp-sub.on{border-color:var(--border-strong);color:var(--text-primary);background:var(--surface-muted)}
.sp-sub-press{opacity:.72}

/* 海报 QR：有真实码显示图片，没有时给搜一搜兜底 */
.poster-qr-img{width:100%;height:100%;display:block;border-radius:3px}
.poster-qr-t{font-size:9px;line-height:1.2;color:var(--text-tertiary);letter-spacing:.04em;text-align:center}

/* 订阅统计：可点击 */
.sb2-stat-press{opacity:.68}
.stats-sheet{width:calc(100vw - 48px);max-height:82vh;overflow:hidden;padding:22px 18px 16px}
.stats-sheet-kicker{font-size:10px;letter-spacing:.2em;color:var(--text-tertiary);text-align:center}
.stats-sheet-title{margin-top:6px;text-align:center;font-size:20px;font-weight:600;color:var(--ink-1);letter-spacing:.04em}
.stats-sheet-sub{margin-top:5px;text-align:center;font-size:11px;color:var(--text-tertiary);letter-spacing:.04em}
.stats-scroll{max-height:58vh;margin-top:16px}
.stats-grid{display:flex;flex-wrap:wrap;gap:16px 12px;padding:2px 0 8px}
.stats-card{width:calc((100% - 24px)/3);display:flex;flex-direction:column;align-items:center;gap:7px}
.stats-card-press{opacity:.72}
.stats-card-face{width:76px;height:108px;flex:none;filter:drop-shadow(0 2px 4px rgba(43,43,51,.08))}
.stats-card-title{width:100%;font-size:10px;color:var(--text-secondary);text-align:center;letter-spacing:.02em;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stats-empty-list{display:flex;flex-direction:column;gap:10px;padding:2px 0 8px}
.stats-empty-row{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border-default);border-radius:12px;background:var(--surface-card)}
.stats-empty-sign{width:38px;height:38px;flex:none;border-radius:9px;background:var(--surface-muted);
  display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:12px;color:var(--ink-2)}
.stats-empty-info{flex:1;min-width:0}
.stats-empty-t{font-size:15px;font-weight:600;color:var(--ink-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stats-empty-s{margin-top:3px;font-size:11px;color:var(--text-tertiary);letter-spacing:.03em}

/* ═══ P2 · 控件 / 线条 / 字体规范（P2-only） ═══ */
page {
  --line: #E5E5EA;
  --border-default: #F0F0F2;
  --border-strong: #E5E5EA;
  --border-divider: #F0F0F2;
  --surface-pressed: #EBEBEE;
  --shadow-xs: 0 1px 2px rgba(0,0,0,.03);
  --shadow-sm: 0 1px 2px rgba(0,0,0,.03), 0 4px 12px rgba(0,0,0,.04);
  --shadow-md: 0 2px 4px rgba(0,0,0,.03), 0 8px 20px rgba(0,0,0,.05);
  --shadow-lg: 0 2px 4px rgba(0,0,0,.03), 0 12px 32px rgba(0,0,0,.08);
  --shadow-xl: 0 4px 8px rgba(0,0,0,.03), 0 16px 40px rgba(0,0,0,.10);
  --shadow-modal: 0 -8px 40px rgba(0,0,0,.14);
  --shadow-card: var(--shadow-sm);
  --shadow-cta: 0 6px 16px rgba(255,107,53,.28);
}

/* 主按钮：48 / 胶囊 / 橙渐变 / 无边框 */
.cta.solid,
.cta.solid.gold {
  height: 48px;
  border: 0;
  border-radius: 999px;
  background: var(--gradient-brand);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .04em;
  box-shadow: var(--shadow-cta);
}
.cta.solid:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(255,107,53,.32); }
.cta.solid:active { transform: scale(.97); box-shadow: 0 2px 8px rgba(255,107,53,.22); }

/* 次按钮：40 / 白底 / 1px 中性描边 */
.cta,
.cta.secondary,
.ghost {
  height: 40px;
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  background: var(--surface-card);
  color: var(--ink-1);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: .02em;
  box-shadow: none;
}
.cta::before { display: none; }
.cta:hover, .cta.secondary:hover, .ghost:hover {
  color: var(--ink-1);
  border-color: #D1D1D6;
  background: var(--surface-hover);
}
.cta:active, .cta.secondary:active, .ghost:active { transform: scale(.97); }
.cta:disabled, .ghost:disabled {
  background: #F5F5F7;
  color: var(--ink-4);
  border-color: transparent;
  box-shadow: none;
}
.cta:disabled:active, .ghost:disabled:active { transform: none; }

/* 轻操作：32 / 品牌淡底 */
.mini-cta,
.follow {
  height: 32px;
  padding: 0 14px;
  border: 0;
  border-radius: 999px;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .02em;
  box-shadow: none;
}
.mini-cta:hover, .follow:hover { background: #FFE9DD; color: var(--brand-deep); }
.mini-cta:active, .follow:active { transform: scale(.97); }
.follow { border: 1px solid var(--border-strong); background: var(--surface-card); color: var(--ink-1); font-weight: 500; }
.follow.on { background: #F5F5F7; color: var(--ink-3); border-color: var(--border-default); }

/* 页面级主 CTA */
.sp-cta, .dw-btn, .dp-btn {
  height: 48px;
  min-width: 200px;
  padding: 0 28px;
  border: 0;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .04em;
  box-shadow: none;
}
.sp-cta.brand, .dw-btn.brand, .dw-btn.gold, .dp-btn.gold {
  background: var(--gradient-brand);
  color: #FFFFFF;
  box-shadow: var(--shadow-cta);
}
.sp-cta.tint { background: var(--brand-tint); color: var(--brand-deep); }
.sp-cta.ink { background: var(--ink-1); color: #FFFFFF; }
.dw-btn.ghost, .dp-btn.ghost {
  height: 40px;
  min-width: 160px;
  padding: 0 22px;
  border: 1px solid var(--border-strong);
  background: var(--surface-card);
  color: var(--ink-1);
  font-size: 14px;
  font-weight: 500;
  box-shadow: none;
}
.sp-float .sp-cta { height: 48px; font-size: 16px; }
.bigcard-actions .cta { height: 40px; min-width: 200px; }

/* 订阅空态 / 其它页面级按钮 */
.sb-btn {
  height: 40px;
  min-width: 160px;
  padding: 0 24px;
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  background: var(--surface-card);
  color: var(--ink-1);
  font-size: 14px;
  font-weight: 500;
  box-shadow: none;
}
.sb-btn.ghost { background: var(--surface-card); color: var(--ink-1); border: 1px solid var(--border-strong); }

/* 首抽引导 / 发送 */
.ob-cta {
  height: 48px;
  border-radius: 999px;
  background: var(--gradient-brand);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .04em;
  box-shadow: var(--shadow-cta);
}
.ob-cta:active { transform: scale(.97); }
.cs-send {
  height: 32px;
  line-height: 32px;
  padding: 0 16px;
  border-radius: 999px;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 12px;
  font-weight: 600;
  box-shadow: none;
}
.cs-send.on { background: var(--brand); color: #FFFFFF; }

/* 装饰静音 */
.panel::before,
#page-cards .stat::before,
#page-create .stat::before,
#page-income .stat::before,
#page-me .stat::before,
.quick-card::before,
.empty::before,
.income-entry::before,
.sb2-remind-deco { content: none !important; display: none !important; }
.sb2-remind { background: var(--brand-tint); }
.sb2-greet { border: 1px solid var(--border-default); }

/* chips / 编辑器分段 */
.chip.on, .chip.on.mint, .chip.on.sky, .chip.on.honey, .chip.on.blossom {
  background: var(--ink-1);
  border-color: var(--ink-1);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: none;
}
.seg button.on {
  border: 1.5px solid var(--brand);
  color: var(--brand-deep);
  background: #FFFFFF;
  font-weight: 600;
  box-shadow: none;
}

/* 线条 / 进度 / 输入 */
.progress, .progress-big, .withdraw-bar, .cm-track { background: #F0F0F2; }
.fi { background: #F7F7F8; border: 1px solid transparent; }
.fi:focus { background: #FFFFFF; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(255,107,53,.12); }

/* 字体归一（界面层；海报/册子预览保留白名单） */
.cs-title, .rules-title, .cat-lead-t, .srch-nothing-t,
.cs-avatar, .cs-empty-stamp { font-family: var(--font-sans); }
.sp-pick-stamp { font-family: var(--font-stamp); }
.explain { font-size: 15px; line-height: 1.7; letter-spacing: 0; color: var(--ink-2); }
.sp-pick-note { font-size: 15px; line-height: 1.7; letter-spacing: 0; }
.intro, .t-p, .tiny, .set-intro-plain, .rules-entry-line { line-height: 1.7; letter-spacing: 0; }
.pc-note-strip, .pc-note .t-span { letter-spacing: 0; line-height: 1.8; }
.spv2-h1 { line-height: 1.25; letter-spacing: .5px; }

/* 数字等宽 */
.count, .today, .stat .t-b, .txn .td, .txn .ta,
.progress-hero .ph-right, .cf-top .no, .card-row .s,
.weekly-data .b, .sb2-stat-n, .swg-count, .dw-env-pmk-date,
.rc-count, .cs-counter, .li-val, .cs-time, .ob-no { font-variant-numeric: tabular-nums; }

/* 弹层 / Toast */
.sheet { border: none; box-shadow: var(--shadow-modal); }
.modal.centered .sheet { border: none; box-shadow: var(--shadow-xl); }
.modal { background: rgba(0,0,0,.45); backdrop-filter: blur(8px); }
.toast { background: #FFFFFF; border: 1px solid var(--border-default); color: var(--ink-1); box-shadow: var(--shadow-lg); }
.toast-progress { background: transparent; }
.toast-progress .t-i { background: rgba(255,107,53,.30); }
