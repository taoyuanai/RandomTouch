.ob-no{width:26px;height:26px;flex:none;border-radius:50%;margin-top:2px;
background:var(--orange-50);border:1px solid var(--orange-200);color:var(--orange-600);
display:flex;align-items:center;justify-content:center;
font-family:var(--font-mono);font-size:12px;font-weight:600}
.ob-txt{flex:1;min-width:0}
.ob-st{font-size:14px;font-weight:600;color:var(--ink-1);letter-spacing:.5px}
