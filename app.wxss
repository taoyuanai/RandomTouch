/* ═══ 卡集公开互动：心动 + 留言 ═══ */
.sp-social{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}
.sp-like{display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;
  border:1px solid var(--hairline);border-radius:999px;background:var(--surface-card);
  transition:background .18s ease,border-color .18s ease,transform .12s ease}
.sp-like.on{background:var(--orange-50);border-color:var(--orange-200)}
.sp-like.on .sp-heart{color:var(--orange-500)}
.sp-heart{font-size:21px;line-height:1;color:var(--orange-400);
  display:inline-block;transform-origin:50% 55%}
.sp-like-n{font-size:14px;font-weight:600;color:var(--ink-2);
  font-variant-numeric:tabular-nums}
.sp-like-l{font-size:12px;color:var(--ink-3);letter-spacing:.5px}
.sp-like.pop .sp-heart{animation:spHeartPop .32s var(--ease-bounce) both}
@keyframes spHeartPop{
  0%{transform:scale(1)}
  38%{transform:scale(1.38)}
  70%{transform:scale(.94)}
  100%{transform:scale(1)}
}
.sp-social-press{opacity:.68}
.sp-comment{display:flex;align-items:center;gap:6px;height:38px;padding:0 4px 0 12px;
  font-size:13px;color:var(--ink-2);letter-spacing:.2px}
.sp-comment-t{font-size:13px;color:var(--ink-2)}
.sp-chev{width:6px;height:6px;flex:none;margin-top:-1px;
  border-top:1.5px solid var(--ink-4);border-right:1.5px solid var(--ink-4);
  transform:rotate(45deg)}

/* ═══ 签友留言半屏 ═══ */
#commentsModal{z-index:130}
.comments-sheet{height:auto;max-height:74vh;display:flex;flex-direction:column;overflow:hidden;
  padding-bottom:calc(16px + env(safe-area-inset-bottom))}
.cs-head{display:flex;align-items:flex-start;justify-content:space-between;flex:none;
  padding-right:40px}
.cs-kicker{font-size:11px;letter-spacing:3px;color:var(--ink-4)}
.cs-title{margin-top:6px;font-family:var(--font-serif);font-size:18px;font-weight:600;
  color:var(--ink-1);letter-spacing:.5px;line-height:1.4;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:240px}
.cs-close{position:absolute;top:14px;right:16px;z-index:2}
.cs-scroll{flex:1;min-height:0;max-height:52vh;margin-top:16px}
.cs-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--hairline)}
.cs-item:first-child{padding-top:4px}
.cs-avatar{flex:none;width:34px;height:34px;border-radius:50%;
  background:var(--orange-50);color:var(--orange-600);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-serif);font-size:14px;font-weight:600}
.cs-main{flex:1;min-width:0}
.cs-meta{display:flex;align-items:center;gap:7px}
.cs-name{font-size:13px;font-weight:600;color:var(--ink-1)}
.cs-badge{font-size:10px;line-height:1;padding:3px 6px;border-radius:999px;
  background:var(--orange-50);color:var(--orange-600);letter-spacing:.5px}
.cs-time{margin-left:auto;font-size:11px;color:var(--ink-4);letter-spacing:.3px}
.cs-text{margin-top:6px;font-size:15px;line-height:1.72;color:var(--ink-2);
  word-break:break-word}
.cs-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:220px;text-align:center;padding:24px 0}
.cs-empty-stamp{width:48px;height:48px;border-radius:50%;border:1.5px dashed var(--orange-300);
  color:var(--orange-500);font-family:var(--font-serif);font-size:17px;
  display:flex;align-items:center;justify-content:center;transform:rotate(-8deg)}
.cs-empty-t{margin-top:14px;font-size:15px;font-weight:600;color:var(--ink-2)}
.cs-empty-s{margin-top:6px;font-size:12px;color:var(--ink-4);letter-spacing:.5px}
.cs-compose{flex:none;padding-top:12px;border-top:1px solid var(--hairline)}
.cs-textarea{width:100%;min-height:44px;max-height:96px;padding:10px 12px;
  box-sizing:border-box;border-radius:12px;background:var(--surface-muted);
  font-size:15px;line-height:1.6;color:var(--ink-1)}
.cs-compose-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.cs-counter{font-size:11px;color:var(--ink-4);font-variant-numeric:tabular-nums}
.cs-send{height:34px;line-height:34px;padding:0 20px;border-radius:999px;
  background:var(--orange-500);color:#FFF;font-size:13px;font-weight:600;
  letter-spacing:.5px;opacity:.4;transition:opacity .16s ease}
.cs-send.on{opacity:1}
.cs-send::after{border:none}
.cs-locked{flex:none;padding:14px 0 4px;border-top:1px solid var(--hairline);
  display:flex;align-items:center;justify-content:space-between;gap:12px}
.cs-lock-t{flex:1;font-size:13px;line-height:1.6;color:var(--ink-3)}
.cs-lock-btn{flex:none;height:36px;line-height:36px;padding:0 16px;border-radius:999px;
  background:var(--orange-50);color:var(--orange-600);font-size:12px;font-weight:600;
  border:1px solid var(--orange-200)}
.cs-lock-btn::after{border:none}

/* ═══ 卡集分享 / 分享落地 ═══ */
.subhead .share-btn{margin-left:auto;height:28px;line-height:26px;padding:0 12px;
  border-radius:999px;border:1px solid var(--orange-200);background:var(--orange-50);
  color:var(--orange-600);font-size:12px;font-weight:600;letter-spacing:.5px}
.subhead .share-btn::after{border:none}
.share-hint{display:flex;align-items:center;gap:8px;margin:2px 0 14px;
  padding:8px 12px;border-radius:12px;background:var(--orange-50);
  color:var(--orange-600);font-size:12px;letter-spacing:.5px}
.share-hint::before{content:'';width:6px;height:6px;border-radius:50%;
  background:var(--orange-500);flex:none}

/* ═══ 卡集封面（3:4 图片 / 编辑器上传） ═══ */

.cover-edit{display:flex;align-items:flex-start;gap:14px}
.cover-edit-box{position:relative;width:96px;height:128px;flex:none;overflow:hidden;
  border:1.5px dashed var(--orange-200);border-radius:10px;
  background:linear-gradient(180deg,#FFFFFF,var(--orange-50));
  display:flex;align-items:center;justify-content:center;
  transition:border-color .15s ease,background .15s ease}
.cover-edit-box.has{border-style:solid;border-color:var(--border-default);background:var(--surface-muted)}
.cover-edit-box:active{transform:scale(.99)}
.cover-edit-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cover-edit-empty{display:flex;flex-direction:column;align-items:center;gap:6px;
  color:var(--text-tertiary);font-size:11px;letter-spacing:1px}
.cover-edit-plus{font-size:24px;line-height:1;color:var(--orange-400);font-weight:300}
.cover-edit-side{flex:1;min-width:0}
.cover-edit-tip{font-size:13px;font-weight:600;color:var(--ink-1);letter-spacing:.3px}
.cover-edit-sub{margin-top:6px;font-size:11px;line-height:1.65;color:var(--text-tertiary)}
.cover-edit-actions{display:flex;align-items:center;gap:12px;margin-top:12px}
.cover-edit-del{font-size:12px;color:var(--text-tertiary);letter-spacing:.5px;padding:6px 2px}
.cover-edit-del::after{border:none}

/* ═══ 抽卡回响：心动 + 留一句 ═══ */
.dw-echo{display:flex;align-items:center;justify-content:center;gap:12px;
  margin-top:14px;flex-wrap:wrap}
.dw-echo-like{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;
  border-radius:999px;border:1px solid var(--hairline);background:var(--paper-card);
  color:var(--ink-2);font-size:12px;letter-spacing:.3px;
  transition:background .16s ease,border-color .16s ease}
.dw-echo-like.on{background:var(--orange-50);border-color:var(--orange-200);color:var(--orange-600)}
.dw-echo-heart{font-size:17px;line-height:1;color:var(--orange-400);display:inline-block;
  transform-origin:50% 55%}
.dw-echo-like.on .dw-echo-heart{color:var(--orange-500)}
.dw-echo-like.pop .dw-echo-heart{animation:spHeartPop .32s var(--ease-bounce) both}
.dw-echo-n{font-weight:600;font-variant-numeric:tabular-nums}
.dw-echo-l{font-size:11px;color:var(--ink-3)}
.dw-echo-comment{display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 8px;
  color:var(--ink-2);font-size:12px;letter-spacing:.3px}
.dw-echo-pen{font-size:14px;line-height:1;color:var(--orange-400)}
.dw-echo-press{opacity:.65}

/* ═══ 怎么玩：我的页摘要 + 详情页一行 + 完整规则半屏 ═══ */
.rules-entry{background:var(--surface-card);border:1px solid var(--hairline);
  border-radius:14px;padding:14px 16px;margin-bottom:12px}
.rules-entry-head{display:flex;align-items:center;justify-content:space-between;
  margin-bottom:8px}
.rules-entry-head .t-b{font-size:15px;font-weight:600;color:var(--ink-1);letter-spacing:.5px}
.rules-entry-more{font-size:11px;color:var(--orange-600);letter-spacing:.5px}
.rules-entry-go{margin-left:2px}
.rules-entry-line{position:relative;padding-left:12px;font-size:12px;line-height:1.9;
  color:var(--ink-2);letter-spacing:.2px}
.rules-entry-line::before{content:'';position:absolute;left:2px;top:.85em;
  width:3px;height:3px;border-radius:50%;background:var(--orange-300)}
.rules-entry-line.muted{color:var(--ink-3)}
.rules-entry-press{opacity:.8}

.rule-brief{display:flex;align-items:center;justify-content:space-between;gap:12px;
  margin:0 0 12px;padding:12px 14px;border:1px solid var(--hairline);
  border-radius:12px;background:var(--surface-card)}
.rule-brief-main{flex:1;min-width:0;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.rule-brief-k{flex:none;font-size:12px;font-weight:600;color:var(--orange-600);letter-spacing:.5px}
.rule-brief-t{font-size:12px;color:var(--ink-2);line-height:1.6}
.rule-brief-more{flex:none;font-size:11px;color:var(--ink-3);letter-spacing:.3px}
.rule-brief-press{opacity:.75}

.rules-sheet{max-height:82vh;overflow-y:auto;
  padding-bottom:calc(24px + env(safe-area-inset-bottom))}
.rules-close{position:absolute;top:14px;right:16px;z-index:2}
.rules-kicker{font-size:11px;letter-spacing:3px;color:var(--ink-4)}
/* ═══ 每日提醒设置弹层（订阅消息 V1） ═══ */
.remind-desc{margin-top:10px;font-size:13px;line-height:1.7;color:var(--ink-2)}
.remind-time{display:flex;align-items:center;justify-content:space-between;
  margin-top:12px;padding:14px;border:1px solid var(--hairline);
  border-radius:12px;background:var(--paper-card)}
.remind-time.on{border-color:var(--orange-500);background:var(--orange-50)}
.remind-time-t{font-size:15px;font-weight:600;color:var(--ink-1)}
.remind-time-s{display:block;margin-top:4px;font-size:11px;color:var(--ink-3)}
.remind-radio{width:18px;height:18px;flex:none;border-radius:50%;
  border:1.5px solid var(--hairline);box-sizing:border-box}
.remind-time.on .remind-radio{border-color:var(--orange-500);
  background:var(--orange-500);box-shadow:inset 0 0 0 3px var(--paper-card)}
.remind-btn{width:100%;margin-top:18px}
.rules-title{margin-top:6px;font-family:var(--font-serif);font-size:22px;
  font-weight:600;color:var(--ink-1);letter-spacing:1px}
.rules-block{margin-top:18px}
.rules-h{font-size:11px;letter-spacing:2px;color:var(--orange-600);margin-bottom:8px}
.rules-li{display:flex;gap:10px;margin-bottom:8px;font-size:14px;line-height:1.7;
  color:var(--ink-2)}
.rules-n{flex:none;width:18px;height:18px;border-radius:50%;margin-top:2px;
  background:var(--orange-50);color:var(--orange-600);font-size:10px;font-weight:600;
  display:flex;align-items:center;justify-content:center}
.rules-tx{flex:1;min-width:0}
.rules-foot{margin-top:20px;padding-top:14px;border-top:1px dashed var(--hairline);
  text-align:center;font-size:12px;color:var(--ink-3);letter-spacing:.5px}

/* ═══ 推荐卡集：小方块 ═══ */
.rec-section{margin-top:34px;padding-top:22px;border-top:1px solid var(--hairline)}
.rec-head{display:flex;align-items:baseline;justify-content:space-between}
.rec-head-t{font-size:16px;font-weight:600;color:var(--ink-1);letter-spacing:.5px}
.rec-refresh{font-size:11px;color:var(--ink-3);letter-spacing:.3px}
.rec-tabs{display:flex;gap:18px;margin:10px 0 12px}
.rec-tab{font-size:12px;color:var(--ink-3);padding-bottom:4px;
  border-bottom:1.5px solid transparent}
.rec-tab.on{color:var(--orange-600);border-bottom-color:var(--orange-500);font-weight:600}
.rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.rec-card{position:relative;aspect-ratio:1/1;border-radius:12px;overflow:hidden;
  background:var(--surface-muted);box-shadow:var(--shadow-card);
  transition:transform .15s ease,opacity .15s ease}
.rec-card-press{transform:scale(.98);opacity:.92}
.rec-cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.rec-fallback{display:flex;align-items:center;justify-content:center;
  padding-bottom:14px;background:linear-gradient(160deg,#FFFDF6,#F3E6D2)}
.rec-fallback-char{font-family:var(--font-serif);font-size:34px;font-weight:600;
  color:var(--ink-1);opacity:.82;line-height:1}
.rec-shade{position:absolute;left:0;right:0;bottom:0;height:66%;
  background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.66));pointer-events:none}
.rec-badge{position:absolute;top:7px;left:7px;z-index:2;
  padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.92);
  color:var(--orange-600);font-size:10px;font-weight:600;line-height:1.4;letter-spacing:.3px}
.rec-hot{position:absolute;top:7px;right:7px;z-index:2;
  padding:2px 6px;border-radius:999px;background:rgba(0,0,0,.38);
  color:#FFF;font-size:10px;line-height:1.4;letter-spacing:.3px}
.rec-title{position:absolute;left:8px;right:8px;bottom:22px;z-index:2;
  font-size:12px;font-weight:600;line-height:1.35;color:#FFF;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.rec-meta{position:absolute;left:8px;right:8px;bottom:7px;z-index:2;
  font-size:9px;color:rgba(255,255,255,.82);letter-spacing:.2px}

/* 抽卡后再抽抽看 */
.draw-rec{width:100%;margin-top:26px;padding-top:18px;border-top:1px dashed var(--hairline)}
.rec-head-compact{margin-bottom:10px}
.draw-rec-empty{text-align:center;font-size:12px;color:var(--ink-3);
  letter-spacing:.5px;padding:18px 0 4px}

/* 抽空后的下一集 */
.dp-next{width:100%;margin-top:28px;opacity:0;transform:translateY(10px);
  pointer-events:none;transition:opacity .35s ease,transform .35s ease}
.dp-next.show{opacity:1;transform:none;pointer-events:auto}
.dp-next-t{text-align:center;font-size:12px;color:var(--ink-3);
  letter-spacing:1px;margin-bottom:10px}
.dp-next .rec-title{font-size:11px}
.dp-next .rec-meta{font-size:8px}
.dp-next-more{text-align:center;font-size:11px;color:var(--orange-600);
  letter-spacing:.5px;margin-top:10px}
.dp-next .rec-fallback-char{display:none}
.dp-next .rec-title{font-size:10px;bottom:19px}
.dp-next .rec-meta{font-size:8px;bottom:6px}
.dp-next .rec-badge,.dp-next .rec-hot{font-size:9px;padding:1px 5px}
.rec-card.is-fallback .rec-shade{background:linear-gradient(180deg,rgba(255,255,255,0),rgba(255,253,246,.94))}
.rec-card.is-fallback .rec-title{color:var(--ink-1)}
.rec-card.is-fallback .rec-meta{color:var(--ink-3)}
.rec-card.is-fallback .rec-hot{background:rgba(0,0,0,.08);color:var(--ink-3)}
.rec-card.is-fallback .rec-fallback-char{opacity:.22}

/* ═══ 题眼 · 金色签名（作者偏爱） ═══ */




@keyframes sigStampIn{
  0%{transform:rotate(-4deg) scale(1.8);opacity:0}
  55%{transform:rotate(-4deg) scale(.94);opacity:.95}
  75%{transform:rotate(-4deg) scale(1.04);opacity:.9}
  100%{transform:rotate(-4deg) scale(1);opacity:.9}
}

.collection-tail-note{margin:var(--space-3) 0;text-align:center;
  font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:.5px}


.rdot.gold{background:#B78413 !important;border-color:#B78413 !important}
.ed-sig-mark{flex:none;width:22px;height:22px;border-radius:50%;
  border:1px solid #B78413;color:#7A5410;font-family:var(--font-serif);
  font-size:11px;display:flex;align-items:center;justify-content:center;
  transform:rotate(8deg)}
.sig-editor{display:flex;align-items:center;justify-content:space-between;gap:12px}
.sig-editor-txt{flex:1;min-width:0}
.sig-editor-txt .t-label{margin-bottom:2px}
.sig-note-wrap{margin-top:12px;padding-top:12px;border-top:1px dashed var(--hairline)}





.poster-sig-stamp{position:absolute;top:54px;right:24px;padding:2px 8px;
  border:1.5px solid #B78413;border-radius:2px;color:#7A5410;
  font-size:10px;font-weight:600;letter-spacing:1px;
  background:rgba(255,255,255,.7);transform:rotate(-4deg)}
.poster-sig-note{margin:14px 22px 0;text-align:center;font-family:var(--font-serif);
  font-size:14px;line-height:1.7;color:var(--ink-2)}
.h916-sig{padding:2px 6px;border:1px solid #B78413;border-radius:2px;
  color:#7A5410;font-size:9px;font-weight:600;letter-spacing:1px}
.weekly-card.sig{box-shadow:inset 0 3px 0 #B78413}
.sig-switch{width:44px;height:26px;flex:none;border-radius:999px;background:var(--gray-200);
  position:relative;transition:background .18s ease}
.sig-switch.on{background:#B78413}
.sig-switch-knob{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;
  background:#FFF;box-shadow:0 1px 3px rgba(0,0,0,.18);transition:transform .18s ease}
.sig-switch.on .sig-switch-knob{transform:translateX(18px)}
.poster-card.sig{box-shadow:0 8px 32px rgba(183,132,19,.16)}
.h916-bar.sig{background:linear-gradient(90deg,#F0CF7E,#B78413)}

/* D2 · 抽卡失败态 */
.dw-error{margin-top:18px;display:flex;flex-direction:column;align-items:center;gap:10px}
.dw-error-msg{font-family:var(--font-mono);font-size:12px;letter-spacing:.5px;color:var(--error)}
.dw-error-retry{min-width:150px;height:36px;padding:0 24px;border-radius:999px;
border:1px solid var(--hairline);background:var(--paper-card);
display:flex;align-items:center;justify-content:center;
font-size:13px;color:var(--ink-2);letter-spacing:1px}


/* D3 · 原生 tab 页：底部留给原生 tabBar，不再用 110px 自定义 tabbar 间距 */
#page-home, #page-cards, #page-create, #page-me { padding-bottom: 24px; }

/* D4 · 详情页分享按钮（随 subhead 移除迁入心动行） */
.sp-share{display:inline-flex;align-items:center;height:38px;padding:0 14px;
border-radius:999px;border:1px solid var(--orange-200);background:var(--orange-50);
color:var(--orange-600);font-size:12px;font-weight:600;letter-spacing:.5px}
.sp-share::after{border:none}

/* D6 · 骨架屏 */
.skel{position:relative;overflow:hidden;background:var(--surface-muted);border-radius:var(--radius-md)}
.skel::after{content:'';position:absolute;inset:0;transform:translateX(-100%);
background:linear-gradient(90deg,transparent,rgba(255,255,255,.65),transparent);
animation:skeletonShimmer 1.4s ease-in-out infinite}
.skel-list{padding:0 4px}
.skel-book{display:flex;gap:12px;padding:16px 0}
.skel-cover{width:72px;height:102px;flex:none;border-radius:6px}
.skel-book-txt{flex:1;padding-top:6px}
.skel-line{height:14px;margin-bottom:10px}
.skel-sub{display:flex;gap:12px;align-items:center;margin-bottom:12px}
.skel-sign{width:44px;height:60px;flex:none;border-radius:6px}
.skel-hero{padding:18px 0 8px}
.skel-hero-cover{width:168px;height:237px;margin:0 auto 16px;border-radius:10px}
.skel-hero-line{height:20px;margin:0 auto 10px}

/* D6 · 保留的组合规则 */

.explain,.sp-pick-note{letter-spacing:0;line-height:1.75;color:var(--ink-2)}

/* D7 · 收集模块紧凑行 */
.collect-metrics{display:flex;gap:16px;margin-top:14px}
.cm-item{flex:1;display:flex;align-items:center;gap:8px;min-width:0}
.cm-label{font-size:12px;color:var(--text-secondary);flex:none;letter-spacing:.5px}
.cm-track{flex:1;height:4px;background:var(--gray-100);border-radius:var(--radius-full);overflow:hidden}
.cm-track .t-i{display:block;height:100%;border-radius:var(--radius-full);
