/* V2 · hero 册子（168×237）+ 腰封 + 价格贴纸 */
.sp-hero{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-start;text-align:left;
padding:4px 0 8px}
.sp-hero-cover{position:relative;width:168px;height:237px;flex:none;border-radius:10px;
background-color:var(--paper-face);background-image:var(--weave);
box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(44,43,51,.10),0 12px 26px rgba(43,43,51,.10);
overflow:hidden}
.sp-hero-cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}
