/* ═══ V2 · 版票（map）═══ */
.sheet{display:flex;flex-direction:column;gap:10px;margin:12px 0}
.sheet-row{display:flex;gap:10px}
.stamp-cell{flex:1;display:flex;justify-content:center;min-width:0}
.cell-in{position:relative;width:105px;height:148px}
