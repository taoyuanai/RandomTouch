/* ══════════════════════════════════════════════════════════
   微信小程序适配层
   - 页面自身滚动（不使用 .phone 固定高度）
   - 自定义导航安全区 / 底部 tabbar / 弹层 / 安全区
   - 原生 button 重置
   - WXML 标签映射（.t-*）与图标/印戳适配
   ══════════════════════════════════════════════════════════ */
page{
  background: var(--surface-page);
  font-family: var(--font-sans);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
view, text, button, input, textarea, image{
  box-sizing: border-box;
}
button{
  width: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: inherit;
  overflow: visible;
}
button::after{ border: none; }
/* 微信原生 button 默认宽度为 184px，需按用途覆写 */
page button{ width: auto; }
page .cta,
page .ghost,
page .newcraft-btn,
page .ed-add{ width: 100%; }
page .close-btn{ width: 32px; }
input, textarea{
  font-family: inherit;
  color: inherit;
  background: transparent;
  border: none;
  outline: none;
}
input::placeholder, textarea::placeholder{ color: var(--text-tertiary); }

.phone{
  width: 100%;
  height: auto;
  min-height: 100vh;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
  display: block;
  position: relative;
  background: var(--surface-page);
}
.screen{
  overflow: visible;
  position: static;
  flex: none;
}
.page{
  display: block;
  min-height: 100vh;
  padding-top: var(--navtop, var(--statusbar, 0px));
  padding-bottom: 110px;
}
.page-head{
  top: var(--navtop, var(--statusbar, 0px));
}
.status-spacer{
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navtop, var(--statusbar, 0px));
  background: var(--surface-page);
  z-index: 30;
  pointer-events: none;
}

/* 底部导航：固定在视口底部 */
.tabbar{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar .t-svg{
  display: block;
  width: 22px;
  height: 22px;
  margin: 0 auto 3px;
}

/* 吸底按钮 / 弹层 / Toast */

#page-set{ padding-bottom: 160px; }
.modal{
  position: fixed;
  z-index: 80;
}
.sheet{
  padding-bottom: calc(var(--space-5) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
}
.modal.centered{
  padding-top: calc(var(--navtop, 0px) + var(--space-3));
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  align-items: center;
}
.modal.centered .sheet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}
.toast{
  bottom: calc(100px + constant(safe-area-inset-bottom));
  bottom: calc(100px + env(safe-area-inset-bottom));
  z-index: 140;
}
.poster-sheet.booklet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}
.demo-actions{
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-1);
}
.mini-cta.demo-action{
  flex: 1 1 140px;
  width: auto;
  height: auto !important;
  min-height: 34px;
  padding: 7px 8px !important;
  line-height: 1.4 !important;
  white-space: normal;
  font-size: 12px;
}
.bottom-sheet{
  max-height: calc(100vh - 40px);
  overflow-y: auto;
}
.toast{
  white-space: normal;
  line-height: 1.5;
}
#posterModal .poster-card{
  padding-top: calc(var(--space-5) + 26px);
}
#posterModal .poster-actions{
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
}

/* 卡背容器 */
.card-back-inner{
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.pc-empty{
  padding: var(--space-5) var(--space-4);
}
/* 解签内容：在空白区域垂直居中 */
.pc-empty-center{
  flex:1;min-height:0;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  text-align:center;
}
.pc-empty-center .explain{margin:0;flex:none}

/* 印戳：用真实文本替代 CSS attr()，避免小程序不支持 */
.stamp::before,
.stamp::after,
.bk-stamp::before,
.bk-stamp::after{
  content: none !important;
  display: none !important;
}
.stamp-text{
  position: relative;
  z-index: 1;
  font: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  color: inherit;
}

/* 图标（PNG）保持与原型 SVG 相同尺寸/占位 */
image.t-svg{ display: inline-block; vertical-align: middle; }
.tabbar button image.t-svg{ display: block; }
.search-bar image.t-svg{ width: 18px; height: 18px; flex: none; }
.search-bar image.scan-icon{ width: 20px; height: 20px; }
.set-heat image.t-svg{ width: 14px; height: 14px; }
.cf-bottom .flip-hint image.t-svg{ width: 14px; height: 14px; }
.rec-slot.empty image.t-svg{ width: 18px; height: 18px; flex: none; }
.rc-photo-empty image.t-svg{ width: 26px; height: 26px; }
.mc-badge image.t-svg{ width: 9px; height: 9px; }

/* 图片组件默认宽高重置 */
image.t-img{
  width: 100%;
  height: 100%;
  display: block;
}

/* 长文本换行 */
.draw-tail{ white-space: pre-line; }

/* 输入控件（原生 input/textarea） */
.fi{
  width: 100%;
  font-size: var(--text-lg);
  line-height: 1.5;
  letter-spacing: 0.5px;
  padding: var(--space-3);
  background: var(--surface-muted);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  text-align: left;
}
.fi:focus{ border-color: var(--border-focus); background: var(--surface-card); }
input.fi{ height: 44px; padding: 0 var(--space-3); }
textarea.fi{ height: 84px; min-height: 84px; }

/* 页面切换动画 */
.page{ animation: fadein var(--duration-normal) var(--ease-default); }

/* 禁止长按选中 */
.page, .tabbar, .modal{ -webkit-user-select: none; user-select: none; }
input, textarea, .stamp, .stamp-text, .bk-stamp{ -webkit-user-select: auto; user-select: auto; }


/* ── 原生 button / 导航安全区补充 ── */
#page-create{ padding-top: calc(var(--navtop, var(--statusbar, 0px)) + var(--space-1)); }
#page-me{ padding-top: var(--navtop, var(--statusbar, 0px)); }

.cta,
.ghost,
.mini-cta,
.follow,
.ed-add,
.ed-del,
.seg button,
.subhead .back{
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar button{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 输入框在小程序原生组件下的保底样式 */


/* ══════ V2.5 · 抽卡页动作区：主次分层 ══════ */


#letterActions .cta{height:44px;font-size:var(--text-md)}
#letterActions .cta.draw-primary{height:52px;font-size:var(--text-lg);letter-spacing:1px}

#letterActions .draw-tail{margin-top:var(--space-3)}

/* ══════ V2.6 · 大卡操作行 + 海报层级 ══════ */
.bigcard-actions{display:flex;justify-content:center;margin-top:var(--space-3)}
.bigcard-actions .cta{min-width:220px;height:44px}
/* 海报会从大卡弹层内部打开，必须压在大卡之上 */
#posterModal{z-index:90}

/* ══════ V2.6 · 周记 / 朋友圈 9:16 海报 ══════ */

/* 9:16 海报较高，弹层允许内部滚动 */
.poster-sheet.scroll{overflow-y:auto !important}
.poster-sheet.scroll .poster-actions{
  position:sticky;bottom:0;z-index:2;
  padding:var(--space-2) var(--space-3) var(--space-3);gap:6px;
}
.poster-sheet.scroll .poster-actions .cta{height:42px}
.poster-sheet.scroll .poster-actions .ghost{height:34px}
.poster-sheet.scroll .poster-ratio button{height:26px}

/* 海报比例切换 */
.poster-ratio{
  display:flex;gap:6px;justify-content:center;
  background:var(--surface-muted);border-radius:var(--radius-full);padding:3px;
}
.poster-ratio button{
  flex:1;height:30px;border:none;border-radius:var(--radius-full);
  background:transparent;color:var(--text-tertiary);
  font-size:var(--text-xs);font-weight:var(--weight-medium);letter-spacing:1px;
  font-family:inherit;cursor:pointer;
  transition:all var(--duration-fast) var(--ease-default);
}
.poster-ratio button.on{background:var(--surface-card);color:var(--text-primary);box-shadow:var(--shadow-xs)}

/* 朋友圈大 QR */
.poster-qr.big{
  width:60px;height:60px;border-radius:8px;border:8px solid #FFF;
  box-shadow:0 0 0 1px var(--border-default);font-size:var(--text-sm);
}

/* ── 周记 3:4 ── */
.poster-weekly{padding:var(--space-5)}
.weekly-head{margin-bottom:8px;padding-bottom:8px}
.weekly-kicker{font-size:11px;color:var(--orange-500);letter-spacing:2px;margin-top:8px}
.weekly-title{
  font-family:var(--font-heritage);font-size:24px;line-height:1.4;
  font-weight:var(--weight-semibold);color:var(--gray-800);
  margin:6px 0 12px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.weekly-wall{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin:0 0 12px}
.weekly-card{
  position:relative;width:calc((100% - 27px)/4);aspect-ratio:3/4;
  background:#FFF;border:1px solid var(--orange-100);border-radius:7px;
  box-shadow:var(--shadow-xs);
  display:flex;align-items:center;justify-content:center;
  padding:8px 5px;overflow:hidden;
}
.weekly-card .wc-bar{position:absolute;top:0;left:0;right:0;height:4px;background:var(--mint-400)}
.weekly-card.N .wc-bar{background:var(--mint-400)}
.weekly-card.R .wc-bar{background:var(--sky-400)}
.weekly-card.SR .wc-bar{background:var(--honey-400)}
.weekly-card.SSR .wc-bar{background:var(--gradient-ssr)}
.weekly-card .wc-word{
  font-family:var(--font-heritage);font-size:15px;line-height:1.25;
  letter-spacing:0.5px;text-align:center;color:var(--text-primary);word-break:break-word;
}
.weekly-card .wc-word.bw-6{font-size:13px}
.weekly-card .wc-word.bw-7{font-size:12px}
.weekly-card.blank{
  border-style:dashed;border-color:var(--gray-200);
  background:transparent;box-shadow:none;color:var(--gray-300);
}
.weekly-card.blank text{font-size:10px;letter-spacing:2px}

/* 照片版：拍立得拼贴 */
.weekly-collage{position:relative;height:190px;margin:4px 0 8px}
.weekly-polaroid{
  position:absolute;background:#FFF;padding:7px 7px 20px;
  border:1px solid var(--border-default);box-shadow:0 6px 16px rgba(0,0,0,0.08);
}
.weekly-polaroid image{width:100%;height:100%;display:block;object-fit:cover}
.weekly-polaroid.main{width:64%;height:150px;left:10%;top:0;transform:rotate(-2deg);z-index:2}
.weekly-polaroid.sub{width:42%;height:112px;right:5%;top:52px;transform:rotate(2.5deg);z-index:1;padding-bottom:7px}
.polaroid-date{
  position:absolute;left:0;right:0;bottom:3px;text-align:center;
  font-family:var(--font-heritage);font-size:10px;color:var(--gray-500);letter-spacing:0.5px;
}
.weekly-words{
  font-size:11px;color:var(--gray-500);letter-spacing:0.5px;margin:0 0 10px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* 邮戳带：一周七格 */
.weekly-stamps{display:flex;gap:7px;justify-content:center;margin:6px 0 10px}
.weekly-stamp{
  flex:1;max-width:44px;height:16px;border:1px dashed var(--gray-300);border-radius:2px;
  display:flex;align-items:center;justify-content:center;
  font-family:'Courier New',Courier,monospace;font-size:7px;letter-spacing:0;
  color:var(--gray-300);opacity:0.55;line-height:1;
}
.weekly-stamp.on{border:1.5px solid rgba(30,30,30,0.9);color:rgba(30,30,30,0.9);opacity:1}

/* 数据行 */
.weekly-data{
  display:flex;justify-content:center;gap:10px;flex-wrap:wrap;
  font-size:11px;color:var(--gray-600);letter-spacing:0.3px;margin-bottom:8px;
}
.weekly-data .b{
  font-size:14px;font-weight:var(--weight-bold);color:var(--gray-800);
  font-variant-numeric:tabular-nums;
}
.weekly-quote{
  font-family:var(--font-heritage);font-size:13px;line-height:20px;color:var(--gray-700);
  letter-spacing:0.5px;margin-bottom:6px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.weekly-footer{margin-top:6px;padding-top:8px;border-top:1px dashed var(--border-divider);align-items:flex-end}
.weekly-foot-right{display:flex;align-items:center;gap:8px}
.weekly-cta{font-size:12px;font-weight:var(--weight-semibold);color:var(--orange-600);letter-spacing:0.5px}

/* ── 周记 9:16（4 列双行卡墙，第 8 槽虚线「明天」） ── */
.weekly-916{padding:var(--space-5)}
.weekly-916 .weekly-head{margin-bottom:6px;padding-bottom:8px}
.weekly-916 .weekly-kicker{margin-top:4px;font-size:12px;letter-spacing:2px}
.weekly-916 .weekly-title{font-size:30px;line-height:1.33;margin:6px 0 10px}
.weekly-916 .weekly-wall{gap:8px;margin-bottom:10px}
.weekly-916 .weekly-wall .weekly-card{width:calc((100% - 24px)/4);padding:7px 3px}
.weekly-916 .weekly-card .wc-word{font-size:12px}
.weekly-916 .weekly-card .wc-word.bw-6{font-size:10.5px}
.weekly-916 .weekly-card .wc-word.bw-7{font-size:9.5px}
.weekly-916 .weekly-stamps{gap:5px;margin:6px 0 8px}
.weekly-916 .weekly-stamp{max-width:38px;height:14px;font-size:6.5px}
.weekly-916 .weekly-quote{font-size:14px;line-height:22px;-webkit-line-clamp:2;margin-bottom:6px}
.weekly-916 .weekly-cta{font-size:14px;font-weight:var(--weight-bold)}
.weekly-916 .weekly-collage{height:230px}
.weekly-916 .weekly-footer{margin-top:auto;padding-top:10px}

/* ── 抽卡明信片 9:16 ── */
.poster-h916{
  position:relative;padding:var(--space-5);aspect-ratio:9/16;
  display:flex;flex-direction:column;overflow:hidden;
  background:linear-gradient(160deg,var(--orange-50),#FFF 55%);
}
.poster-h916 .h916-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.poster-h916 .h916-veil{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(255,255,255,0.10) 0%,rgba(255,255,255,0.78) 42%,#FFF 85%);
}
.h916-inner{position:relative;z-index:2;display:flex;flex-direction:column;height:100%}
.h916-head{margin-bottom:6px}
.h916-body{position:relative;flex:1;display:flex;align-items:center;justify-content:center;padding:6px 0 0}
.h916-card{
  position:relative;width:66%;aspect-ratio:2/3;background:#FFF;
  border-radius:14px;border:1px solid var(--border-default);
  box-shadow:0 12px 30px rgba(0,0,0,0.10);
  transform:rotate(-1.5deg);padding:14px;display:flex;flex-direction:column;
}
.h916-bar{position:absolute;top:0;left:0;right:0;height:6px;border-radius:14px 14px 0 0}
.h916-bar.N{background:linear-gradient(90deg,var(--mint-300),var(--mint-500))}
.h916-bar.R{background:linear-gradient(90deg,var(--sky-300),var(--sky-500))}
.h916-bar.SR{background:linear-gradient(90deg,var(--honey-300),var(--honey-500))}
.h916-bar.SSR{background:var(--gradient-ssr)}
.h916-cardtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.h916-no{font-size:10px;color:var(--text-tertiary);letter-spacing:0.5px}
.h916-word{
  flex:1;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-heritage);font-size:40px;font-weight:var(--weight-semibold);
  letter-spacing:2px;color:var(--gray-900);text-align:center;line-height:1.2;padding:8px 0;
}
.h916-word.bw-6{font-size:34px}
.h916-word.bw-7{font-size:30px}
.h916-explain{
  font-family:var(--font-heritage);font-size:11px;line-height:17px;color:var(--text-secondary);
  text-align:center;padding:0 6px 6px;letter-spacing:0.5px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.h916-set{text-align:center;font-size:10px;color:var(--text-tertiary);letter-spacing:0.5px}
.h916-stamp{
  position:absolute;right:2%;top:6%;width:52px;height:20px;
  border:1.5px solid #1E1E1E;border-radius:2px;transform:rotate(-4deg);opacity:0.9;
  display:flex;align-items:center;justify-content:center;gap:3px;
  background:rgba(255,255,255,0.72);
}

.h916-stamp-date{font-family:'Courier New',Courier,monospace;font-size:7px;color:#1E1E1E;letter-spacing:0}
.h916-quote{
  font-family:var(--font-heritage);font-size:15px;line-height:24px;color:var(--gray-800);
  text-align:center;margin:10px 2px 4px;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}
.h916-src{text-align:center;font-size:11px;color:var(--gray-500);letter-spacing:0.5px;margin-bottom:8px}
.h916-foot{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  border-top:1px dashed var(--border-divider);padding-top:10px;
}
.h916-cta{font-size:13px;font-weight:var(--weight-semibold);color:var(--orange-600);letter-spacing:0.5px}

/* ── 集齐纪念 9:16 ── */
.poster-m916{aspect-ratio:9/16;display:flex;flex-direction:column;padding:var(--space-5)}
.m916-title{
  font-family:var(--font-heritage);font-size:34px;font-weight:var(--weight-bold);
  letter-spacing:3px;text-align:center;color:var(--text-primary);margin:10px 0 4px;
}
.m916-sub{text-align:center;font-size:var(--text-md);letter-spacing:1px;color:var(--text-secondary);margin-bottom:18px}
.m916-stats{display:flex;justify-content:space-around;margin-bottom:20px}
.m916-stat{text-align:center}
.m916-stat .t-b{
  display:block;font-size:32px;font-weight:var(--weight-bold);color:var(--text-primary);
  line-height:1.1;font-variant-numeric:tabular-nums;
}
.m916-stat .t-b.gold-num{
  background:linear-gradient(135deg,var(--gold-300),var(--gold-600));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.m916-stat .t-span{font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:1px}
.m916-timeline{position:relative;padding-left:20px;margin:0 6px 16px}
.m916-timeline::before{
  content:"";position:absolute;left:5px;top:6px;bottom:6px;width:3px;
  border-radius:99px;background:linear-gradient(180deg,var(--gold-200),var(--gold-400));
}
.m916-node{position:relative;margin-bottom:14px}
.m916-node::before{
  content:"";position:absolute;left:-20px;top:3px;width:10px;height:10px;
  border-radius:50%;background:#FFF;border:3px solid var(--gold-500);
  box-shadow:0 1px 3px rgba(217,162,39,0.25);
}
.m916-node-date{display:block;margin-bottom:2px}
.m916-node .t-b{font-size:var(--text-md);color:var(--text-primary);margin-bottom:2px}
.m916-node .t-span{font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:0.5px}
.m916-quote{
  font-family:var(--font-heritage);font-size:var(--text-md);line-height:1.9;
  color:var(--text-secondary);text-align:center;
  background:rgba(255,255,255,0.6);border-radius:var(--radius-lg);
  padding:12px 14px;margin-bottom:6px;
}
.m916-foot{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  border-top:1px dashed var(--border-divider);padding-top:10px;
}
/* m916 新数据：末节点金色、SSR 引言 / 无 SSR 钢戳说明 */
.m916-node.last::before{
  background:var(--gold-500);border-color:var(--gold-700);
  box-shadow:0 1px 3px rgba(217,162,39,0.3);
}
.m916-node.last .t-b{color:var(--gold-700);font-weight:var(--weight-bold)}
.m916-quote-word{
  font-family:var(--font-heritage);font-size:24px;font-weight:var(--weight-bold);
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.m916-quote-text{
  font-family:var(--font-heritage);font-size:13px;color:var(--text-secondary);
  margin-top:6px;line-height:1.7;
}
.m916-stampnote{
  text-align:center;font-size:12px;color:var(--text-tertiary);
  line-height:1.7;margin:10px 6px;
}

/* ── 集齐纪念 3:4 预览（pm，与 Canvas 字段同源） ── */
.pm{margin-top:4px}
.pm-eyebrow{font-size:11px;color:var(--text-brand);letter-spacing:2px;text-align:center}
.pm-title{
  font-family:var(--font-heritage);font-weight:var(--weight-bold);
  font-size:24px;text-align:center;margin-top:4px;color:var(--text-primary);
}
.pm-settitle{
  font-family:var(--font-heritage);font-size:13px;color:var(--text-secondary);
  text-align:center;margin-top:2px;
}
.pm-stats{display:flex;margin-top:14px}
.pm-stat{flex:1;text-align:center;position:relative}
.pm-stat + .pm-stat::before{
  content:'';position:absolute;left:0;top:4px;bottom:4px;width:1px;background:var(--border-divider);
}
.pm-n{display:block;font-size:22px;font-weight:var(--weight-bold);color:var(--text-primary)}
.pm-n-gold{
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.pm-l{display:block;font-size:10px;color:var(--text-tertiary);letter-spacing:2px;margin-top:2px}
.pm-timeline{display:flex;justify-content:space-between;margin-top:16px;padding:0 8px;position:relative}
.pm-timeline::before{
  content:'';position:absolute;left:14px;right:14px;top:26px;height:1.5px;background:var(--gold-300);
}
.pm-node{display:flex;flex-direction:column;align-items:center;width:33%}
.pm-node-date{font-size:10px;color:var(--text-tertiary)}
.pm-node-dot{
  width:8px;height:8px;border-radius:50%;background:#FFF;
  border:2px solid var(--gold-500);margin:3px 0;
}
.pm-node.last .pm-node-dot{background:var(--gold-500);border-color:var(--gold-700)}
.pm-node-cap{font-size:11px;color:var(--text-secondary)}
.pm-node.last .pm-node-cap{color:var(--gold-700);font-weight:var(--weight-bold)}
.pm-quote{margin-top:16px;text-align:center}
.pm-quote-word{
  font-family:var(--font-heritage);font-size:17px;font-weight:var(--weight-bold);
  background:linear-gradient(180deg,var(--gold-300),var(--gold-500) 55%,var(--gold-700));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.pm-quote-text{
  font-family:var(--font-heritage);font-size:12px;color:var(--text-secondary);
  margin-top:6px;line-height:1.6;
}
.pm-stampnote{margin-top:18px;text-align:center;font-size:11px;color:var(--text-tertiary)}

/* ── 周记入口 ── */






.weekly-banner .wb-text .t-b{
  font-size:var(--text-md);color:var(--text-primary);font-weight:var(--weight-medium);
  letter-spacing:0.5px;margin-bottom:2px;
}
.weekly-banner .wb-text .t-span{font-size:var(--text-sm);color:var(--text-tertiary);letter-spacing:0.5px}

/* ══════════════════════════════════════════════════════════
   V2.7 · 暖纸系统（设计 token 覆盖）
   纸层 / 暖灰墨层 / 珊瑚层 / 校准彩墨层 / 集齐金
   ══════════════════════════════════════════════════════════ */
page{
  --paper-page:#FFFFFF;  --paper-card:#FFFFFF;  --paper-deep:#F5F5F7;
  --ink-1:#1D1D1F;  --ink-2:#6E6E73;  --ink-3:#A1A1A6;  --ink-4:#C7C7CC;
  --ink-soft:var(--ink-3);  --ink-faint:var(--ink-4);
  --hairline:#E5E5EA;

  --brand:#FF6B35;  --brand-deep:#E5541F;  --brand-text:#FF6B35;  --brand-tint:#FFF1E8;
  --rar-N:#10B981;  --rar-R:#0EA5E9;  --rar-SR:#F59E0B;  --rar-SSR:#D9A227;
  --gold-deep:#7A5410;  --gold-mid:#D9A227;  --gold-light:#F0CF7E;

  --shadow-card:0 2px 8px rgba(0,0,0,0.06);
  --shadow-cta:0 2px 8px rgba(255,107,53,0.25);
  --r-card:10px;  --r-pill:999px;

  --font-mono:var(--font-sans);
  --font-serif:var(--font-sans);
  --font-heritage:"PosterSerif","Songti SC","Noto Serif SC","STSong",serif;
  --font-stamp:"Courier New",Courier,monospace;

  /* 映射现有 token，全局一次换底 */
  --surface-page:var(--paper-page);
  --surface-card:var(--paper-card);
  --surface-elevated:#FAFAFA;
  --surface-muted:var(--paper-deep);
  --surface-hover:#F0F0F2;
  --surface-pressed:#E5E5EA;

  --text-primary:var(--ink-1);
  --text-secondary:var(--ink-2);
  --text-tertiary:var(--ink-3);
  --text-disabled:var(--ink-4);
  --text-brand:var(--brand);
  --text-link:var(--rar-R);

  --border-default:rgba(0,0,0,0.06);
  --border-strong:rgba(0,0,0,0.10);
  --border-divider:var(--hairline);
  --border-focus:var(--brand);

  --orange-50:var(--brand-tint);
  --orange-100:#FFE8D8;
  --orange-200:#FFD0B0;
  --orange-300:#FFB088;
  --orange-400:#FF8A5C;
  --orange-500:var(--brand);
  --orange-600:var(--brand-deep);
  --orange-700:var(--brand-text);
  --orange-800:#9E3710;

  --mint-50:#F0FDF7;  --mint-100:#D1FAE5;  --mint-200:#A7F3D0;
  --mint-300:#6EE7B7; --mint-400:#34D399;  --mint-500:var(--rar-N); --mint-600:#059669;
  --sky-50:#F0F9FF;   --sky-100:#E0F2FE;   --sky-200:#BAE6FD;
  --sky-300:#7DD3FC;  --sky-400:#38BDF8;   --sky-500:var(--rar-R); --sky-600:#0284C7;
  --honey-50:#FFFBEB; --honey-100:#FEF3C7; --honey-200:#FDE68A;
  --honey-300:#FCD34D;--honey-400:#FBBF24; --honey-500:var(--rar-SR); --honey-600:#D97706;
  --gold-300:var(--gold-light); --gold-400:#E8B84F;
  --gold-500:var(--gold-mid);   --gold-600:#B78413; --gold-700:var(--gold-deep);

  --gradient-brand:linear-gradient(135deg,#FF8A5C,#FF6B35);
  --gradient-brand-soft:linear-gradient(135deg,#FFB088,#FF8A5C);
  --gradient-surface:linear-gradient(180deg,#FFFFFF,#FAFAFA);

  --shadow-xs:0 1px 3px rgba(0,0,0,0.04);
  --shadow-sm:0 1px 4px rgba(0,0,0,0.05);
  --shadow-md:0 2px 12px rgba(0,0,0,0.06);
  --shadow-lg:0 4px 20px rgba(0,0,0,0.08);
  --shadow-xl:0 8px 30px rgba(0,0,0,0.10);
  --shadow-modal:0 12px 40px rgba(0,0,0,0.15);
}

/* P0 · CTA / 火漆 / 日期：纯珊瑚 + 暖阴影 */
.cta.solid{background:var(--gradient-brand);box-shadow:var(--shadow-cta);border:none}
.cta.solid:active{background:var(--orange-600);transform:scale(0.985);box-shadow:0 1px 4px rgba(255,107,53,0.20)}
.cta-fixed-wrap .cta{box-shadow:var(--shadow-cta)}

.today{font-family:var(--font-mono);letter-spacing:.5px}
/* 情绪的声音：卡词 / 解签统一宋体 */
.bigword,.explain{font-family:var(--font-serif)}

/* 彩墨只做小面积语言：地图点位用校准稀有度色 */
.rdot.N{background:var(--rar-N);border-color:var(--rar-N)}
.rdot.R{background:var(--rar-R);border-color:var(--rar-R)}
.rdot.SR{background:var(--rar-SR);border-color:var(--rar-SR)}
.rdot.SSR{background:var(--rar-SSR);border-color:var(--rar-SSR)}

/* 集名 / 书脊：情绪的声音 */
.bc-info .t-h3,.cover .t-span,.cover-sm .t-span{font-family:var(--font-serif)}
.bc-info .t-h3{font-weight:600}

/* 数字 / 计数：邮戳的声音 */
.stat .t-b,.count,.progress-hero .ph-right,.txn .td,.txn .ta{font-family:var(--font-mono)}

/* 物理按压：沉下去 1px，而不是发光 */
.book-card:active,.card-row:active,.work-row:active{
  transform:translateY(1px);opacity:1;box-shadow:var(--shadow-xs);
}
.cta:active,.ghost:active,.mini-cta:active,.follow:active,.chip:active{
  transform:translateY(1px);
}

/* 阅读页去盒子化：订阅 / 全图（发现列表恢复浮起方框卡） */

#page-cards .pending-banner.rec{border-left-color:var(--gold-mid)}



#page-cards .stats{
  background:transparent;gap:0;border-top:1px solid var(--hairline);
  border-bottom:1px solid var(--hairline);padding:12px 0;margin-bottom:24px;
}
#page-cards .stat{
  background:transparent;border:none;box-shadow:none;border-radius:0;
  position:relative;padding:8px 6px;
}
#page-cards .stat + .stat::before{
  content:'';position:absolute;left:0;top:10px;bottom:10px;
  width:1px;background:var(--hairline);
}


#page-cards .sub-card .sc-info .t-b{font-family:var(--font-serif);font-weight:600}


#page-home .bc-status{font-family:var(--font-mono);font-size:11px}

#page-map .panel{background:transparent;border:none;box-shadow:none;padding:0}
#page-map .panel:hover{box-shadow:none}
#page-map .panel-head .t-b{font-family:var(--font-serif);font-size:20px;font-weight:600}
#page-map .map-cell{
  background:transparent;border:1px solid var(--hairline);border-radius:6px;box-shadow:none;
}
#page-map .map-cell:hover{box-shadow:none;transform:none}
#page-map .map-cell.dark{background:transparent;border:1px dashed var(--hairline);border-radius:6px}
#page-map .map-cell .t-b{font-family:var(--font-serif)}

/* ══════ V2.8 · 详情页：纸面直排 ══════ */
.sp{
  min-height:100vh;box-sizing:border-box;
  padding:40px 24px calc(56px + env(safe-area-inset-bottom));
  background:var(--paper-page);
}

#sp-intro-end{height:1px}












.sp-dot.on{
  border-color:var(--ink-1);background:var(--ink-1);
  box-shadow:0 0 0 3px rgba(41,36,33,.08);
}

.sp.is-done .sp-progress-note{color:var(--gold-deep)}


.sp-grid.c3 .sp-cell{width:calc((100% - 26px)/3);margin-right:13px}
.sp-grid.c3 .sp-cell:nth-child(3n){margin-right:0}
.sp-grid.c4 .sp-cell{width:calc((100% - 36px)/4);margin-right:12px}
.sp-grid.c4 .sp-cell:nth-child(4n){margin-right:0}


.sp-cell.got .sp-cell-in{
  background:var(--paper-card);
  border:1px solid rgba(0,0,0,0.06);
  box-shadow:var(--shadow-card);
}


.sp-cell-word.l4{font-size:17px}
.sp-cell-word.l5{font-size:14px}
.sp-cell-word.l7{font-size:12px}



.sp-rule{width:40px;height:1px;background:var(--hairline);margin:44px auto 0}
.sp-picks{margin-top:28px;padding:0 4px}
.sp-pick + .sp-pick{margin-top:30px}
.sp-pick-head{display:flex;align-items:center}
.sp-pick-stamp{
  transform:rotate(-3deg);
  border:1.5px solid var(--ink-1);border-radius:3px;
  padding:3px 7px;opacity:.85;
  font-family:var(--font-mono);font-size:10px;font-weight:700;
  color:var(--ink-1);letter-spacing:.5px;
}
.sp-pick-meta{
  margin-left:12px;
  font-family:var(--font-mono);font-size:11px;
  color:var(--ink-3);letter-spacing:.5px;
}
.sp-pick-note{
  margin-top:10px;
  font-family:var(--font-serif);font-size:15px;
  line-height:1.7;color:var(--ink-1);
  display:-webkit-box;-webkit-box-orient:vertical;
  -webkit-line-clamp:3;overflow:hidden;
}
.sp-tail{margin:18px 0 24px;display:flex;flex-direction:column;align-items:center}
.sp-cta{
  min-width:236px;height:52px;padding:0 34px;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.sp-cta::after{border:none}
.sp-cta.brand{background:var(--gradient-brand);color:#FFFFFF;box-shadow:var(--shadow-cta)}
.sp-cta.tint{background:var(--brand-tint);color:var(--brand-text)}
.sp-cta.ink{background:var(--ink-1);color:var(--paper-card)}
.sp-cta-press{transform:translateY(1px);opacity:.92}
.sp-tail-note{
  margin-top:14px;text-align:center;
  font-family:var(--font-mono);font-size:11px;
  letter-spacing:1px;color:var(--ink-3);
}
.sp-float{
  position:fixed;left:0;right:0;
  bottom:calc(20px + env(safe-area-inset-bottom));
  display:flex;justify-content:center;
  z-index:70;pointer-events:none;
  opacity:0;transform:translateY(16px);
  transition:opacity .25s ease,transform .25s ease;
}
.sp-float.show{opacity:1;transform:translateY(0);pointer-events:auto}
.sp-float .sp-cta{height:44px;min-width:200px;font-size:15px}

/* ══════ V2.9 · 抽卡页：三组法则 ══════ */
#page-draw{padding:var(--navtop, 0px) 0 0;background:var(--paper-page)}
.dw{
  min-height:calc(100vh - var(--navtop, 0px));
  box-sizing:border-box;background:var(--paper-page);
  display:flex;flex-direction:column;position:relative;
  padding:0 24px calc(32px + env(safe-area-inset-bottom));
}
.dw-back{
  position:absolute;left:4px;top:8px;z-index:5;
  width:32px;height:32px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:var(--paper-card);border:1px solid var(--border-default);
  box-shadow:var(--shadow-card);color:var(--ink-2);
  font-size:18px;line-height:1;
}
.dw-stage{
  flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:center;padding-top:6vh;
}

/* 组① 信封 */
.dw-env{position:relative;width:256px;height:176px;transform:rotate(-.8deg);perspective:600px;}
.dw-env-body{
  position:absolute;left:0;top:0;right:0;bottom:0;
  background:var(--paper-card);border:1px solid rgba(0,0,0,0.06);border-radius:10px;
  box-shadow:var(--shadow-card);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
}
.dw-env-char{
  position:absolute;left:0;right:0;top:44px;z-index:3;
  text-align:center;margin:0;
  font-family:var(--font-serif);font-weight:600;
  font-size:40px;line-height:1;color:var(--ink-1);
}
.dw-env-meta{
  position:absolute;bottom:14px;left:0;right:0;text-align:center;
  font-family:var(--font-mono);font-size:11px;letter-spacing:1px;color:var(--ink-3);
}
.dw-env-flap{
  position:absolute;left:-1px;top:-1px;right:-1px;height:112px;
  background:var(--orange-200);border-radius:10px 10px 0 0;
  clip-path:polygon(0 0,100% 0,50% 100%);
  transform-origin:top center;z-index:2;
  transition:transform .5s cubic-bezier(.3,.7,.3,1);
}
.dw.opening .dw-env-flap{transform:rotateX(-160deg);}
.dw-seal{
  position:absolute;left:50%;top:88px;margin-left:-22px;z-index:4;
  width:44px;height:44px;border-radius:50%;background:var(--brand);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 6px rgba(255,107,53,0.28),
    inset 0 3px 5px rgba(255,255,255,.35),
    inset 0 -4px 7px rgba(0,0,0,.16);
  transition:opacity var(--duration-fast),transform var(--duration-fast);
}
.dw.opening .dw-seal{opacity:0;transform:scale(.6);}
.dw-seal-mark{font-size:15px;color:var(--brand-tint);line-height:1;}
.dw.opening .dw-env-body{animation:dw-env-rise .5s ease .45s forwards;}
@keyframes dw-env-rise{to{transform:translateY(6px);}}

/* 组① 卡面 */
.dw-cardwrap{animation:dw-card-in .5s ease both;}
@keyframes dw-card-in{from{opacity:0;transform:translateY(20px) scale(.92);}
  to{opacity:1;transform:none;}}
.dw-flip{width:196px;height:272px;perspective:900px;}
.dw-flip-inner{
  position:relative;width:100%;height:100%;transform-style:preserve-3d;
  transition:transform .55s cubic-bezier(.25,.7,.3,1);
}
.dw-flip-inner.is-flipped{transform:rotateY(180deg);}
.dw-face{
  position:absolute;left:0;top:0;right:0;bottom:0;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  background:var(--paper-card);border:1px solid rgba(0,0,0,0.06);border-radius:12px;
  box-shadow:var(--shadow-card);overflow:hidden;
  display:flex;flex-direction:column;align-items:center;
}
.dw-backface{transform:rotateY(180deg);}
.dw-bar{position:absolute;left:0;top:0;right:0;height:4px;}
.dw-word{
  margin:auto 0;padding:0 14px;text-align:center;
  font-family:var(--font-serif);font-weight:700;line-height:1.35;color:var(--ink-1);
}
.dw-word.l4{font-size:30px}
.dw-word.l5{font-size:24px}
.dw-word.l7{font-size:18px}
.dw-serial{
  margin-bottom:16px;font-family:var(--font-mono);font-size:11px;
  letter-spacing:1px;color:var(--ink-3);
}
.dw-bk-no{
  margin-top:18px;font-family:var(--font-mono);font-size:11px;
  letter-spacing:1px;color:var(--ink-3);
}
.dw-bk-note{
  margin-top:14px;padding:0 20px;text-align:center;
  font-family:var(--font-serif);font-size:14px;line-height:1.7;color:var(--ink-1);
  display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;
}
.dw-bk-imgwrap{
  margin-top:12px;width:132px;height:96px;border-radius:8px;
  overflow:hidden;border:1px solid rgba(0,0,0,0.06);
}
.dw-bk-img{width:100%;height:100%;display:block;}
.dw-bk-empty{
  margin-top:12px;padding:0 18px;text-align:center;
  display:flex;flex-direction:column;align-items:center;
}
.dw-bk-explain{
  font-family:var(--font-serif);font-size:13px;line-height:1.7;color:var(--ink-2);
  display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;
}
.dw-bk-empty-hint{
  margin-top:10px;font-family:var(--font-serif);font-size:12px;color:var(--ink-4);
}
.dw-bk-date{
  margin-top:auto;margin-bottom:10px;transform:rotate(-4deg);
  border:1.5px solid var(--ink-1);border-radius:3px;padding:3px 8px;opacity:.85;
  font-family:var(--font-mono);font-size:10px;font-weight:700;
  letter-spacing:.5px;color:var(--ink-1);
}
.dw-bk-date.stamp-anim{animation:dw-stamp .62s cubic-bezier(.2,1.4,.4,1) both;}
@keyframes dw-stamp{0%{transform:rotate(-4deg) scale(1.7);opacity:0;}
  55%{opacity:1;}100%{transform:rotate(-4deg) scale(1);opacity:.85;}}
.dw-bk-count{
  margin-bottom:16px;font-family:var(--font-mono);font-size:10px;
  letter-spacing:1px;color:var(--ink-3);
}

/* 组② 提示 */
.dw-hint{
  margin-top:30px;min-height:16px;text-align:center;
  font-family:var(--font-mono);font-size:12px;letter-spacing:1px;color:var(--ink-3);
}

/* 组③ 动作 */
.dw-actions{margin-top:22px;display:flex;flex-direction:column;align-items:center;}
.dw-btn{
  min-width:214px;height:52px;padding:0 32px;margin:0;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.dw-btn::after{border:none;}
.dw-btn.brand{background:var(--gradient-brand);color:#FFFFFF;box-shadow:var(--shadow-cta);}
.dw-btn.gold{background:var(--gold-mid);color:#FFFFFF;box-shadow:0 4px 14px rgba(217,162,39,.35);}
.dw-btn.ghost{
  background:transparent;color:var(--ink-2);height:40px;
  font-size:13px;font-weight:400;min-width:150px;border:1px solid var(--hairline);
}
.dw-btn + .dw-btn{margin-top:10px;}
.dw-btn-press{transform:translateY(1px);opacity:.92;}

/* ══════ V2.9 · 抽空页：金色时刻 ══════ */
.dp{
  position:fixed;left:0;top:0;right:0;bottom:0;z-index:85;
  background:var(--paper-deep);
  display:flex;align-items:center;justify-content:center;
  animation:dp-fade .4s ease both;
}
@keyframes dp-fade{from{opacity:0;}to{opacity:1;}}
.dp-inner{
  display:flex;flex-direction:column;align-items:center;
  padding:0 32px calc(24px + env(safe-area-inset-bottom));
}
.dp-eyebrow{
  font-family:var(--font-mono);font-size:11px;
  letter-spacing:3px;color:var(--ink-3);
}
.dp-title{
  margin-top:14px;font-family:var(--font-serif);font-weight:700;
  font-size:34px;color:var(--ink-1);animation:dp-rise .5s ease .1s both;
}
.dp-setname{
  margin-top:10px;font-family:var(--font-serif);font-size:16px;
  color:var(--ink-2);animation:dp-rise .5s ease .18s both;
}
.dp-goldline{
  margin-top:18px;width:40px;height:2px;
  background:linear-gradient(90deg,var(--gold-light),var(--gold-mid),var(--gold-deep));
  animation:dp-rise .5s ease .24s both;
}
@keyframes dp-rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
.dp-dots{margin-top:26px;display:flex;flex-wrap:wrap;justify-content:center;max-width:240px;}
.dp-dot{
  width:8px;height:8px;margin:7px;border-radius:50%;
  border:1.5px solid var(--ink-4);box-sizing:border-box;
}
.dp-dot.on{
  border-color:var(--ink-1);background:var(--ink-1);
  animation:dp-dot-in .32s ease both;
}
@keyframes dp-dot-in{from{transform:scale(.2);opacity:0;}to{transform:scale(1);opacity:1;}}
.dp-note{
  margin-top:20px;font-family:var(--font-mono);font-size:12px;
  letter-spacing:1px;color:var(--ink-3);
}
.dp-actions{
  margin-top:34px;display:flex;flex-direction:column;align-items:center;
  opacity:0;transform:translateY(12px);pointer-events:none;
  transition:opacity .35s ease,transform .35s ease;
}
.dp-actions.show{opacity:1;transform:none;pointer-events:auto;}
.dp-btn{
  min-width:214px;height:52px;padding:0 32px;margin:0;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:600;letter-spacing:1px;line-height:1;
  font-family:inherit;
}
.dp-btn::after{border:none;}
.dp-btn.gold{background:var(--gold-mid);color:#FFFFFF;box-shadow:0 4px 14px rgba(217,162,39,.35);}
.dp-btn.ghost{
  background:transparent;color:var(--ink-2);height:40px;
  font-size:13px;font-weight:400;min-width:150px;border:1px solid var(--hairline);
}
.dp-btn + .dp-btn{margin-top:10px;}
.dp-btn-press{transform:translateY(1px);opacity:.92;}

/* ══════ V3.0 · 订阅页 / 我的收藏册 ══════ */
#page-cards{padding:var(--navtop, 0px) 0 90px;background:var(--paper-page)}
#page-me{padding:var(--navtop, 0px) var(--space-4) 90px;background:var(--paper-page)}











.sb-cover.gold{border-color:var(--gold-mid);box-shadow:0 2px 8px rgba(217,162,39,.18)}





.sb-status.wait{color:var(--orange-500)}
.sb-status.ready{color:var(--orange-500);font-weight:600}
.sb-status.quiet{font-family:var(--font-mono);font-size:11px;letter-spacing:.5px;color:var(--ink-4)}
.sb-status.gold{color:var(--gold-deep);font-weight:600}




.sb-empty{margin-top:16vh;display:flex;flex-direction:column;align-items:center;text-align:center}
.sb-empty-title{font-family:var(--font-serif);font-size:17px;color:var(--ink-2)}
.sb-empty-sub{margin-top:10px;font-family:var(--font-mono);font-size:12px;letter-spacing:1px;color:var(--ink-4)}
.sb-btn{
  margin-top:28px;min-width:160px;height:44px;padding:0 28px;
  border-radius:999px;border:none;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;font-weight:600;letter-spacing:1px;line-height:1;
}
.sb-btn::after{border:none}
.sb-btn.ghost{background:transparent;color:var(--ink-2);border:1px solid var(--hairline)}
.sb-btn-press{transform:translateY(1px);opacity:.85}





























/* 首页整页滚动：页头随内容一起上移，把高度让给卡集列表 */
#page-home .page-head{position:static;top:auto}

/* ═══ 首页 v2.2 · 整页滚动 + 我的订阅前置 + 分类体系 ═══
   字体策略：mono 只用于纯数字；serif 只用于品牌/集名/封面字（子集已有）；
   其余一律不声明 font-family（继承系统字体）——新文案未进子集也不方框；
   ✦ 与 › 用 CSS clip-path/border 绘制，不依赖字体。 */

/* 页首 */
.hm-head{padding:28px 24px 0}





.hm-press{opacity:.7}

/* CSS 四角星（替代 ✦ 字符，任何字体环境都渲染） */

.hm-star.sm{width:9px;height:9px;margin-right:6px}

/* 分类 chips（sticky 吸顶 + 浮起投影） */






.hm-chip.on{background:var(--ink-1);border-color:var(--ink-1);
  color:var(--paper-card);font-weight:600}

/* 栏目卡（刊首语 · 暂系统字体，子集补字后换宋体） */





/* 列表容器：保持原 16px 边距下的 book-card 形态 */

.hm-listwrap .list-head{padding-top:8px}

/* CSS chevron（替代 › 字符） */



/* 筛选空态 */
.hm-empty{padding:64px 24px 20px;display:flex;flex-direction:column;
  align-items:center;text-align:center}
.hm-empty-text{font-size:15px;line-height:1.75;color:var(--ink-2);max-width:260px}
.hm-empty-btn{margin-top:24px;min-width:150px;height:40px;padding:0 26px;
  border-radius:999px;border:1px solid var(--hairline);background:transparent;
  font-size:13px;color:var(--ink-2);line-height:40px;letter-spacing:1px}
.hm-empty-btn::after{border:none}

/* 页脚 */



/* ── 宋体子集补字完成后，解开这一段，新增文案统一换宋体 ──
.hm-col-title,.hm-col-sub,.hm-empty-text{font-family:var(--font-serif)}
.hm-row-meta{font-family:var(--font-mono)}
*/

/* ═══ 字体统一 · 黑体校正（v3）═══
   界面文字全部归一 --font-sans；层级只由 字号/字重/颜色 三轴表达 */
/* T2 页面标题 24px/700 */

/* T5 正文：字距归零、行高收敛、中灰 */
.explain,.sp-pick-note,.final-quote{letter-spacing:0;line-height:1.75;color:var(--ink-2)}
.explain,.sp-pick-note{font-size:15px}
.dw-bk-explain{letter-spacing:0;line-height:1.7;font-size:14px}
/* T6 手写便签：黑体 + 保留疏朗行距 */
.pc-note-strip,.pc-note .t-span{letter-spacing:0;line-height:2}
/* T1 卡面主词：黑体加粗 + 大字气口 */
.bigword,.lit .bigword{font-weight:700;letter-spacing:2px;line-height:1.2}
.dw-word{letter-spacing:1px}
/* 数字等宽对齐 */
.today,.stat .t-b,.dw-serial,.sp-tail-note,.dw-bk-no,.dw-bk-count,.dw-bk-date,.dp-note,.dp-eyebrow,.dw-env-meta,.dw-hint,.sp-pick-meta{font-variant-numeric:tabular-nums}

/* ═══ 订阅页 v2 · 行动提醒卡 + 统计 + 三组卡片 ═══ */
#page-cards{padding:var(--navtop,0px) var(--space-4) 90px;background:var(--paper-page)}
.sb2-page .brand-row{padding:var(--space-1) 0 var(--space-3)}
.sb2-body{padding:0 2px}

/* 行动提醒卡 */
.sb2-remind{
  position:relative;overflow:hidden;margin-top:16px;
  background:linear-gradient(135deg,var(--brand-tint),#FFF8F3);
  border-radius:16px;padding:18px 14px;
  display:flex;align-items:center;
}
.sb2-remind-deco{position:absolute;right:-26px;top:-26px;width:104px;height:104px;
  border-radius:50%;background:rgba(255,107,53,.07)}
.sb2-remind-ico{width:52px;height:52px;border-radius:50%;background:var(--brand);
  display:flex;align-items:center;justify-content:center;font-size:24px;flex:none;
  box-shadow:0 4px 12px rgba(255,107,53,.22)}
.sb2-remind.soft .sb2-remind-ico{background:var(--orange-300);
  box-shadow:0 4px 12px rgba(255,107,53,.12)}
.sb2-remind-mid{flex:1;min-width:0;margin-left:14px}
.sb2-remind-title{font-size:17px;font-weight:700;color:var(--ink-1);line-height:1.3}
.sb2-remind-sub{margin-top:7px;font-size:12px;color:var(--ink-3);
  display:flex;align-items:center}
.sb2-arrow{width:6px;height:6px;flex:none;margin-left:4px;
  border-top:1.5px solid var(--ink-3);border-right:1.5px solid var(--ink-3);
  transform:rotate(45deg)}
.sb2-remind-go{flex:none;margin-left:8px;width:26px;height:26px;
  display:flex;align-items:center;justify-content:center}
.sb2-press{opacity:.85;transform:translateY(1px)}
/* ═══ 本周目标卡（周目标进度 · 留存体系 V1） ═══ */
.sb2-week-goal{background:var(--paper-card);border:1px solid var(--hairline);
  border-radius:16px;padding:18px 16px 15px;margin-bottom:14px;box-shadow:var(--shadow-card)}
.sb2-week-goal.full{border-color:var(--gold-mid);
  box-shadow:0 4px 16px rgba(217,162,39,.16)}
.swg-head{display:flex;align-items:baseline;justify-content:space-between}
.swg-title{font-size:16px;font-weight:700;color:var(--ink-1)}
.sb2-week-goal.full .swg-title{color:var(--gold-deep)}
.swg-count{font-size:13px;color:var(--ink-3);font-variant-numeric:tabular-nums}
.swg-dots{display:flex;justify-content:space-between;margin-top:14px;padding:0 2px}
.swg-dot{display:flex;flex-direction:column;align-items:center;gap:7px;flex:1}
.swg-dot::before{content:'';width:10px;height:10px;border-radius:50%;
  background:var(--paper-deep);border:1px solid var(--hairline);box-sizing:border-box}
.swg-dot.on::before{background:var(--orange-500);border-color:var(--orange-500);
  box-shadow:0 2px 6px rgba(255,107,53,.3)}
.swg-dot.miss::before{background:transparent}
.swg-dot.today::before{border:1.5px solid var(--orange-500);background:var(--orange-100)}
.swg-dot.on.today::before{background:var(--orange-500)}
.swg-dot.future::before{opacity:.45}
.swg-dot-l{font-size:10px;color:var(--ink-4);line-height:1}
.swg-dot.today .swg-dot-l{color:var(--orange-500);font-weight:600}
.swg-sub{margin-top:12px;font-size:12px;color:var(--ink-3)}
.sb2-week-goal.full .swg-sub{color:var(--gold-deep)}
/* ═══ 久别问候卡（回流承接 V1） ═══ */
.sb2-greet{background:var(--paper-card);border:1px dashed var(--orange-300);
  border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:var(--shadow-card)}
.sb2-greet-head{display:flex;align-items:center;justify-content:space-between}
.sb2-greet-title{font-size:16px;font-weight:700;color:var(--ink-1)}
.sb2-greet-days{font-size:11px;color:var(--orange-600);background:var(--orange-50);
  border-radius:999px;padding:3px 10px;font-variant-numeric:tabular-nums}
.sb2-greet-sub{margin-top:8px;font-size:13px;line-height:1.6;color:var(--ink-2)}
.sb2-greet-cta{margin-top:10px;font-size:12px;font-weight:600;color:var(--orange-600)}

/* 三格统计 */
.sb2-stats{display:flex;gap:12px;margin-top:16px}
.sb2-stat{flex:1;background:var(--paper-card);border:1px solid var(--hairline);
  border-radius:14px;padding:20px 6px 16px;text-align:center;box-shadow:var(--shadow-card)}
.sb2-stat-n{font-size:28px;font-weight:700;color:var(--ink-1);line-height:1;
  font-variant-numeric:tabular-nums}
.sb2-stat-n.orange{color:var(--orange-500)}
.sb2-stat-l{display:block;margin-top:9px;font-size:11px;letter-spacing:1px;color:var(--ink-3)}

/* 分组头 */
.sb2-group-head{display:flex;align-items:center;justify-content:space-between;
  margin:30px 2px 12px}
.sb2-group-title{display:flex;align-items:center;font-size:17px;font-weight:700;color:var(--ink-1)}
.sb2-gdot{width:8px;height:8px;border-radius:50%;background:var(--orange-500);margin-right:8px}
.sb2-gdot.gray{background:var(--ink-4)}
.sb2-gdot.gold{background:var(--gold-mid)}
.sb2-badge{min-width:26px;height:26px;padding:0 9px;border-radius:999px;
  background:var(--surface-muted);display:flex;align-items:center;justify-content:center;
  font-size:12px;color:var(--ink-3);font-variant-numeric:tabular-nums}

/* 卡集行卡片 */
.sb2-card{display:flex;align-items:center;background:var(--paper-card);
  border:1px solid var(--hairline);border-radius:16px;padding:16px 14px;
  margin-bottom:12px;box-shadow:var(--shadow-card)}
.sb2-card-press{transform:translateY(1px);opacity:.85}
.sb2-sign{width:44px;height:60px;flex:none;background:var(--paper-card);
  border:1px solid var(--orange-200);border-radius:6px;box-shadow:var(--shadow-card);
  display:flex;flex-direction:column;align-items:center;justify-content:center}
.sb2-sign.gold{border-color:var(--gold-mid);box-shadow:0 2px 8px rgba(217,162,39,.18)}
.sb2-char{font-size:13px;font-weight:600;line-height:1.3;color:var(--ink-1)}
.sb2-mid{flex:1;min-width:0;margin-left:14px}
.sb2-name{font-size:16px;font-weight:600;color:var(--ink-1);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sb2-status{margin-top:7px;display:flex;align-items:center;font-size:12px;
  font-weight:400;color:var(--ink-3)}
.sb2-sdot{width:5px;height:5px;border-radius:50%;background:var(--gray-300);
  margin-right:5px;flex-shrink:0}
.sb2-status.go .sb2-sdot{background:var(--success)}
.sb2-status.wait .sb2-sdot{background:var(--sky-500)}
.sb2-status.quiet .sb2-sdot{background:var(--gray-300)}
.sb2-status.gold .sb2-sdot{background:var(--gray-300)}
.sb2-prog{color:var(--ink-3);font-weight:400;font-variant-numeric:tabular-nums}
.sb2-right{flex:none;margin-left:10px;display:flex;align-items:center}
.sb2-todo{width:8px;height:8px;border-radius:50%;background:var(--orange-500);
  border:2px solid var(--surface-card);margin-right:7px;
  box-shadow:0 1px 3px rgba(255,107,53,0.40);animation:sb2Pulse 2s ease-in-out infinite}
@keyframes sb2Pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}
.sb2-go{width:30px;height:30px;border-radius:50%;background:var(--surface-hover);
  display:flex;align-items:center;justify-content:center}
.sb2-go.sm{width:26px;height:26px}
.sb2-chev{width:7px;height:7px;border-top:1.5px solid var(--orange-500);
  border-right:1.5px solid var(--orange-500);transform:rotate(45deg);margin-left:-2px}

/* 周记入口 / 页脚 */
.sb2-weekly{margin-top:34px;padding:15px 14px;border-radius:14px;
  border:1px dashed var(--hairline);
  display:flex;align-items:center;justify-content:space-between}
.sb2-weekly-t{font-size:13px;color:var(--ink-2)}
.sb2-foot{margin-top:44px;text-align:center;font-size:11px;letter-spacing:1px;color:var(--ink-4)}

/* ═══ 详情页 v2 · set-hero（原型 V2.3c 同步）═══ */
.set-hero{text-align:center;padding:var(--space-3) 0 var(--space-5);position:relative}
.set-hero .cover-lg{
  width:160px;height:214px;border-radius:var(--radius-md);
  margin:0 auto var(--space-4);
  display:flex;align-items:center;justify-content:center;gap:8px;
  border:1px solid var(--orange-200);background:var(--surface-card);
  box-shadow:var(--shadow-md);overflow:hidden;position:relative;
}
.set-hero .cover-lg .cov-main{
  writing-mode:vertical-rl;font-size:14px;color:var(--text-primary);
  letter-spacing:2px;font-weight:var(--weight-medium);
}
.set-hero .cover-lg .cov-sub{
  writing-mode:vertical-rl;font-size:11px;color:var(--text-secondary);
  letter-spacing:1px;
}
.cover-price-lg{position:absolute;top:10px;right:10px;
  background:var(--gradient-brand);color:var(--text-inverse);
  font-size:var(--text-sm);font-weight:var(--weight-bold);
  padding:3px 8px;border-radius:var(--radius-sm);letter-spacing:0.5px;z-index:2}
.cover-trial-lg{position:absolute;bottom:10px;left:10px;
  background:rgba(0,0,0,0.6);color:var(--text-inverse);
  font-size:var(--text-xs);font-weight:var(--weight-medium);
  padding:3px 8px;border-radius:var(--radius-sm);letter-spacing:0.5px;z-index:2}
.spv2-h1{font-size:var(--text-4xl);font-weight:var(--weight-bold);
  letter-spacing:0.5px;color:var(--text-primary);
  line-height:1.25;margin-bottom:var(--space-2)}
.set-meta{font-size:var(--text-md);color:var(--text-tertiary);letter-spacing:0.5px;
  margin-bottom:var(--space-2);display:flex;align-items:center;
  justify-content:center;gap:var(--space-2);flex-wrap:wrap}
.dot-sep{width:3px;height:3px;border-radius:50%;background:var(--gray-300);flex:none}
.set-heat{display:inline-flex;align-items:center;gap:4px;
  font-size:var(--text-sm);color:var(--orange-500);
  font-weight:var(--weight-medium);letter-spacing:0.5px}
.set-heat-ico{width:14px;height:14px}
.spv2-chip{display:inline-flex;align-items:center;gap:3px;margin-top:var(--space-2);
  padding:4px 12px;border-radius:999px;background:var(--gold-50);
  color:var(--gold-600);font-size:var(--text-sm);
  font-weight:var(--weight-semibold);letter-spacing:0.5px}
.trial-progress{display:flex;align-items:center;gap:var(--space-3);
  margin:0 0 var(--space-3)}
.trial-progress .stamp-track{flex:1;height:4px;background:var(--gray-100);
  border-radius:var(--radius-full);overflow:hidden}
.trial-progress .stamp-track .t-i{display:block;height:100%;
  border-radius:var(--radius-full);
  background:linear-gradient(90deg,var(--sky-200),var(--sky-400))}

/* 详情页规则行（原型 rules-list li 的 view 适配） */
.rules-list .t-li{display:flex;align-items:flex-start;gap:var(--space-3);
  padding:var(--space-3) 0;border-bottom:1px solid var(--border-default);
  font-size:var(--text-md);color:var(--text-secondary);letter-spacing:0.5px;line-height:1.6}
.rules-list .t-li:last-child{border-bottom:none}



/* ═══ 首页 v3 · 三宫格（原型 quick-row 同步）═══ */

.hm-quick .quick-card{flex:none;width:140px;height:96px;border-radius:14px}





.quick-card.highlight .qc-label{color:#FFFFFF}
.quick-card.highlight .qc-sub{color:rgba(255,255,255,.85)}
.hm-qtxt .qc-label{font-size:15px;font-weight:700;color:var(--ink-1);line-height:1.3}
.hm-qtxt .qc-sub{margin-top:3px;font-size:11px;color:var(--ink-3);letter-spacing:0.5px}
.quick-card.highlight .hm-qtxt .qc-label,
.quick-card.highlight .hm-qtxt .qc-sub{color:#FFFFFF}

/* 新建卡片：一盒卡片卡通图（CSS 绘制） */


.hm-box-card.a{transform:translateX(-50%) translateX(-11px) rotate(-9deg)}
.hm-box-card.b{transform:translateX(-50%) translateX(11px) rotate(9deg);border-color:var(--orange-200)}



/* ═══ 维度宫格（2×3，微信读书式）═══ */


.hm-dim.on{border-color:var(--orange-500)}
.hm-dim.on::after{content:'';position:absolute;top:10px;right:10px;width:7px;height:7px;
  border-radius:50%;background:var(--orange-500)}



/* CSS 线条小图形 */










/* ═══ TA们喜欢 · 横滑回信卡片流 ═══ */
















/* ═══ 列表头（维度 / 分类 / 默认）═══ */







/* ═══ 分类面板（半屏 sheet）═══ */

.hm-sheet-mask.show{opacity:1;pointer-events:auto}

.hm-sheet.show{transform:translateY(0)}



.hm-chip2.on{background:var(--gradient-brand);border-color:transparent;
  color:#FFFFFF;font-weight:600}

/* 首页卡集：标签行（热门/价格 + 心动数） */
.bc-tagrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:var(--space-2)}
.bc-tagrow .bc-status-tag{margin-top:0}
.bc-like{display:inline-flex;align-items:center;gap:3px;height:22px;padding:0 8px;
  border-radius:999px;background:var(--orange-50);color:var(--ink-3);
  font-size:11px;line-height:1;letter-spacing:.3px;font-variant-numeric:tabular-nums}
.bc-like.on{color:var(--orange-600)}
.bc-heart{font-size:13px;line-height:1;color:var(--orange-400)}
.bc-like.on .bc-heart{color:var(--orange-500)}

/* ═══ 卡集公开互动：心动 + 留言 ═══ */
.sp-social{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}
.sp-like{display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;
  border:1px solid var(--hairline);border-radius:999px;background:var(--surface-card);
  transition:background .18s ease,border-color .18s ease,transform .12s ease}
.sp-like.on{background:var(--orange-50);border-color:var(--orange-200)}
.sp-like.on .sp-heart{color:var(--orange-500)}
.sp-heart{font-size:21px;line-height:1;color:var(--orange-400);
  display:inline-block;transform-origin:50% 55%}
.sp-like-n{font-size:14px;font-weight:600;color:var(--ink-2);
  font-variant-numeric:tabular-nums}
.sp-like-l{font-size:12px;color:var(--ink-3);letter-spacing:.5px}
.sp-like.pop .sp-heart{animation:spHeartPop .32s var(--ease-bounce) both}
@keyframes spHeartPop{
  0%{transform:scale(1)}
  38%{transform:scale(1.38)}
  70%{transform:scale(.94)}
  100%{transform:scale(1)}
}
.sp-social-press{opacity:.68}
.sp-comment{display:flex;align-items:center;gap:6px;height:38px;padding:0 4px 0 12px;
  font-size:13px;color:var(--ink-2);letter-spacing:.2px}
.sp-comment-t{font-size:13px;color:var(--ink-2)}
.sp-chev{width:6px;height:6px;flex:none;margin-top:-1px;
  border-top:1.5px solid var(--ink-4);border-right:1.5px solid var(--ink-4);
  transform:rotate(45deg)}

/* ═══ 签友留言半屏 ═══ */
#commentsModal{z-index:130}
.comments-sheet{height:auto;max-height:74vh;display:flex;flex-direction:column;overflow:hidden;
  padding-bottom:calc(16px + env(safe-area-inset-bottom))}
.cs-head{display:flex;align-items:flex-start;justify-content:space-between;flex:none;
  padding-right:40px}
.cs-kicker{font-size:10px;letter-spacing:3px;color:var(--ink-4)}
.cs-title{margin-top:6px;font-family:var(--font-serif);font-size:18px;font-weight:600;
  color:var(--ink-1);letter-spacing:.5px;line-height:1.4;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:240px}
.cs-close{position:absolute;top:14px;right:16px;z-index:2}
.cs-scroll{flex:1;min-height:0;max-height:52vh;margin-top:16px}
.cs-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--hairline)}
.cs-item:first-child{padding-top:4px}
.cs-avatar{flex:none;width:34px;height:34px;border-radius:50%;
  background:var(--orange-50);color:var(--orange-600);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-serif);font-size:14px;font-weight:600}
.cs-main{flex:1;min-width:0}
.cs-meta{display:flex;align-items:center;gap:7px}
.cs-name{font-size:13px;font-weight:600;color:var(--ink-1)}
.cs-badge{font-size:9px;line-height:1;padding:3px 6px;border-radius:999px;
  background:var(--orange-50);color:var(--orange-600);letter-spacing:.5px}
.cs-time{margin-left:auto;font-size:11px;color:var(--ink-4);letter-spacing:.3px}
.cs-text{margin-top:6px;font-size:15px;line-height:1.72;color:var(--ink-2);
  word-break:break-word}
.cs-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:220px;text-align:center;padding:24px 0}
.cs-empty-stamp{width:48px;height:48px;border-radius:50%;border:1.5px dashed var(--orange-300);
  color:var(--orange-500);font-family:var(--font-serif);font-size:17px;
  display:flex;align-items:center;justify-content:center;transform:rotate(-8deg)}
.cs-empty-t{margin-top:14px;font-size:15px;font-weight:600;color:var(--ink-2)}
.cs-empty-s{margin-top:6px;font-size:12px;color:var(--ink-4);letter-spacing:.5px}
.cs-compose{flex:none;padding-top:12px;border-top:1px solid var(--hairline)}
.cs-textarea{width:100%;min-height:44px;max-height:96px;padding:10px 12px;
  box-sizing:border-box;border-radius:12px;background:var(--surface-muted);
  font-size:15px;line-height:1.6;color:var(--ink-1)}
.cs-compose-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.cs-counter{font-size:11px;color:var(--ink-4);font-variant-numeric:tabular-nums}
.cs-send{height:34px;line-height:34px;padding:0 20px;border-radius:999px;
  background:var(--orange-500);color:#FFF;font-size:13px;font-weight:600;
  letter-spacing:.5px;opacity:.4;transition:opacity .16s ease}
.cs-send.on{opacity:1}
.cs-send::after{border:none}
.cs-locked{flex:none;padding:14px 0 4px;border-top:1px solid var(--hairline);
  display:flex;align-items:center;justify-content:space-between;gap:12px}
.cs-lock-t{flex:1;font-size:13px;line-height:1.6;color:var(--ink-3)}
.cs-lock-btn{flex:none;height:36px;line-height:36px;padding:0 16px;border-radius:999px;
  background:var(--orange-50);color:var(--orange-600);font-size:12px;font-weight:600;
  border:1px solid var(--orange-200)}
.cs-lock-btn::after{border:none}

/* ═══ 卡集分享 / 分享落地 ═══ */
.subhead .share-btn{margin-left:auto;height:28px;line-height:26px;padding:0 12px;
  border-radius:999px;border:1px solid var(--orange-200);background:var(--orange-50);
  color:var(--orange-600);font-size:12px;font-weight:600;letter-spacing:.5px}
.subhead .share-btn::after{border:none}
.share-hint{display:flex;align-items:center;gap:8px;margin:2px 0 14px;
  padding:8px 12px;border-radius:12px;background:var(--orange-50);
  color:var(--orange-600);font-size:12px;letter-spacing:.5px}
.share-hint::before{content:'';width:6px;height:6px;border-radius:50%;
  background:var(--orange-500);flex:none}

/* ═══ 卡集封面（3:4 图片 / 编辑器上传） ═══ */
.cover-img,.cover-lg-img{position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;display:block;z-index:0}
.cover-edit{display:flex;align-items:flex-start;gap:14px}
.cover-edit-box{position:relative;width:96px;height:128px;flex:none;overflow:hidden;
  border:1.5px dashed var(--orange-200);border-radius:10px;
  background:linear-gradient(180deg,#FFFFFF,var(--orange-50));
  display:flex;align-items:center;justify-content:center;
  transition:border-color .15s ease,background .15s ease}
.cover-edit-box.has{border-style:solid;border-color:var(--border-default);background:var(--surface-muted)}
.cover-edit-box:active{transform:scale(.99)}
.cover-edit-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cover-edit-empty{display:flex;flex-direction:column;align-items:center;gap:6px;
  color:var(--text-tertiary);font-size:11px;letter-spacing:1px}
.cover-edit-plus{font-size:24px;line-height:1;color:var(--orange-400);font-weight:300}
.cover-edit-side{flex:1;min-width:0}
.cover-edit-tip{font-size:13px;font-weight:600;color:var(--ink-1);letter-spacing:.3px}
.cover-edit-sub{margin-top:6px;font-size:11px;line-height:1.65;color:var(--text-tertiary)}
.cover-edit-actions{display:flex;align-items:center;gap:12px;margin-top:12px}
.cover-edit-del{font-size:12px;color:var(--text-tertiary);letter-spacing:.5px;padding:6px 2px}
.cover-edit-del::after{border:none}

/* ═══ 抽卡回响：心动 + 留一句 ═══ */
.dw-echo{display:flex;align-items:center;justify-content:center;gap:12px;
  margin-top:14px;flex-wrap:wrap}
.dw-echo-like{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;
  border-radius:999px;border:1px solid var(--hairline);background:var(--paper-card);
  color:var(--ink-2);font-size:12px;letter-spacing:.3px;
  transition:background .16s ease,border-color .16s ease}
.dw-echo-like.on{background:var(--orange-50);border-color:var(--orange-200);color:var(--orange-600)}
.dw-echo-heart{font-size:17px;line-height:1;color:var(--orange-400);display:inline-block;
  transform-origin:50% 55%}
.dw-echo-like.on .dw-echo-heart{color:var(--orange-500)}
.dw-echo-like.pop .dw-echo-heart{animation:spHeartPop .32s var(--ease-bounce) both}
.dw-echo-n{font-weight:600;font-variant-numeric:tabular-nums}
.dw-echo-l{font-size:11px;color:var(--ink-3)}
.dw-echo-comment{display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 8px;
  color:var(--ink-2);font-size:12px;letter-spacing:.3px}
.dw-echo-pen{font-size:14px;line-height:1;color:var(--orange-400)}
.dw-echo-press{opacity:.65}

/* ═══ 怎么玩：我的页摘要 + 详情页一行 + 完整规则半屏 ═══ */
.rules-entry{background:var(--surface-card);border:1px solid var(--hairline);
  border-radius:14px;padding:14px 16px;margin-bottom:12px}
.rules-entry-head{display:flex;align-items:center;justify-content:space-between;
  margin-bottom:8px}
.rules-entry-head .t-b{font-size:15px;font-weight:600;color:var(--ink-1);letter-spacing:.5px}
.rules-entry-more{font-size:11px;color:var(--orange-600);letter-spacing:.5px}
.rules-entry-go{margin-left:2px}
.rules-entry-line{position:relative;padding-left:12px;font-size:12px;line-height:1.9;
  color:var(--ink-2);letter-spacing:.2px}
.rules-entry-line::before{content:'';position:absolute;left:2px;top:.85em;
  width:3px;height:3px;border-radius:50%;background:var(--orange-300)}
.rules-entry-line.muted{color:var(--ink-3)}
.rules-entry-press{opacity:.8}

.rule-brief{display:flex;align-items:center;justify-content:space-between;gap:12px;
  margin:0 0 12px;padding:12px 14px;border:1px solid var(--hairline);
  border-radius:12px;background:var(--surface-card)}
.rule-brief-main{flex:1;min-width:0;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.rule-brief-k{flex:none;font-size:12px;font-weight:600;color:var(--orange-600);letter-spacing:.5px}
.rule-brief-t{font-size:12px;color:var(--ink-2);line-height:1.6}
.rule-brief-more{flex:none;font-size:11px;color:var(--ink-3);letter-spacing:.3px}
.rule-brief-press{opacity:.75}

.rules-sheet{max-height:82vh;overflow-y:auto;
  padding-bottom:calc(24px + env(safe-area-inset-bottom))}
.rules-close{position:absolute;top:14px;right:16px;z-index:2}
.rules-kicker{font-size:10px;letter-spacing:3px;color:var(--ink-4)}
/* ═══ 每日提醒设置弹层（订阅消息 V1） ═══ */
.remind-desc{margin-top:10px;font-size:13px;line-height:1.7;color:var(--ink-2)}
.remind-time{display:flex;align-items:center;justify-content:space-between;
  margin-top:12px;padding:14px;border:1px solid var(--hairline);
  border-radius:12px;background:var(--paper-card)}
.remind-time.on{border-color:var(--orange-500);background:var(--orange-50)}
.remind-time-t{font-size:15px;font-weight:600;color:var(--ink-1)}
.remind-time-s{display:block;margin-top:4px;font-size:11px;color:var(--ink-3)}
.remind-radio{width:18px;height:18px;flex:none;border-radius:50%;
  border:1.5px solid var(--hairline);box-sizing:border-box}
.remind-time.on .remind-radio{border-color:var(--orange-500);
  background:var(--orange-500);box-shadow:inset 0 0 0 3px var(--paper-card)}
.remind-btn{width:100%;margin-top:18px}
.rules-title{margin-top:6px;font-family:var(--font-serif);font-size:22px;
  font-weight:600;color:var(--ink-1);letter-spacing:1px}
.rules-block{margin-top:18px}
.rules-h{font-size:11px;letter-spacing:2px;color:var(--orange-600);margin-bottom:8px}
.rules-li{display:flex;gap:10px;margin-bottom:8px;font-size:14px;line-height:1.7;
  color:var(--ink-2)}
.rules-n{flex:none;width:18px;height:18px;border-radius:50%;margin-top:2px;
  background:var(--orange-50);color:var(--orange-600);font-size:10px;font-weight:600;
  display:flex;align-items:center;justify-content:center}
.rules-tx{flex:1;min-width:0}
.rules-foot{margin-top:20px;padding-top:14px;border-top:1px dashed var(--hairline);
  text-align:center;font-size:12px;color:var(--ink-3);letter-spacing:.5px}

/* ═══ 推荐卡集：小方块 ═══ */
.rec-section{margin-top:34px;padding-top:22px;border-top:1px solid var(--hairline)}
.rec-head{display:flex;align-items:baseline;justify-content:space-between}
.rec-head-t{font-size:16px;font-weight:600;color:var(--ink-1);letter-spacing:.5px}
.rec-refresh{font-size:11px;color:var(--ink-3);letter-spacing:.3px}
.rec-tabs{display:flex;gap:18px;margin:10px 0 12px}
.rec-tab{font-size:12px;color:var(--ink-3);padding-bottom:4px;
  border-bottom:1.5px solid transparent}
.rec-tab.on{color:var(--orange-600);border-bottom-color:var(--orange-500);font-weight:600}
.rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.rec-card{position:relative;aspect-ratio:1/1;border-radius:12px;overflow:hidden;
  background:var(--surface-muted);box-shadow:var(--shadow-card);
  transition:transform .15s ease,opacity .15s ease}
.rec-card-press{transform:scale(.98);opacity:.92}
.rec-cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.rec-fallback{display:flex;align-items:center;justify-content:center;
  padding-bottom:14px;background:linear-gradient(160deg,#FFFDF6,#F3E6D2)}
.rec-fallback-char{font-family:var(--font-serif);font-size:34px;font-weight:600;
  color:var(--ink-1);opacity:.82;line-height:1}
.rec-shade{position:absolute;left:0;right:0;bottom:0;height:66%;
  background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.66));pointer-events:none}
.rec-badge{position:absolute;top:7px;left:7px;z-index:2;
  padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.92);
  color:var(--orange-600);font-size:9px;font-weight:600;line-height:1.4;letter-spacing:.3px}
.rec-hot{position:absolute;top:7px;right:7px;z-index:2;
  padding:2px 6px;border-radius:999px;background:rgba(0,0,0,.38);
  color:#FFF;font-size:9px;line-height:1.4;letter-spacing:.3px}
.rec-title{position:absolute;left:8px;right:8px;bottom:22px;z-index:2;
  font-size:12px;font-weight:600;line-height:1.35;color:#FFF;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.rec-meta{position:absolute;left:8px;right:8px;bottom:7px;z-index:2;
  font-size:9px;color:rgba(255,255,255,.82);letter-spacing:.2px}

/* 抽卡后再抽抽看 */
.draw-rec{width:100%;margin-top:26px;padding-top:18px;border-top:1px dashed var(--hairline)}
.rec-head-compact{margin-bottom:10px}
.draw-rec-empty{text-align:center;font-size:12px;color:var(--ink-3);
  letter-spacing:.5px;padding:18px 0 4px}

/* 抽空后的下一集 */
.dp-next{width:100%;margin-top:28px;opacity:0;transform:translateY(10px);
  pointer-events:none;transition:opacity .35s ease,transform .35s ease}
.dp-next.show{opacity:1;transform:none;pointer-events:auto}
.dp-next-t{text-align:center;font-size:12px;color:var(--ink-3);
  letter-spacing:1px;margin-bottom:10px}
.dp-next .rec-title{font-size:11px}
.dp-next .rec-meta{font-size:8px}
.dp-next-more{text-align:center;font-size:11px;color:var(--orange-600);
  letter-spacing:.5px;margin-top:10px}
.dp-next .rec-fallback-char{display:none}
.dp-next .rec-title{font-size:10px;bottom:19px}
.dp-next .rec-meta{font-size:8px;bottom:6px}
.dp-next .rec-badge,.dp-next .rec-hot{font-size:8px;padding:1px 5px}
.rec-card.is-fallback .rec-shade{background:linear-gradient(180deg,rgba(255,255,255,0),rgba(255,253,246,.94))}
.rec-card.is-fallback .rec-title{color:var(--ink-1)}
.rec-card.is-fallback .rec-meta{color:var(--ink-3)}
.rec-card.is-fallback .rec-hot{background:rgba(0,0,0,.08);color:var(--ink-3)}
.rec-card.is-fallback .rec-fallback-char{opacity:.22}

/* ═══ 题眼 · 金色签名（作者偏爱） ═══ */
.dw-bar.sig{background:linear-gradient(90deg,#F0CF7E,#B78413);opacity:0;transition:opacity .3s ease}
.dw-bar.sig.show{opacity:1}
.dw-sig-stamp{position:absolute;top:18px;right:16px;z-index:4;
  width:58px;height:20px;border:1.5px solid #B78413;border-radius:2px;
  box-shadow:inset 0 0 0 2px #FFF,inset 0 0 0 3px #B78413;
  color:#7A5410;font-size:10px;font-weight:600;letter-spacing:1px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.55);transform:rotate(-4deg) scale(1.8);opacity:0}
.dw-sig-stamp.show{opacity:.92;animation:sigStampIn .62s cubic-bezier(.2,1.4,.4,1) both}
@keyframes sigStampIn{
  0%{transform:rotate(-4deg) scale(1.8);opacity:0}
  55%{transform:rotate(-4deg) scale(.94);opacity:.95}
  75%{transform:rotate(-4deg) scale(1.04);opacity:.9}
  100%{transform:rotate(-4deg) scale(1);opacity:.9}
}
.bigcard-sig{position:absolute;top:14px;right:14px;z-index:4;
  padding:2px 7px;border:1.5px solid #B78413;border-radius:2px;
  color:#7A5410;font-size:9px;font-weight:600;letter-spacing:1px;
  background:rgba(255,255,255,.65);transform:rotate(-4deg)}
.collection-tail-note{margin:var(--space-3) 0;text-align:center;
  font-size:var(--text-xs);color:var(--text-tertiary);letter-spacing:.5px}
.map-cell.sig{border-color:#B78413 !important;box-shadow:0 0 0 1px #B78413 inset}
.map-sig-mark{position:absolute;top:5px;right:6px;color:#B78413;font-size:12px;line-height:1}
.rdot.gold{background:#B78413 !important;border-color:#B78413 !important}
.ed-sig-mark{flex:none;width:22px;height:22px;border-radius:50%;
  border:1px solid #B78413;color:#7A5410;font-family:var(--font-serif);
  font-size:11px;display:flex;align-items:center;justify-content:center;
  transform:rotate(8deg)}
.sig-editor{display:flex;align-items:center;justify-content:space-between;gap:12px}
.sig-editor-txt{flex:1;min-width:0}
.sig-editor-txt .t-label{margin-bottom:2px}
.sig-note-wrap{margin-top:12px;padding-top:12px;border-top:1px dashed var(--hairline)}
.sig-block{margin:0 0 var(--space-3);padding:12px 0;border-top:1px dashed #E8D2A8}
.sig-block.compact{margin:8px 0 0;padding:8px 0;border-top:none}
.sig-mark{font-size:10px;letter-spacing:2px;color:#7A5410;font-weight:600}
.sig-hair{width:40px;height:1px;margin:8px 0 10px;
  background:linear-gradient(90deg,transparent,#B78413,transparent)}
.sig-note{font-family:var(--font-serif);font-size:14px;line-height:1.8;
  color:var(--ink-2);letter-spacing:.5px}
.poster-sig-stamp{position:absolute;top:54px;right:24px;padding:2px 8px;
  border:1.5px solid #B78413;border-radius:2px;color:#7A5410;
  font-size:10px;font-weight:600;letter-spacing:1px;
  background:rgba(255,255,255,.7);transform:rotate(-4deg)}
.poster-sig-note{margin:14px 22px 0;text-align:center;font-family:var(--font-serif);
  font-size:14px;line-height:1.7;color:var(--ink-2)}
.h916-sig{padding:2px 6px;border:1px solid #B78413;border-radius:2px;
  color:#7A5410;font-size:9px;font-weight:600;letter-spacing:1px}
.weekly-card.sig{box-shadow:inset 0 3px 0 #B78413}
.sig-switch{width:44px;height:26px;flex:none;border-radius:999px;background:var(--gray-200);
  position:relative;transition:background .18s ease}
.sig-switch.on{background:#B78413}
.sig-switch-knob{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;
  background:#FFF;box-shadow:0 1px 3px rgba(0,0,0,.18);transition:transform .18s ease}
.sig-switch.on .sig-switch-knob{transform:translateX(18px)}
.poster-card.sig{box-shadow:0 8px 32px rgba(183,132,19,.16)}
.h916-bar.sig{background:linear-gradient(90deg,#F0CF7E,#B78413)}
