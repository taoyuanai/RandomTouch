    margin-bottom:var(--space-2);
  }#bigcard .pc-letter.no-note .pc-explain{-webkit-line-clamp:2}


/* ══════════════════════════════════════════════════════════
   微信小程序适配层
   - 页面自身滚动（不使用 .phone 固定高度）
   - 自定义导航安全区 / 底部 tabbar / 弹层 / 安全区
   - 原生 button 重置
   - WXML 标签映射（.t-*）与图标/印戳适配
   ══════════════════════════════════════════════════════════ */
page{
  background: var(--surface-page);
  font-family: var(--font-sans);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
view, text, button, input, textarea, image{
  box-sizing: border-box;
}
button{
  width: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: inherit;
  overflow: visible;
}
button::after{ border: none; }
/* 微信原生 button 默认宽度为 184px，需按用途覆写 */
page button{ width: auto; }
page .cta,
page .ghost,
page .newcraft-btn,
page .ed-add{ width: 100%; }
page .close-btn{ width: 32px; }
input, textarea{
  font-family: inherit;
  color: inherit;
  background: transparent;
  border: none;
  outline: none;
}
input::placeholder, textarea::placeholder{ color: var(--text-tertiary); }

.phone{
  width: 100%;
  height: auto;
  min-height: 100vh;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
  display: block;
  position: relative;
  background: var(--surface-page);
}
.screen{
  overflow: visible;
  position: static;
  flex: none;
}
.page{
  display: block;
  min-height: 100vh;
  padding-top: var(--navtop, var(--statusbar, 0px));
  padding-bottom: 110px;
}
.page-head{
  top: var(--navtop, var(--statusbar, 0px));
}
.status-spacer{
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navtop, var(--statusbar, 0px));
  background: var(--surface-page);
  z-index: 30;
  pointer-events: none;
}

/* 底部导航：固定在视口底部 */
.tabbar{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar .t-svg{
  display: block;
  width: 22px;
  height: 22px;
  margin: 0 auto 3px;
}

/* 吸底按钮 / 弹层 / Toast */
.cta-fixed-wrap{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  margin: 0;
  padding: var(--space-4) var(--space-4) calc(var(--space-3) + constant(safe-area-inset-bottom));
  padding: var(--space-4) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
}
#page-set{ padding-bottom: 160px; }
.modal{
  position: fixed;
  z-index: 80;
}
.sheet{
  padding-bottom: calc(var(--space-5) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
}
.modal.centered{
  padding-top: calc(var(--navtop, 0px) + var(--space-3));
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  align-items: center;
}
.modal.centered .sheet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}
.toast{
  bottom: calc(100px + constant(safe-area-inset-bottom));
  bottom: calc(100px + env(safe-area-inset-bottom));
  z-index: 140;
}
.poster-sheet.booklet{
  max-height: calc(100vh - var(--navtop, 0px) - 76px);
}
.demo-actions{
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-1);
}
.mini-cta.demo-action{
  flex: 1 1 140px;
  width: auto;
  height: auto !important;
  min-height: 34px;
  padding: 7px 8px !important;
  line-height: 1.4 !important;
  white-space: normal;
  font-size: 12px;
}
.bottom-sheet{
  max-height: calc(100vh - 40px);
  overflow-y: auto;
}
.toast{
  white-space: normal;
  line-height: 1.5;
}
#posterModal .poster-card{
  padding-top: calc(var(--space-5) + 26px);
}
#posterModal .poster-actions{
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding: var(--space-3) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
}

/* 卡背容器 */
.card-back-inner{
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.pc-empty{
  padding: var(--space-5) var(--space-4);
}

/* 印戳：用真实文本替代 CSS attr()，避免小程序不支持 */
.stamp::before,
.stamp::after,
.bk-stamp::before,
.bk-stamp::after{
  content: none !important;
  display: none !important;
}
.stamp-text{
  position: relative;
  z-index: 1;
  font: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  color: inherit;
}

/* 图标（PNG）保持与原型 SVG 相同尺寸/占位 */
image.t-svg{ display: inline-block; vertical-align: middle; }
.tabbar button image.t-svg{ display: block; }
.search-bar image.t-svg{ width: 18px; height: 18px; flex: none; }
.search-bar image.scan-icon{ width: 20px; height: 20px; }
.set-heat image.t-svg{ width: 14px; height: 14px; }
.cf-bottom .flip-hint image.t-svg{ width: 14px; height: 14px; }
.rec-slot.empty image.t-svg{ width: 18px; height: 18px; flex: none; }
.rc-photo-empty image.t-svg{ width: 26px; height: 26px; }
.mc-badge image.t-svg{ width: 9px; height: 9px; }

/* 图片组件默认宽高重置 */
image.t-img{
  width: 100%;
  height: 100%;
  display: block;
}

/* 长文本换行 */
.draw-tail{ white-space: pre-line; }

/* 输入控件（原生 input/textarea） */
.fi{
  width: 100%;
  font-size: var(--text-lg);
  line-height: 1.5;
  letter-spacing: 0.5px;
  padding: var(--space-3);
  background: var(--surface-muted);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  text-align: left;
}
.fi:focus{ border-color: var(--border-focus); background: var(--surface-card); }
input.fi{ height: 44px; padding: 0 var(--space-3); }
textarea.fi{ height: 84px; min-height: 84px; }

/* 页面切换动画 */
.page{ animation: fadein var(--duration-normal) var(--ease-default); }

/* 禁止长按选中 */
.page, .tabbar, .modal{ -webkit-user-select: none; user-select: none; }
input, textarea, .stamp, .stamp-text, .bk-stamp{ -webkit-user-select: auto; user-select: auto; }


/* ── 原生 button / 导航安全区补充 ── */
#page-create{ padding-top: calc(var(--navtop, var(--statusbar, 0px)) + var(--space-5)); }
#page-me{ padding-top: var(--navtop, var(--statusbar, 0px)); }

.cta,
.ghost,
.mini-cta,
.follow,
.ed-add,
.ed-del,
.seg button,
.subhead .back{
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar button{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 输入框在小程序原生组件下的保底样式 */
.input-placeholder,
.textarea-placeholder{ color: var(--text-tertiary); }
