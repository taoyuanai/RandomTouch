<view class="phone" style="--statusbar:0px;--navtop:0px">
  <v6-topbar title="收益看板" status-bar-height="{{statusBarHeight}}" bind:back="backIncome" />

  <view class="page v6-income-page" id="page-income">
    <include src="/templates/m-base.wxml"/>

    <view id="incomeBody">
      <view class="v6-income-hero">
        <text class="v6-income-kicker">累 计 收 益</text>
        <view class="v6-income-total">{{income.totalText}}<text class="v6-income-tax">税前</text></view>
        <text class="v6-income-sub">定价卡集 · 创作者份额 80% · 平台激励另计</text>

        <view class="v6-income-stats">
          <view><strong>{{income.availText}}</strong><span>可提现</span></view>
          <view><strong>{{income.pendingText}}</strong><span>处理中</span></view>
          <view><strong>{{income.withdrawnText}}</strong><span>已提现</span></view>
        </view>

        <view class="v6-income-track"><view class="t-i" style="width:{{income.withdrawPct}}%"></view></view>
        <view class="v6-income-withdraw">
          <text>{{income.withdrawLabel}}</text>
          <text>目标 ¥{{income.threshold}}</text>
        </view>

        <view wx:if="{{income.canWithdraw}}" class="v6-btn primary" hover-class="hm-press" bindtap="doWithdraw">{{income.withdrawBtn}}</view>
        <view wx:else class="v6-btn secondary is-disabled">{{income.withdrawBtn}}</view>
        <text class="v6-income-note">提现 1–3 个工作日到账</text>
      </view>

      <block wx:if="{{income.showComposition}}">
        <view class="v6-list-head">
          <text class="v6-h2">收益构成</text>
          <text class="v6-count">{{income.paidSetN}} 个定价集</text>
        </view>
        <view class="v6-income-list">
          <view class="v6-income-row" wx:for="{{income.bySet}}" wx:key="title">
            <image class="v6-icon" src="/assets/icons/v6/wallet-ink.png" mode="aspectFit" />
            <view class="v6-income-row-info">
              <text class="v6-income-row-t">{{item.title}}</text>
              <text class="v6-income-row-s">{{item.meta}}</text>
            </view>
            <text class="v6-income-row-v">{{item.val}}</text>
          </view>
          <view class="v6-income-row">
            <image class="v6-icon" src="/assets/icons/v6/sparkles-brand.png" mode="aspectFit" />
            <view class="v6-income-row-info">
              <text class="v6-income-row-t">平台激励</text>
              <text class="v6-income-row-s">免费卡集按抽签量结算 · 本周</text>
            </view>
            <text class="v6-income-row-v">{{income.platformText}}</text>
          </view>
        </view>
      </block>

      <block wx:if="{{income.showDetail}}">
        <view class="v6-list-head">
          <text class="v6-h2">收益明细</text>
          <text class="v6-count">近 7 天</text>
        </view>
        <view class="v6-income-list">
          <view class="v6-txn" wx:for="{{income.txns}}" wx:key="d">
            <text class="v6-txn-d">{{item.d}}</text>
            <view class="v6-txn-info">
              <text class="v6-txn-t">{{item.title}}</text>
              <text class="v6-txn-s">{{item.meta}}</text>
            </view>
            <text class="v6-txn-a">{{item.amt}}</text>
          </view>
          <view class="v6-txn sum" wx:if="{{income.buyersTotal > 0}}">
            <text class="v6-txn-d"></text>
            <view class="v6-txn-info"><text class="v6-txn-t">定价解锁 · {{income.buyersTotal}} 笔</text></view>
            <text class="v6-txn-a">{{income.paidTotalText}}</text>
          </view>
        </view>
      </block>

      <view class="v6-income-foot">免费卡集按抽签量获得平台激励 · 付费卡集按解锁分成（80%）。免费试抽与退款不计入。</view>
    </view>
  </view>
</view>
