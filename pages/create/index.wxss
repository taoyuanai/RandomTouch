
#page-create{padding:0 20px calc(88px + env(safe-area-inset-bottom))}
.v6-create-new{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:18px}
.v6-create-new .v6-icon{width:18px;height:18px}
.v6-income-entry{display:flex;align-items:center;gap:12px;margin-top:18px;padding:14px;border:1px solid var(--v6-orange-200);border-radius:16px;background:var(--v6-surface)}
.v6-income-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.v6-income-t{font-size:15px;font-weight:600;color:var(--v6-ink)}
.v6-income-s{font-size:12px;color:var(--v6-ink-2)}
.v6-income-val{font-size:17px;font-weight:700;color:var(--v6-action);white-space:nowrap}
.v6-income-entry .v6-icon{width:22px;height:22px;flex:none}
.v6-create-group{margin-top:24px}
.v6-create-foot{padding:30px 0 10px;text-align:center;font-size:12px;line-height:1.6;color:var(--v6-ink-3)}
.v6-lib-head .v6-lib-title{font-size:24px;line-height:32px}
