
#page-cards{padding:0 20px calc(88px + env(safe-area-inset-bottom))}
.v6-lib-ico{width:28px;height:28px;flex:none}
.v6-lib-page{padding-top:0}
.v6-weekly{padding:19px 0 20px;border-top:1px solid var(--v6-line);border-bottom:1px solid var(--v6-line)}
.v6-weekly-head{display:flex;align-items:center;justify-content:space-between}
.v6-weekly-copy{display:flex;flex-direction:column;gap:4px}
.v6-weekly-k{font-size:12px;font-weight:600;color:var(--v6-action)}
.v6-weekly-t{font-size:17px;line-height:25px;font-weight:600;color:var(--v6-ink)}
.v6-weekly-n{font-size:30px;line-height:36px;font-weight:700;color:var(--v6-ink);font-variant-numeric:tabular-nums}
.v6-weekly-n text{font-size:16px;color:var(--v6-ink-3)}
.v6-weekly .v6-progress{margin-top:15px}
.v6-weekly-sub{display:block;margin-top:9px;font-size:13px;color:var(--v6-ink-2)}
.v6-lib-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin:0 0 6px;border-bottom:1px solid var(--v6-line)}
.v6-lib-tab{position:relative;min-height:46px;display:flex;align-items:center;justify-content:center;color:var(--v6-ink-2);font-size:14px;font-weight:500}
.v6-lib-tab.on{color:var(--v6-ink);font-weight:700}
.v6-lib-tab.on::after{content:"";position:absolute;width:24px;height:3px;left:50%;bottom:-1px;border-radius:999px;background:var(--v6-orange);transform:translateX(-50%)}
.v6-lib-list{display:flex;flex-direction:column}
.v6-lib-prog{font-size:11px;color:var(--v6-ink-3);font-variant-numeric:tabular-nums}
.v6-lib-status{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:12px;color:var(--v6-ink-3)}
.v6-lib-dot{width:6px;height:6px;border-radius:50%;background:var(--v6-orange);flex:none}
.v6-lib-status.quiet .v6-lib-dot{background:var(--v6-ink-4)}
.v6-lib-status.wait .v6-lib-dot{background:var(--v6-orange)}
.v6-lib-status.gold .v6-lib-dot{background:var(--v6-orange)}
.v6-lib-meta{margin-top:4px;max-width:100%;font-size:12px;line-height:18px;color:var(--v6-ink-3)}
.v6-collect-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 16px;padding-top:18px}
.v6-collect-card{min-width:0}
.v6-collect-title{margin-top:10px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:15px;font-weight:600;color:var(--v6-ink)}
.v6-collect-sub{margin-top:3px;font-size:12px;color:var(--v6-ink-3)}
.v6-collect-meta{margin-top:3px;max-width:100%;font-size:10px;line-height:15px;color:var(--v6-ink-3)}
.v6-record-card{margin-top:18px;padding:18px;border:1px solid var(--v6-line);border-radius:18px;background:var(--v6-surface)}
.v6-record-head{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--v6-ink-2)}
.v6-record-status{color:var(--v6-action);font-weight:600}
.v6-record-img{width:100%;max-height:240px;margin-top:14px;border-radius:12px}
.v6-record-word{margin-top:18px;font-size:25px;font-weight:700;color:var(--v6-ink)}
.v6-record-note{margin-top:10px;font-size:16px;line-height:27px;color:var(--v6-ink)}
.v6-record-src{margin-top:18px;padding-top:12px;border-top:1px solid var(--v6-line);font-size:12px;color:var(--v6-ink-2)}
.v6-lib-foot{padding:34px 0 6px;text-align:center;font-size:12px;color:var(--v6-ink-3)}
.v6-mini{position:relative;width:100%;height:100%;display:flex;flex-direction:column;padding:7px;overflow:hidden;border:1px solid var(--v6-line);border-radius:9px;background:var(--v6-surface)}
.v6-mini.is-key{border-color:var(--v6-orange-200);background:var(--v6-orange-50)}
.v6-mini-no{font-size:7px;letter-spacing:.04em;color:var(--v6-ink-3)}
.v6-mini-word{display:block;max-height:3.9em;overflow:hidden;margin:auto 0;font-size:13px;line-height:1.35;font-weight:600;text-align:center;color:var(--v6-ink);word-break:break-word}
.v6-mini-word.kw-1{font-size:18px}
.v6-mini-word.kw-2{font-size:15px}
.v6-mini-word.kw-3{font-size:12px}
.v6-mini-word.kw-4{font-size:10px}
.v6-mini-word.kw-5{font-size:9px;line-height:1.5}
.v6-mini-key{position:absolute;right:4px;bottom:4px;width:14px;height:14px;border:1px solid var(--v6-orange);border-radius:2px;color:var(--v6-orange);font-size:7px;line-height:12px;text-align:center}