<view class="phone" style="--statusbar:0px;--navtop:0px">
<!-- ═══════════════════ 我的 ═══════════════════ -->
  <view class="v6-lib-nav" style="padding-top:{{statusBarHeight}}px">
    <view class="v6-lib-nav-inner" style="padding-right:{{menuPad}}px">
      <view class="v6-lib-head">
        <text class="v6-kicker">MY SPACE</text>
        <text class="v6-lib-title">我的</text>
      </view>
      <view class="v6-icon-btn" hover-class="hm-press" bindtap="openRemind">
        <image class="v6-icon" src="/assets/icons/v6/bell-ink.png" mode="aspectFit" />
      </view>
    </view>
  </view>

    <view class="page v6-me-page" id="page-me">
<include src="/templates/m-base.wxml"/>

      <view id="meBody">
        <view class="v6-me-profile" hover-class="hm-press" bindtap="meToAuthor">
          <view class="v6-me-avatar-wrap" catchtap="chooseMyAvatar">
            <image wx:if="{{me.avatarImg}}" class="v6-me-avatar-img" src="{{me.avatarImg}}" mode="aspectFill" />
            <view wx:else class="v6-me-avatar">我</view>
            <view class="v6-me-avatar-edit">
              <image class="v6-icon" src="/assets/icons/v6/image-plus-ink.png" mode="aspectFit" />
            </view>
          </view>
          <view class="v6-me-info">
            <view class="v6-me-name">@{{me.name}}</view>
            <view class="v6-me-role">做卡人</view>
          </view>
          <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
        </view>

        <view class="v6-lib-stats">
          <view><strong>{{me.cardN}}</strong><span>收集卡片</span></view>
          <view><strong>{{me.stampN}}</strong><span>已盖邮戳</span></view>
          <view><strong>{{me.emptied}}</strong><span>已抽空</span></view>
        </view>
        <view class="v6-me-today">{{me.todayLine}}</view>

        <view class="v6-me-group">
          <view class="v6-me-row" hover-class="hm-press" bindtap="backToCreate">
            <image class="v6-icon" src="/assets/icons/v6/pen-line-brand.png" mode="aspectFit" />
            <text class="v6-me-row-t">创作中心</text>
            <text class="v6-me-row-v">{{me.craftN}} 个作品</text>
            <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
          </view>
          <view class="v6-me-row" hover-class="hm-press" bindtap="goIncome">
            <image class="v6-icon" src="/assets/icons/v6/wallet-brand.png" mode="aspectFit" />
            <text class="v6-me-row-t">收益看板</text>
            <text class="v6-me-row-v">{{me.availText}}</text>
            <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
          </view>
          <view class="v6-me-row" hover-class="hm-press" bindtap="openRules">
            <image class="v6-icon" src="/assets/icons/v6/book-open-brand.png" mode="aspectFit" />
            <text class="v6-me-row-t">怎么玩</text>
            <text class="v6-me-row-v">每天 1 张</text>
            <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
          </view>
        </view>

        <view class="v6-me-group">
          <view class="v6-me-row" hover-class="hm-press" bindtap="openRemind">
            <image class="v6-icon" src="/assets/icons/v6/bell-brand.png" mode="aspectFit" />
            <text class="v6-me-row-t">每日提醒</text>
            <text class="v6-me-row-v">{{me.remindText}}</text>
            <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
          </view>
        </view>

        <view class="v6-me-foot">把内容过成日子，把日子收进卡册。</view>
      </view>
    </view>

    <!-- 每日提醒 -->
    <view class="modal centered {{remind.show ? 'show' : ''}}" id="remindModal">
      <view class="sheet v6-sheet">
        <view class="v6-sheet-head">
          <text class="v6-sheet-title">每日提醒</text>
          <view class="v6-icon-btn" hover-class="hm-press" bindtap="closeRemind">
            <image class="v6-icon" src="/assets/icons/v6/x-ink.png" mode="aspectFit" />
          </view>
        </view>
        <view class="v6-setting-row">
          <view>
            <text class="v6-setting-t">提醒我抽今日卡</text>
            <text class="v6-setting-s">每天留一分钟给自己</text>
          </view>
          <view class="v6-switch {{remind.enabled ? 'on' : ''}}" bindtap="toggleRemindPage">
            <view class="v6-switch-knob"></view>
          </view>
        </view>
        <view class="v6-time-options">
          <text class="v6-time-label">提醒时间</text>
          <view class="v6-time-grid">
            <view class="v6-time {{item.on ? 'on' : ''}}" wx:for="{{remind.times}}" wx:key="key"
                  data-key="{{item.key}}" bindtap="pickRemindTime">{{item.label}}</view>
          </view>
        </view>
        <view class="v6-btn primary" hover-class="hm-press" bindtap="enableRemind">保存设置</view>
      </view>
    </view>

<!-- ═══════════════════ 怎么玩 · 完整规则 ═══════════════════ -->
  <view class="modal {{rulesSheet.show ? 'show' : ''}}" id="rulesModal">
    <view class="sheet rules-sheet">
      <button class="close-btn rules-close" bindtap="closeRules">✕</button>
      <view class="rules-kicker">抽 卡 说 明</view>
      <view class="rules-title">怎么玩</view>

      <view class="rules-block">
        <view class="rules-h">每天</view>
        <view class="rules-li"><text class="rules-n">1</text><text class="rules-tx">每天可抽 1 张，0 点重置（北京时间）</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">收藏集</view>
        <view class="rules-li"><text class="rules-n">2</text><text class="rules-tx">抽过的不再出现，抽完即空，留一张纪念</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">常驻集</view>
        <view class="rules-li"><text class="rules-n">3</text><text class="rules-tx">天天可抽，抽到就是答案</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">付费集</view>
        <view class="rules-li"><text class="rules-n">4</text><text class="rules-tx">前 1 张免费试抽，试抽不占每日额度</text></view>
        <view class="rules-li"><text class="rules-n">5</text><text class="rules-tx">解锁是一次性的，之后每天照抽</text></view>
      </view>

      <view class="rules-foot">缺席不损失，卡不会过期</view>
    </view>
  </view>

  

</view>
