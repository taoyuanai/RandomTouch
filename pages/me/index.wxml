<view class="phone" style="--statusbar:0px;--navtop:0px">
<!-- ═══════════════════ 我的 ═══════════════════ -->
    <view class="page" id="page-me">
<include src="/templates/m-base.wxml"/>

      <view id="meBody">
        <view class="panel me-profile" bindtap="meToAuthor">
          <view class="avatar">我</view>
          <view class="mp-info">
            <view class="t-b">@{{me.name}}</view>
            <text class="t-span">做卡人</text>
          </view>
          <text class="mp-go">主页 ›</text>
        </view>

        <view class="stats">
          <view class="stat"><view class="t-b">{{me.cardN}}</view><text class="t-span">点亮图鉴</text></view>
          <view class="stat"><view class="t-b orange">{{me.stampN}}</view><text class="t-span">已盖邮戳</text></view>
          <view class="stat"><view class="t-b">{{me.emptied}}</view><text class="t-span">已抽空</text></view>
        </view>
        <view class="t-p me-today">{{me.todayLine}}</view>

        <view class="rules-entry" hover-class="rules-entry-press" bindtap="openRules">
          <view class="rules-entry-head">
            <view class="t-b">怎么玩</view>
            <view class="rules-entry-more">完整规则 <text class="rules-entry-go">›</text></view>
          </view>
          <view class="rules-entry-line">每天 1 张 · 0 点重置</view>
          <view class="rules-entry-line">收藏集抽完即空 / 常驻集天天可抽</view>
          <view class="rules-entry-line">付费集前 1 张免费试抽</view>
          <view class="rules-entry-line muted">缺席不损失，卡不会过期</view>
        </view>

        <view class="panel" style="padding:6px 18px;margin-bottom:12px">
          <view class="li" bindtap="backToCreate">创作中心<text class="t-span li-val">{{me.craftN}} 个作品</text><text class="t-span">›</text></view>
          <view class="li" style="border:none" bindtap="goIncome">收益看板<text class="t-span li-val">{{me.availText}}</text><text class="t-span">›</text></view>
        </view>
        <view class="panel" style="padding:6px 18px">
          <view class="li" bindtap="meWallet">钱包<text class="t-span">›</text></view>
          <view class="li" style="border:none" bindtap="meSettings">提醒我明天的卡<text class="t-span li-val">{{me.remindText}}</text><text class="t-span">›</text></view>
        </view>

      </view>
    </view>

    
<!-- ═══════════════════ 怎么玩 · 完整规则 ═══════════════════ -->
  <view class="modal {{rulesSheet.show ? 'show' : ''}}" id="rulesModal">
    <view class="sheet rules-sheet">
      <button class="close-btn rules-close" bindtap="closeRules">✕</button>
      <view class="rules-kicker">抽 卡 说 明</view>
      <view class="rules-title">怎么玩</view>

      <view class="rules-block">
        <view class="rules-h">每天</view>
        <view class="rules-li"><text class="rules-n">1</text><text class="rules-tx">每天可抽 1 张，0 点重置（北京时间）</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">收藏集</view>
        <view class="rules-li"><text class="rules-n">2</text><text class="rules-tx">抽过的不再出现，抽完即空，留一张纪念</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">常驻集</view>
        <view class="rules-li"><text class="rules-n">3</text><text class="rules-tx">天天可抽，抽到就是答案</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">付费集</view>
        <view class="rules-li"><text class="rules-n">4</text><text class="rules-tx">前 1 张免费试抽，试抽不占每日额度</text></view>
        <view class="rules-li"><text class="rules-n">5</text><text class="rules-tx">解锁是一次性的，之后每天照抽</text></view>
      </view>

      <view class="rules-foot">缺席不损失，卡不会过期</view>
    </view>
  </view>

  
<!-- ═══════════════════ 订阅消息 · 提醒我明天的卡 ═══════════════════ -->
  <view class="modal {{remind.show ? 'show' : ''}}" id="remindModal">
    <view class="sheet rules-sheet remind-sheet">
      <button class="close-btn rules-close" bindtap="closeRemind">✕</button>
      <view class="rules-kicker">提 醒 我 明 天 的 卡</view>
      <view class="rules-title">提醒我明天的卡</view>
      <view class="remind-desc">每天 0 点，新的卡到。选个时间，授权一次，明天这个时间提醒你。</view>
      <view class="remind-time {{item.on ? 'on' : ''}}" wx:for="{{remind.times}}" wx:key="key"
            bindtap="pickRemindTime" data-key="{{item.key}}" hover-class="sb2-press">
        <view class="remind-time-l">
          <text class="remind-time-t">{{item.label}}</text>
          <text class="remind-time-s">{{item.sub}}</text>
        </view>
        <view class="remind-radio"></view>
      </view>
      <button class="cta solid remind-btn" bindtap="enableRemind">开启提醒</button>
      <view class="remind-off" wx:if="{{remind.enabled}}" bindtap="disableRemind">关闭提醒</view>
    </view>
  </view>

  

</view>
