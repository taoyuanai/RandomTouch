<import src="/templates/cover.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
<!-- ═══════════════════ 发现 ═══════════════════ -->
    <view class="v6-home-nav" style="padding-top:{{statusBarHeight}}px">
      <view class="v6-home-nav-inner">
        <view class="v6-brand">
          <view class="v6-brand-mark"><view></view><view></view></view>
          <text>卡集</text>
        </view>
      </view>
    </view>

    <view class="page v6-home" id="page-home">
<include src="/templates/m-base.wxml"/>
      <view class="v6-home-intro">
        <text class="v6-home-date">{{home.dateText}}</text>
        <view class="v6-home-title">今天也对这个世界</view>
        <view class="v6-home-title">做出一点点探索</view>
      </view>

      <view class="v6-search" hover-class="hm-press" bindtap="goSearch">
        <image class="v6-icon" src="/assets/icons/v6/search-ink.png" mode="aspectFit" />
        <text>搜索卡集、做卡人或关键词</text>
      </view>

      <view class="v6-daily" wx:if="{{home.daily}}" hover-class="hm-press" bindtap="tapDaily" data-id="{{home.daily.id}}">
        <view class="v6-daily-copy">
          <view class="v6-daily-label">
            <image class="v6-icon" src="/assets/icons/v6/sparkles-brand.png" mode="aspectFit" /> 今日一卡
          </view>
          <view class="v6-daily-title">给此刻的自己</view>
          <view class="v6-daily-title">一句刚刚好的话</view>
          <view class="v6-daily-btn">
            {{home.daily.canDraw ? '抽今日卡' : '去看看'}}
            <image class="v6-icon" src="/assets/icons/v6/arrow-right-brand.png" mode="aspectFit" />
          </view>
        </view>
        <view class="v6-daily-art"><view></view><view></view><view></view></view>
      </view>

      <view class="v6-chips">
        <view class="chip {{item.on ? 'on' : ''}}"
              wx:for="{{home.chips}}" wx:key="key"
              hover-class="hm-press" data-key="{{item.key}}" bindtap="setCat">{{item.chip}}</view>
      </view>

      <view class="v6-list-head">
        <text class="v6-h2">{{home.title}}</text>
        <view class="v6-list-right">
          <text class="v6-cat-link" bindtap="goCategories">分类</text>
          <text class="v6-count">{{home.rows.length}} 个卡集</text>
        </view>
      </view>

      <view class="skel-list" wx:if="{{booting}}">
        <view class="skel-book" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="skel skel-cover"></view>
          <view class="skel-book-txt">
            <view class="skel skel-line" style="width:70%"></view>
            <view class="skel skel-line" style="width:45%"></view>
            <view class="skel skel-line" style="width:55%"></view>
          </view>
        </view>
      </view>

      <view id="squareList" class="v6-set-list">
        <view class="v6-set-row" wx:for="{{home.rows}}" wx:key="id" bindtap="openSet"
              data-id="{{item.id}}" data-from="home" hover-class="hm-press">
          <template is="coverArt" data="{{item: item.cover}}" />
          <view class="v6-set-content">
            <view class="v6-set-top">
              <text class="v6-set-cat">{{item.catName}}</text>
              <text class="v6-set-price">{{item.priceText}}</text>
            </view>
            <text class="v6-set-title">{{item.title}}</text>
            <text class="v6-set-sub">{{item.subText}}</text>
            <text class="v6-set-meta">{{item.metaText}}</text>
          </view>
        </view>
      </view>

      <view class="v6-page-end" wx:if="{{!booting}}">
        <view class="v6-brand-mark">
          <view></view><view></view>
        </view>
        <text>今天也有好好照顾自己</text>
      </view>
    </view>

    


</view>
