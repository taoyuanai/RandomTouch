
#page-draw{background:var(--v6-surface)}
.dk-top{position:relative;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;box-sizing:border-box}
.dk-title{flex:1;min-width:0;text-align:center;font-family:var(--font-sans);font-size:16px;font-weight:600;letter-spacing:0;color:var(--v6-ink);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 8px}
.v6-draw-intro{padding:6px 20px 5px;text-align:center}
.v6-draw-kicker{display:block;font-size:18px;font-weight:600;color:var(--v6-ink)}
.v6-draw-sub{display:block;margin-top:5px;font-size:12px;color:var(--v6-ink-2)}
.dk-stage{width:min(258px,72vw);margin:20px auto 0;padding:0;display:block;position:relative;aspect-ratio:5/7}
.dk-card{width:100%;height:100%;max-width:none;aspect-ratio:auto;border:1px solid var(--v6-line);border-radius:22px;background:var(--v6-surface);box-shadow:0 12px 30px rgba(32,33,36,.08);perspective:1100px;overflow:visible}
.dk-edge{inset:0;border:1px solid var(--v6-line);border-radius:22px;background:var(--v6-surface);box-shadow:none;z-index:0}
.dk-edge.e2{transform:translate(7px,8px)}
.dk-edge.e3{transform:translate(4px,5px)}
.dk-edge.e4{transform:translate(2px,3px)}
.dk-face.back{background-color:var(--v6-surface);background-image:none}
.dk-edge.e2,.dk-edge.e3,.dk-edge.e4{background:var(--v6-surface)}
.dk-seal-half.l{background:linear-gradient(90deg,#FFF6F1,#FFE5D8)}
.dk-seal-half.r{background:linear-gradient(90deg,#FFE5D8,#FFC4A8)}
.dk-seal-txt{color:var(--v6-action);text-shadow:none}
.dk-flip{position:absolute;inset:0;z-index:1;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.2,.72,.25,1)}
.dk-face{position:absolute;inset:0;border-radius:22px;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:var(--v6-surface)}
.dk-face.back.idle{display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--v6-orange);color:var(--v6-on-orange)}
.dk-face.back.word{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:21px}
.v6-cardback-mark{position:relative;width:29px;height:29px;margin-bottom:16px}
.v6-cardback-mark view{position:absolute;display:block;width:18px;height:23px;border-radius:5px;transform:rotate(-8deg)}
.v6-cardback-mark view:first-child{left:2px;top:4px;border:2px solid var(--v6-on-orange);background:transparent}
.v6-cardback-mark view:last-child{right:1px;top:1px;background:var(--v6-on-orange);transform:rotate(8deg)}
.v6-cardback-title{font-size:37px;line-height:1.2;font-weight:700}
.v6-cardback-copy{margin-top:8px;font-size:13px;font-weight:600}
.v6-cardback-orbit{position:absolute;width:220px;height:220px;right:-73px;bottom:-38px}
.v6-cardback-orbit view{position:absolute;border-radius:50%}
.v6-cardback-orbit view:first-child{inset:0;border:22px solid rgba(255,255,255,.76)}
.v6-cardback-orbit view:last-child{inset:57px;border:2px solid var(--v6-on-orange)}
.dk-face.front{display:flex;flex-direction:column;padding:23px;transform:rotateY(180deg)}
.dk-goldmark{right:14px;bottom:54px;padding:3px 4px;border:1px solid var(--v6-orange);border-radius:2px;color:var(--v6-orange);font-family:var(--font-sans);font-size:10px;line-height:1.2;display:flex;flex-direction:column;align-items:center;gap:1px;opacity:0}
.dw.is-flipped .dk-face.front.sig .dk-goldmark{opacity:1;animation:sigStampIn .62s cubic-bezier(.2,1.4,.4,1) .2s both}
.dw.is-visited .dk-goldmark{opacity:1;animation:none}
.v6-draw-helper{margin-top:12px;padding:0 20px;text-align:center;font-size:12px;line-height:18px;color:var(--v6-ink-2)}
.dw-echo{display:flex;justify-content:center;gap:12px;margin-top:14px;padding:0 20px}
.dw-echo-like{display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 12px;border:1px solid var(--v6-line);border-radius:999px;background:var(--v6-surface);color:var(--v6-ink-2)}
.dw-echo-like.on{background:var(--v6-orange-50);border-color:var(--v6-orange-200);color:var(--v6-action)}
.dw-echo-heart{font-size:16px;color:var(--v6-orange)}
.dw-echo-n{font-weight:600}
.dw-echo-l{font-size:11px;color:var(--v6-ink-3)}
.dw-echo-comment{display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 10px;border:1px solid var(--v6-line);border-radius:999px;background:var(--v6-surface);color:var(--v6-ink-2)}
.dw-echo-pen{font-size:14px;color:var(--v6-orange)}
.dw-actions{width:100%;max-width:320px;margin:16px auto 0;padding:0 20px;box-sizing:border-box}
.dk-act{display:none;flex-direction:column;align-items:center;gap:10px}
.dw.is-idle .dk-act-idle{display:flex}
.dw.is-drawn .dk-act-flip{display:flex}
.dw.is-flipped .dk-act-done,.dw.is-visited .dk-act-done{display:flex}
.dw-btn{min-width:0;height:48px;border:0;border-radius:14px;font-size:16px;font-weight:600;letter-spacing:0;box-shadow:none}
.dw-btn.brand,.dw-btn.gold{background:var(--v6-action);color:#FFFFFF}
.dw-btn.ghost{height:44px;border:1px solid var(--v6-line);border-radius:12px;background:var(--v6-surface);color:var(--v6-ink-2);font-size:14px;font-weight:400}
.dw{background:var(--v6-surface);padding:0 0 calc(24px + env(safe-area-inset-bottom))}
