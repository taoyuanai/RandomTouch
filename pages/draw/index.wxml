<import src="/templates/common.wxml"/>
<view class="phone" style="--statusbar:{{statusBarHeight}}px;--navtop:{{navTop}}px">
  <view class="status-spacer"></view>
  <view class="screen">
<!-- ═══════════════════ 抽卡 ═══════════════════ -->
    <view class="page" id="page-draw" wx:if="{{draw}}">
      <view class="dw {{draw.stage}}">
        <view class="dw-back" bindtap="backToSet">‹</view>
        <view class="dw-stage">
          <!-- 组①：信封（未拆 / 拆信中） -->
          <view class="dw-env" wx:if="{{draw.stage !== 'after'}}" bindtap="tapEnvelope">
            <view class="dw-env-body">
              <view class="dw-env-char">{{draw.envelope.coverChar}}</view>
              <view class="dw-env-meta">{{draw.envelope.meta}}</view>
            </view>
            <view class="dw-env-flap"></view>
            <view class="dw-seal"><text class="dw-seal-mark">✦</text></view>
          </view>

          <!-- 组①：卡面（拆后，轻触翻面） -->
          <view class="dw-cardwrap" wx:if="{{draw.stage === 'after'}}" bindtap="tapCard">
            <view class="dw-flip">
              <view class="dw-flip-inner {{draw.flipped ? 'is-flipped' : ''}}">
                <view class="dw-face dw-frontface {{draw.sig ? 'sig' : ''}}">
                  <view class="dw-bar sig {{draw.sigBar ? 'show' : ''}}" wx:if="{{draw.sig}}"></view>
                  <view class="dw-word {{draw.front.wordCls}}">{{draw.front.word}}</view>
                  <view class="dw-serial">{{draw.front.serial}}</view>
                  <view class="dw-sig-stamp {{draw.sigStamp ? 'show' : ''}}" wx:if="{{draw.sig}}">题眼</view>
                </view>
                <view class="dw-face dw-backface">
                  <view class="dw-bk-no" wx:if="{{draw.back.no}}">{{draw.back.no}}</view>
                  <view class="dw-bk-note" wx:if="{{draw.back.note}}">{{draw.back.note}}</view>
                  <view class="dw-bk-imgwrap" wx:if="{{draw.back.img}}">
                    <image class="dw-bk-img" src="{{draw.back.img}}" mode="aspectFill"/>
                  </view>
                  <view class="dw-bk-empty" wx:if="{{!draw.back.note && !draw.back.img}}">
                    <view class="dw-bk-explain">{{draw.back.explain}}</view>
                    <view class="dw-bk-empty-hint">今天的话，留给回信</view>
                  </view>
                  <view class="dw-bk-date {{draw.back.stampAnim ? 'stamp-anim' : ''}}"
                        wx:if="{{draw.back.date}}">{{draw.back.date}}</view>
                  <view class="dw-bk-count" wx:if="{{draw.back.count}}">已记 {{draw.back.count}} 条</view>
                </view>
              </view>
            </view>
          </view>

          <!-- 组②：一行 mono 提示 -->
          <view class="dw-hint">{{draw.hint}}</view>

          <view class="dw-error" wx:if="{{draw.error}}">
            <text class="dw-error-msg">{{draw.error.message}}</text>
            <view class="dw-error-retry" hover-class="dw-btn-press" bindtap="tapEnvelope">再试一次</view>
          </view>

          <!-- 抽卡回响：心动 + 留一句（无记录也可参与） -->
          <view class="dw-echo" wx:if="{{draw.stage === 'after'}}">
            <view class="dw-echo-like {{draw.social.liked ? 'on' : ''}} {{draw.likePop ? 'pop' : ''}}"
                  hover-class="dw-echo-press" bindtap="toggleSetLike">
              <text class="dw-echo-heart">{{draw.social.liked ? '♥' : '♡'}}</text>
              <text class="dw-echo-n">{{draw.social.likesText}}</text>
              <text class="dw-echo-l">心动</text>
            </view>
            <view class="dw-echo-comment" hover-class="dw-echo-press" bindtap="openComments">
              <text class="dw-echo-pen">✎</text>
              <text>留一句</text>
            </view>
          </view>

          <!-- 组③：动作（次在上，主在下） -->
          <view class="dw-actions">
            <button wx:if="{{draw.cta2}}" class="dw-btn {{draw.cta2.kind}}" hover-class="dw-btn-press"
                    bindtap="tapDrawCta" data-act="cta2">{{draw.cta2.text}}</button>
            <button class="dw-btn {{draw.cta.kind}}" hover-class="dw-btn-press"
                    bindtap="tapDrawCta" data-act="cta">{{draw.cta.text}}</button>
          </view>

          <!-- 再抽抽看：只推荐今天还能抽的卡集 -->
          <view class="draw-rec" wx:if="{{draw.stage === 'after'}}">
            <block wx:if="{{draw.recs && draw.recs.items.length}}">
              <view class="rec-head rec-head-compact">
                <view class="rec-head-t">再抽抽看</view>
                <view class="rec-refresh" bindtap="refreshDrawRecs">换一批 ›</view>
              </view>
              <view class="rec-grid">
                <block wx:for="{{draw.recs.items}}" wx:key="id">
                  <template is="recCard" data="{{item: item}}" />
                </block>
              </view>
            </block>
            <view class="draw-rec-empty" wx:else bindtap="backToHome">
              今天的签都抽过了，去发现逛逛 ›
            </view>
          </view>
        </view>
      </view>
    </view>

      </view>

  <view class="hm-empty" wx:if="{{bootError}}" style="padding:64px 24px 20px">
    <view class="hm-empty-text">内容加载失败，检查一下网络</view>
    <button class="hm-empty-btn" hover-class="hm-press" bindtap="retryBoot">重新加载</button>
  </view>

<!-- ═══════════════════ 大卡弹层 ═══════════════════ -->
  <view class="modal centered {{bigCard.show ? 'show' : ''}}" id="cardModal">
    <view class="sheet" style="padding-top:var(--space-8)">
      <button class="close-btn" bindtap="closeBigCard" style="position:absolute;top:12px;right:12px;z-index:10">✕</button>
      <view class="bigcard {{bigCard.flipped ? 'flipped' : ''}} {{bigCard.lit ? 'lit' : ''}}" id="bigcard" bindtap="toggleBigCardFlip">
        <view class="card-inner">
          <view class="card-face front">
            <view class="cf-top">
              <text class="t-span no">{{bigCard.no}}</text>
            </view>
            <view class="bigword serif {{bigCard.wordCls}}">{{bigCard.word}}</view>
            <view class="bigcard-sig" wx:if="{{bigCard.sig}}">题眼</view>
            <view class="cf-bottom">
              <text class="t-span">{{bigCard.settitle}}</text>
              <view class="t-span flip-hint">
                <image class="t-svg" src="/assets/icons/rotate.png" mode="aspectFit" />
                <text>轻触翻面</text>
              </view>
            </view>
          </view>
          <view class="card-face back" style="padding:0">
            <template is="cardBack" data="{{back: bigCard.back}}" />
          </view>
        </view>
      </view>

      <!-- 大卡操作行：回看任意一张卡时都可分享 -->
      <view class="bigcard-actions">
        <button class="cta secondary" bindtap="openPoster"
                data-type="big"
                data-sid="{{bigCard.back.sid}}"
                data-idx="{{bigCard.back.idx}}">
          {{bigCard.back.rec ? '分享这张明信片' : '分享这张卡'}}
        </button>
      </view>
    </view>
  </view>

  
<!-- ═══════════════════ 分享海报 / 纪念册 ═══════════════════ -->
  <view class="modal centered {{poster.show ? 'show' : ''}}" id="posterModal">
    <view class="sheet poster-sheet {{poster.booklet ? 'booklet' : ''}} {{poster.ratio === '916' && !poster.booklet ? 'scroll' : ''}}">
      <button class="close-btn" bindtap="hidePoster" style="position:absolute;top:12px;right:12px;z-index:10">×</button>
      <view id="posterContent">
        <!-- Type A-916 · 单卡高亮 · 朋友圈 9:16 -->
        <view wx:if="{{poster.kind === 'highlight' && poster.ratio === '916'}}"
              class="poster-card poster-h916 {{poster.sig ? 'sig' : ''}}">
          <image wx:if="{{poster.rec && poster.rec.img}}" class="h916-bg" src="{{poster.rec.img}}" mode="aspectFill" />
          <view wx:if="{{poster.rec && poster.rec.img}}" class="h916-veil"></view>
          <view class="h916-inner">
            <view class="poster-head h916-head">
              <view class="poster-brand">今日做点小事</view>
              <view class="poster-date">{{poster.date}}</view>
            </view>
            <view class="h916-body">
              <view class="h916-card">
                <view class="h916-bar {{poster.sig ? 'sig' : ''}}"></view>
                <view class="h916-cardtop">
                  <text class="h916-no">{{poster.no}}</text>
                  <text class="h916-sig" wx:if="{{poster.sig}}">题眼</text>
                </view>
                <view class="h916-word {{poster.wordCls}}">{{poster.word}}</view>
                <view class="h916-explain" wx:if="{{poster.text}}">{{poster.text}}</view>
                <view class="h916-set">《{{poster.setTitle}}》</view>
              </view>
              <view class="h916-stamp">
                <text class="h916-stamp-date">{{poster.rec ? poster.rec.stampDate : poster.date}}</text>
              </view>
            </view>
            <view class="h916-quote" wx:if="{{poster.rec && poster.rec.note}}">「{{poster.rec.note}}」</view>
            <view class="h916-src">@{{poster.creator}} · 《{{poster.setTitle}}》</view>
            <view class="h916-foot">
              <view class="h916-cta">扫码，抽你的一签</view>
              <view class="poster-qr big">QR</view>
            </view>
          </view>
        </view>

        <!-- Type A · 单卡高亮 -->
        <view wx:elif="{{poster.kind === 'highlight'}}" class="poster-card {{poster.sig ? 'sig' : ''}}">
          <view class="poster-head">
            <view class="poster-brand">今日做点小事</view>
            <view class="poster-date">{{poster.date}}</view>
          </view>
          <view class="poster-highlight">
            <view class="ph-content">
              <view class="ph-no">{{poster.no}}</view>
              <view class="ph-title">{{poster.word}}</view>
              <view class="ph-text">{{poster.text}}</view>
            </view>
            <view class="ph-set">来自 <text class="t-b">《{{poster.setTitle}}》</text></view>
            <view class="poster-sig-stamp" wx:if="{{poster.sig}}">题眼</view>
          </view>
          <view class="poster-setinfo">
            <view class="set-cover"><text>{{poster.setCover}}</text></view>
            <text class="t-span">{{poster.setInfo}}</text>
          </view>

          <view class="poster-sig-note" wx:if="{{poster.sig && poster.signatureNote && !poster.rec}}">✦ 「{{poster.signatureNote}}」</view>

          <view class="poster-rec" wx:if="{{poster.rec}}">
            <view class="poster-rec-label">· 回 信 ·</view>
            <block wx:if="{{poster.rec.img}}">
              <view class="pc-photo">
                <image class="t-img" src="{{poster.rec.img}}" mode="aspectFill" />
                <view class="stamp"><text class="stamp-text">{{poster.rec.stampDate}}</text></view>
              </view>
              <view class="t-p poster-rec-note" wx:if="{{poster.rec.note}}">「{{poster.rec.note}}」</view>
            </block>
            <view class="poster-rec-strip" wx:else>
              <view class="t-p">「{{poster.rec.note}}」</view>
              <view class="stamp"><text class="stamp-text">{{poster.rec.stampDate}}</text></view>
            </view>
          </view>

          <view class="poster-footer">
            <view class="poster-slogan">{{poster.slogan}}</view>
            <view class="poster-qr">QR</view>
          </view>
        </view>

        <!-- Type B-916 · 抽空纪念 · 朋友圈 9:16 -->
        <view wx:elif="{{poster.kind === 'memorial' && poster.ratio === '916'}}"
              class="poster-card poster-memorial poster-m916">
          <view class="poster-head">
            <view class="poster-brand">今日做点小事</view>
            <view class="poster-date">{{poster.dateRange}}</view>
          </view>
          <view class="m916-title">{{poster.title}}</view>
          <view class="m916-sub">《{{poster.setTitle}}》</view>
          <view class="m916-stats">
            <view class="m916-stat"><view class="t-b">{{poster.stats.cards}}</view><text class="t-span">张</text></view>
            <view class="m916-stat"><view class="t-b">{{poster.stats.days}}</view><text class="t-span">天</text></view>
            <view class="m916-stat">
              <view class="t-b {{poster.stats.thirdLabel === '题眼' ? 'gold-num' : ''}}">{{poster.stats.third}}</view>
              <text class="t-span">{{poster.stats.thirdLabel}}</text>
            </view>
          </view>
          <view class="m916-timeline" wx:if="{{poster.timeline.length > 0}}">
            <view class="m916-node {{index === poster.timeline.length - 1 ? 'last' : ''}}"
                  wx:for="{{poster.timeline}}" wx:key="i">
              <text class="t-span m916-node-date">{{item.date}}</text>
              <view class="t-b">{{item.caption}}</view>
            </view>
          </view>
          <view class="m916-quote" wx:if="{{poster.ssrQuote}}">
            <view class="m916-quote-word">「{{poster.ssrQuote.word}}」</view>
            <view class="m916-quote-text">{{poster.ssrQuote.text}}</view>
          </view>
          <view class="m916-stampnote" wx:else>盖了 {{poster.stats.stamped}} 枚邮戳 · 每一枚都是这一程的回信</view>
          <view class="m916-foot">
            <view class="poster-slogan">{{poster.slogan}}</view>
            <view class="poster-qr big">QR</view>
          </view>
        </view>

        <!-- Type B · 抽空纪念 -->
        <view wx:elif="{{poster.kind === 'memorial'}}" class="poster-card poster-memorial">
          <view class="poster-head">
            <view class="poster-brand">今日做点小事</view>
            <view class="poster-date">{{poster.dateRange}}</view>
          </view>
          <view class="pm">
            <view class="pm-eyebrow">{{poster.eyebrow}}</view>
            <view class="pm-title">{{poster.title}}</view>
            <view class="pm-settitle">《{{poster.setTitle}}》</view>
            <view class="pm-stats">
              <view class="pm-stat"><text class="pm-n">{{poster.stats.cards}}</text><text class="pm-l">张</text></view>
              <view class="pm-stat"><text class="pm-n">{{poster.stats.days}}</text><text class="pm-l">天</text></view>
              <view class="pm-stat">
                <text class="pm-n {{poster.stats.thirdLabel === '题眼' ? 'pm-n-gold' : ''}}">{{poster.stats.third}}</text>
                <text class="pm-l">{{poster.stats.thirdLabel}}</text>
              </view>
            </view>
            <view class="pm-timeline">
              <view class="pm-node {{index === poster.timeline.length - 1 ? 'last' : ''}}"
                    wx:for="{{poster.timeline}}" wx:key="i">
                <text class="pm-node-date">{{item.date}}</text>
                <view class="pm-node-dot"></view>
                <text class="pm-node-cap">{{item.caption}}</text>
              </view>
            </view>
            <view wx:if="{{poster.ssrQuote}}" class="pm-quote">
              <view class="pm-quote-word">「{{poster.ssrQuote.word}}」</view>
              <view class="pm-quote-text">{{poster.ssrQuote.text}}</view>
            </view>
            <view wx:else class="pm-stampnote">盖了 {{poster.stats.stamped}} 枚邮戳 · 每一枚都是这一程的回信</view>
          </view>
          <view class="poster-footer">
            <view class="poster-slogan">{{poster.slogan}}</view>
            <view class="poster-qr">QR</view>
          </view>
        </view>

        <!-- Type D · 本周周记（3:4 / 9:16） -->
        <view wx:elif="{{poster.kind === 'weekly'}}"
              class="poster-card poster-weekly {{poster.ratio === '916' ? 'weekly-916' : ''}}">
          <view class="poster-head weekly-head">
            <view class="poster-brand">今日做点小事</view>
            <view class="poster-date">{{poster.range}}</view>
          </view>
          <view class="weekly-kicker">{{poster.kicker}}</view>
          <view class="weekly-title">{{poster.title}}</view>

          <block wx:if="{{poster.variant === 'card'}}">
            <view class="weekly-wall">
              <view class="weekly-card {{item.sig ? 'sig' : ''}}" wx:for="{{poster.cards}}" wx:key="idx">
                <view class="wc-bar"></view>
                <view class="wc-word {{item.wordCls}}">{{item.word}}</view>
              </view>
              <block wx:if="{{poster.ratio === '916'}}">
                <view class="weekly-card blank"><text>明天</text></view>
              </block>
            </view>
          </block>

          <block wx:else>
            <view class="weekly-collage">
              <view class="weekly-polaroid main">
                <image class="t-img" src="{{poster.photos[0].img}}" mode="aspectFill" />
                <view class="polaroid-date">{{poster.photos[0].date}}</view>
              </view>
              <view class="weekly-polaroid sub">
                <image class="t-img" src="{{poster.photos[1].img}}" mode="aspectFill" />
              </view>
            </view>
            <view class="weekly-words">本周的词：{{poster.wordLine}}</view>
          </block>

          <view class="weekly-stamps">
            <view class="weekly-stamp {{item.on ? 'on' : ''}}" wx:for="{{poster.stamps}}" wx:key="k">
              <text>{{item.date}}</text>
            </view>
          </view>

          <view class="weekly-data">
            <text wx:if="{{poster.ratio === '916'}}">本周 <text class="b">{{poster.drawnN}}</text> 签</text>
            <text wx:else>抽了 <text class="b">{{poster.drawnN}}</text> 张</text>
            <text>盖邮戳 <text class="b">{{poster.stampN}}</text></text>
            <text wx:if="{{poster.streak >= 2}}">连续第 <text class="b">{{poster.streak}}</text> 周</text>
          </view>

          <view class="weekly-quote" wx:if="{{poster.quote}}">「{{poster.quote}}」</view>

          <view class="poster-footer weekly-footer">
            <view class="poster-slogan">万物皆可抽一签</view>
            <view class="weekly-foot-right">
              <view class="weekly-cta" wx:if="{{poster.ratio === '916'}}">扫码，抽你的一签</view>
              <view class="poster-qr {{poster.ratio === '916' ? 'big' : ''}}">QR</view>
            </view>
          </view>
        </view>

        <!-- Type C · 纪念册 -->
        <view wx:elif="{{poster.kind === 'booklet'}}" class="poster-booklet">
          <view class="bk-cover {{poster.full ? 'gold' : ''}}">
            <view class="bk-cover-stamp" wx:if="{{poster.full}}">满页纪念</view>
            <view class="poster-brand" style="justify-content:center">今日做点小事</view>
            <view class="bk-cover-title">· 纪 念 册 ·</view>
            <view class="bk-cover-set">《{{poster.title}}》</view>
            <view class="bk-cover-meta">做卡人 @{{poster.creator}} · 共 {{poster.count}} 张</view>
            <view class="bk-cover-stats">
              <view><text class="t-b">{{poster.stN}}</text><text class="t-span">枚邮戳</text></view>
              <view><text class="t-b">{{poster.gotCount}}</text><text class="t-span">张卡</text></view>
              <view><text class="t-b">{{poster.sigLit ? 1 : 0}}</text><text class="t-span">题眼</text></view>
            </view>
            <view class="bk-cover-range">{{poster.firstD ? poster.firstD + ' — ' + poster.lastD : poster.date}}</view>
          </view>

          <view class="bk-section {{item.tilt}}" wx:for="{{poster.sections}}" wx:key="idx">
            <view class="bk-cardface">
              <view class="bk-face-top">
                <view class="ed-sig-mark" wx:if="{{item.sig}}">题</view>
                <text class="t-span bk-no">第 {{item.n + 1}} / {{poster.gotCount}} 张</text>
              </view>
              <view class="t-b bk-word">{{item.word}}</view>
              <text class="t-span bk-explain">{{item.explain}}</text>
              <view class="bk-stamp" wx:if="{{item.rec}}"><text class="stamp-text">{{item.rec.stampDate}}</text></view>
            </view>
            <view class="bk-postcard">
              <block wx:if="{{item.rec}}">
                <view class="pc-photo {{item.rec.img ? '' : 'note-only'}}">
                  <image wx:if="{{item.rec.img}}" class="t-img" src="{{item.rec.img}}" mode="aspectFill" />
                  <view wx:else class="t-p pc-note-strip">「{{item.rec.note || '这一天，做过了'}}」</view>
                  <view class="stamp"><text class="stamp-text">{{item.rec.stampDate}}</text></view>
                </view>
                <view class="pc-letter {{item.rec.img && !item.rec.note ? 'no-note' : ''}}">
                  <view class="t-p pc-explain">{{item.explain}}</view>
                  <view wx:if="{{item.rec.img && item.rec.note}}" class="t-p pc-note"><text class="t-span">「{{item.rec.note}}」</text></view>
                  <view class="pc-meta">
                    <text class="t-b">@{{poster.creator}} · {{poster.title}}</text>
                    <text class="t-span">{{item.rec.date}}</text>
                  </view>
                </view>
              </block>
              <view wx:else class="bk-blank-page"><text class="bk-blank-text">这一天，没有留下照片</text></view>
            </view>
          </view>

          <view class="bk-backcover {{poster.full ? 'gold' : ''}}">
            <view class="t-p bk-final gold" wx:if="{{poster.full}}">{{poster.gotCount}} 张卡，{{poster.stN}} 个邮戳——</view>
            <view class="t-p bk-final gold" wx:if="{{poster.full}}">这就是你做过的那些小事。</view>
            <block wx:else>
              <view class="t-p bk-final">{{poster.gotCount}} 张卡，{{poster.stN}} 个邮戳。</view>
              <view class="t-p bk-back-hint">盖满剩余 {{poster.miss}} 枚邮戳，解锁满页纪念版</view>
            </block>
            <view class="poster-footer">
              <view class="poster-slogan">缺席不损失，卡不会过期</view>
              <view class="poster-qr">QR</view>
            </view>
          </view>
        </view>
      </view>

      <view class="poster-actions">
        <view class="poster-ratio" wx:if="{{!poster.booklet}}">
          <button class="{{poster.ratio === '34' ? 'on' : ''}}" bindtap="setPosterRatio" data-ratio="34">3:4</button>
          <button class="{{poster.ratio === '916' ? 'on' : ''}}" bindtap="setPosterRatio" data-ratio="916">9:16</button>
        </view>
        <button class="cta solid" bindtap="savePoster">保存到相册</button>
        <button class="ghost" bindtap="hidePoster">关闭</button>
      </view>
    </view>
  </view>

  
<!-- ═══════════════════ 盖邮戳 / 回信 ═══════════════════ -->
  <view class="modal {{record.show ? 'show' : ''}}" id="recordModal">
    <view class="sheet bottom-sheet">
      <view class="modal-kind">盖 上 今 天 的 邮 戳</view>
      <view class="modal-title">{{record.title}}</view>
      <view class="t-p modal-body">{{record.sub}}</view>
      <view class="rc-photo {{record.hasImg ? 'has' : ''}}" bindtap="choosePhoto">
        <image wx:if="{{record.hasImg}}" class="t-img" src="{{record.img}}" mode="aspectFill" />
        <view class="rc-photo-del" wx:if="{{record.hasImg}}" catchtap="clearPhoto">×</view>
        <view class="rc-photo-empty" wx:else>
          <image class="t-svg" src="/assets/icons/camera-soft.png" mode="aspectFit" />
          <text class="t-span">拍下今天 · 或从相册选</text>
        </view>
      </view>
      <view class="rc-crop-tip">照片会按 4:3 比例裁剪 · 可拖动缩放取景</view>
      <view class="form-row" style="margin-top:var(--space-4)">
        <textarea class="fi" maxlength="50" value="{{record.note}}" bindinput="onRecordNote" placeholder="也可以只写一句话，不传图"></textarea>
        <view class="t-p rc-count"><text class="t-b">{{record.count}}</text>/50</view>
      </view>
      <view class="modal-actions">
        <button class="cta solid" bindtap="saveStamp">{{record.saveText}}</button>
        <button class="ghost" bindtap="closeRecord">暂时不记</button>
      </view>
      <view class="modal-meta">只给自己看 · 不记录也不影响任何功能</view>
    </view>
  </view>

  
<!-- ═══════════════════ 签友留言 ═══════════════════ -->
  <view class="modal {{commentsSheet.show ? 'show' : ''}}" id="commentsModal">
    <view class="sheet comments-sheet">
      <view class="cs-head">
        <view class="cs-head-txt">
          <view class="cs-kicker">签 友 留 言</view>
          <view class="cs-title">{{commentsSheet.title}}</view>
        </view>
        <button class="close-btn cs-close" bindtap="closeComments">✕</button>
      </view>

      <scroll-view class="cs-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="cs-empty" wx:if="{{!commentsSheet.items.length}}">
          <view class="cs-empty-stamp">签</view>
          <view class="cs-empty-t">还没有人留言</view>
          <view class="cs-empty-s">第一个说话的人，会被看见。</view>
        </view>
        <view class="cs-item" wx:for="{{commentsSheet.items}}" wx:key="id">
          <view class="cs-avatar">{{item.avatar}}</view>
          <view class="cs-main">
            <view class="cs-meta">
              <text class="cs-name">{{item.name}}</text>
              <text class="cs-badge" wx:if="{{item.creator}}">做卡人</text>
              <text class="cs-time">{{item.time}}</text>
            </view>
            <view class="cs-text">{{item.text}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="cs-compose" wx:if="{{commentsSheet.canComment}}">
        <textarea class="cs-textarea" value="{{commentsSheet.draft}}" maxlength="200"
                  auto-height show-confirm-bar="{{false}}" cursor-spacing="24"
                  bindinput="onCommentInput"
                  placeholder="写下你抽到这张卡时，想到的那件小事…"></textarea>
        <view class="cs-compose-foot">
          <text class="cs-counter">{{commentsSheet.draftLen}}/200</text>
          <button class="cs-send {{commentsSheet.draftLen && !commentsSheet.sending ? 'on' : ''}}" bindtap="submitComment">{{commentsSheet.sending ? '发送中…' : '发送'}}</button>
        </view>
      </view>
      <view class="cs-locked" wx:else>
        <view class="cs-lock-t">抽过这张卡集，就可以留一句话。</view>
        <button class="cs-lock-btn" hover-class="sp-social-press" bindtap="goDrawFromComments">去抽今天的卡</button>
      </view>
    </view>
  </view>

  
<!-- ═══════════════════ 付费墙 ═══════════════════ -->
  <view class="modal {{pay.show ? 'show' : ''}}" id="payModal">
    <view class="sheet bottom-sheet">
      <view class="modal-kind">解 锁 卡 集</view>
      <view class="modal-title">{{pay.title}}</view>
      <view class="t-p modal-line">{{pay.line}}</view>
      <view class="t-p modal-body">{{pay.body}}</view>
      <view class="modal-meta">一次解锁，永久有效 · 虚拟商品，解锁后不支持退款</view>
      <view class="modal-actions">
        <button class="cta solid" disabled="{{pay.paying}}" bindtap="doUnlock">{{pay.payText}}</button>
        <button class="ghost" bindtap="closePay">再想想</button>
      </view>
    </view>
  </view>

  
<!-- ═══════════════════ 抽空页 · 金色时刻 ═══════════════════ -->
  <view class="dp" wx:if="{{donePage.show}}">
    <view class="dp-inner">
      <view class="dp-eyebrow">{{donePage.eyebrow}}</view>
      <view class="dp-title">集齐啦</view>
      <view class="dp-setname" wx:if="{{donePage.title}}">《{{donePage.title}}》</view>
      <view class="dp-goldline"></view>
      <view class="dp-dots" style="width:{{donePage.cols * 22}}px">
        <view wx:for="{{donePage.cells}}" wx:key="i"
              class="dp-dot {{item.on ? 'on' : ''}}"
              style="animation-delay:{{160 + index * 26}}ms"></view>
      </view>
      <view class="dp-note">{{donePage.note}}</view>
      <view class="dp-actions {{donePage.ctaShow ? 'show' : ''}}">
        <button class="dp-btn ghost" hover-class="dp-btn-press"
                data-act="back" bindtap="tapDoneAction">回到这一集</button>
        <button class="dp-btn gold" hover-class="dp-btn-press"
                data-act="booklet" bindtap="tapDoneAction">✦ 翻开纪念册</button>
      </view>

      <!-- 抽空后的下一集推荐 -->
      <view class="dp-next {{donePage.ctaShow ? 'show' : ''}}" wx:if="{{donePage.recs && donePage.recs.length}}">
        <view class="dp-next-t">下一集在等你</view>
        <view class="rec-grid">
          <block wx:for="{{donePage.recs}}" wx:key="id">
            <template is="recCard" data="{{item: item}}" />
          </block>
        </view>
        <view class="dp-next-more" bindtap="tapDoneMore">去发现更多 ›</view>
      </view>
    </view>
  </view>

  
<!-- ═══════════════════ 轻提示 ═══════════════════ -->
  <view class="toast {{toastShow ? 'show' : (toastHide ? 'hide' : '')}}" wx:if="{{toastMsg}}">
    <text>{{toastMsg}}</text>
    <view class="toast-progress" wx:if="{{toastShow}}"><view class="t-i"></view></view>
  </view>

</view>
