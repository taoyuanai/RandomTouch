<import src="/templates/common.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
  <view class="screen">
<!-- ═══════════════════ 卡集详情 ═══════════════════ -->
    <view class="page" id="page-set">
<include src="/templates/m-base.wxml"/>

            <view class="skel-hero" wx:if="{{booting}}">
        <view class="skel skel-hero-cover"></view>
        <view class="skel skel-hero-line" style="width:72%"></view>
        <view class="skel skel-hero-line" style="width:46%"></view>
      </view>
<view id="setBody" class="spv2 {{setPage.done ? 'is-done' : ''}}" wx:if="{{setPage.exists && setPage.id}}">
        <view class="share-hint" wx:if="{{setPage.fromShare}}">朋友请你来抽一张</view>

        <!-- ① Hero：大封面签 + 集名 + meta + 热度 -->
        <view class="set-hero">
          <view class="cover-lg {{setPage.cover}}">
            <image wx:if="{{setPage.coverImage}}" class="cover-lg-img" src="{{setPage.coverImage}}" mode="aspectFill" />
            <block wx:else>
              <text class="cov-main">{{setPage.covT}}</text>
              <text class="cov-sub" wx:if="{{setPage.covS}}">{{setPage.covS}}</text>
            </block>
            <view class="cover-price-lg" wx:if="{{setPage.price > 0}}">¥{{setPage.price}}</view>
            <view class="cover-trial-lg" wx:if="{{setPage.trial > 0}}">试{{setPage.trial}}张</view>
          </view>
          <view class="spv2-h1">{{setPage.title}}</view>
          <view class="set-meta">
            <text>{{setPage.kind}}</text>
            <view class="dot-sep"></view>
            <text>{{setPage.count}} 张</text>
            <view class="dot-sep"></view>
            <text>{{setPage.catChip}}</text>
            <block wx:if="{{setPage.signature.on}}">
              <view class="dot-sep"></view>
              <text>藏有一枚题眼</text>
            </block>
          </view>
          <view class="set-heat" wx:if="{{setPage.heatText}}">
            <image class="set-heat-ico" src="/assets/icons/flame.png" mode="aspectFit"/>
            <text>{{setPage.heatText}}</text>
          </view>
          <view class="spv2-chip" wx:if="{{setPage.locked}}">🔒 待解锁</view>
          <!-- 公开互动：心动 / 留言 -->
          <view class="sp-social">
            <view class="sp-like {{setPage.social.liked ? 'on' : ''}} {{setPage.likePop ? 'pop' : ''}}"
                  hover-class="sp-social-press" bindtap="toggleSetLike">
              <text class="sp-heart">{{setPage.social.liked ? '♥' : '♡'}}</text>
              <text class="sp-like-n">{{setPage.social.likesText}}</text>
              <text class="sp-like-l">心动</text>
            </view>
            <view class="sp-comment" hover-class="sp-social-press" bindtap="openComments">
              <text class="sp-comment-t">{{setPage.social.commentText}}</text>
              <view class="sp-chev"></view>
            </view>
            <button class="sp-share" open-type="share" hover-class="sp-social-press">分享</button>
          </view>
        </view>

        <!-- ② 主操作：进入卡集后最重要的动作，放在首屏 -->
        <view id="sp-tail" class="sp-tail">
          <button class="sp-cta {{setPage.cta.kind}}" hover-class="sp-cta-press"
                  bindtap="tapSetCta">{{setPage.cta.text}}</button>
          <view class="sp-tail-note">{{setPage.cta.note}}</view>
        </view>
        <view id="sp-intro-end" style="height:1px"></view>

        <!-- ③ 简介 + 创作者 -->
        <block wx:if="{{setPage.intro || setPage.creator}}">
          <view class="set-intro-plain" wx:if="{{setPage.intro}}">{{setPage.intro}}</view>
          <view class="creator-row" wx:if="{{setPage.creator}}" bindtap="openAuthorPage"
                data-name="{{setPage.creator}}" data-from="set">
            <view class="cavatar">{{setPage.creatorAvatar}}</view>
            <view class="cinfo">
              <view class="t-b">@{{setPage.creator}}</view>
              <text class="t-span">{{setPage.fansText}}</text>
            </view>
            <text class="follow on" wx:if="{{setPage.own}}">你的卡集</text>
            <button class="follow {{setPage.following ? 'on' : ''}}" wx:else hover-class="sb2-press" catchtap="toggleFollowSet">{{setPage.following ? '已关注' : '关注'}}</button>
          </view>
        </block>

        <!-- ③ 收集进度 -->
        <view class="panel spv2-panel" wx:if="{{setPage.prog}}">
          <view class="panel-head"><view class="t-b">收集</view><text class="t-span">{{setPage.kind}}</text></view>
          <view class="progress-hero">
            <text class="ph-left">已抽到</text>
            <view class="ph-right"><text>{{setPage.prog.drawn}}</text><text class="t-span" wx:if="{{setPage.prog.count}}"> / {{setPage.prog.count}} 张</text></view>
          </view>
          <view class="progress-big" wx:if="{{setPage.prog.count}}"><view class="t-i" style="width:{{setPage.prog.pct}}%"></view></view>
          <view class="progress-est" wx:if="{{setPage.prog.est}}">剩 <text class="t-b">{{setPage.prog.est.rest}}</text> 张 · 每天一张，<text class="t-b">{{setPage.prog.est.date}}</text> 抽空它</view>
          <view class="progress-est" wx:elif="{{setPage.kind === '常驻集'}}">每天一签，抽到什么，就是什么。</view>
          <view class="collect-metrics" wx:if="{{setPage.stampRow || setPage.trialRow}}">
            <view class="cm-item" wx:if="{{setPage.stampRow}}">
              <text class="cm-label">邮戳</text>
              <view class="cm-track"><view class="t-i" style="width:{{setPage.stampRow.pct}}%"></view></view>
              <text class="cm-num">{{setPage.stampRow.stN}}/{{setPage.stampRow.gotN}}</text>
            </view>
            <view class="cm-item" wx:if="{{setPage.trialRow}}">
              <text class="cm-label">试抽</text>
              <view class="cm-track trial"><view class="t-i" style="width:{{setPage.trialRow.pct}}%"></view></view>
              <text class="cm-num">{{setPage.trialRow.used}}/{{setPage.trialRow.trial}}</text>
            </view>
          </view>
          <view class="collection-tail-note">最坏的运气，只是晚几天见到它。</view>
          <button class="ghost" hover-class="sb2-press" bindtap="openMap" data-id="{{setPage.id}}">看全图 · 暗格不剧透 ›</button>
        </view>

        <!-- ⑤ 怎么玩 · 一行摘要 -->
        <view class="rule-brief" wx:if="{{setPage.ruleSummary}}" hover-class="rule-brief-press" bindtap="openRules">
          <view class="rule-brief-main">
            <text class="rule-brief-k">怎么玩</text>
            <text class="rule-brief-t">{{setPage.ruleSummary}}</text>
          </view>
          <text class="rule-brief-more">完整玩法 ›</text>
        </view>

        <!-- 精选回信（有则显示） -->
        <block wx:if="{{setPage.picks.length}}">
          <view class="sp-rule"></view>
          <view class="sp-picks">
            <view class="sp-pick" wx:for="{{setPage.picks}}" wx:key="idx"
                  data-idx="{{item.idx}}" bindtap="tapSetCell">
              <view class="sp-pick-head">
                <view class="sp-pick-stamp">{{item.date}}</view>
                <view class="sp-pick-meta">「{{item.word}}」的回信</view>
              </view>
              <view class="sp-pick-note">{{item.note}}</view>
            </view>
          </view>
        </block>

        <!-- 推荐卡集：相关 / 最近热门 -->
        <view class="rec-section" wx:if="{{setPage.recs && setPage.recs.items.length}}">
          <view class="rec-head">
            <view class="rec-head-t">推荐卡集</view>
            <view class="rec-refresh" bindtap="refreshSetRecs">换一批 ›</view>
          </view>
          <view class="rec-tabs">
            <view class="rec-tab {{setPage.recs.tab === 'related' ? 'on' : ''}}"
                  data-tab="related" bindtap="switchSetRecs">相关推荐</view>
            <view class="rec-tab {{setPage.recs.tab === 'hot' ? 'on' : ''}}"
                  data-tab="hot" bindtap="switchSetRecs">最近热门</view>
          </view>
          <view class="rec-grid">
            <block wx:for="{{setPage.recs.items}}" wx:key="id">
              <template is="recCard" data="{{item: item}}" />
            </block>
          </view>
        </view>

        <!-- 浮动 CTA（滚过首屏后浮现） -->
        <view class="sp-float {{floatCta.show ? 'show' : ''}}">
          <button class="sp-cta {{setPage.cta.kind}}" hover-class="sp-cta-press"
                  bindtap="tapSetCta">{{setPage.cta.text}}</button>
        </view>
      </view>
    </view>

      </view>


<!-- ═══════════════════ 怎么玩 · 完整规则 ═══════════════════ -->
  <view class="modal {{rulesSheet.show ? 'show' : ''}}" id="rulesModal">
    <view class="sheet rules-sheet">
      <button class="close-btn rules-close" bindtap="closeRules">✕</button>
      <view class="rules-kicker">抽 卡 说 明</view>
      <view class="rules-title">怎么玩</view>

      <view class="rules-block">
        <view class="rules-h">每天</view>
        <view class="rules-li"><text class="rules-n">1</text><text class="rules-tx">每天可抽 1 张，0 点重置（北京时间）</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">收藏集</view>
        <view class="rules-li"><text class="rules-n">2</text><text class="rules-tx">抽过的不再出现，抽完即空，留一张纪念</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">常驻集</view>
        <view class="rules-li"><text class="rules-n">3</text><text class="rules-tx">天天可抽，抽到就是答案</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">付费集</view>
        <view class="rules-li"><text class="rules-n">4</text><text class="rules-tx">前 1 张免费试抽，试抽不占每日额度</text></view>
        <view class="rules-li"><text class="rules-n">5</text><text class="rules-tx">解锁是一次性的，之后每天照抽</text></view>
      </view>

      <view class="rules-foot">缺席不损失，卡不会过期</view>
    </view>
  </view>

  

<include src="/templates/m-flow.wxml"/>
<include src="/templates/m-set.wxml"/>
</view>
