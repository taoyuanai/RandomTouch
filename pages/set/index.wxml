<import src="/templates/common.wxml"/>
<import src="/templates/card.wxml"/>
<import src="/templates/cover.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
  <view class="v6-topbar" style="padding-top:{{statusBarHeight}}px">
    <view class="v6-topbar-inner">
      <view class="v6-icon-btn" hover-class="hm-press" bindtap="backSetPage">
        <image class="v6-icon" src="/assets/icons/v6/arrow-left-ink.png" mode="aspectFit" />
      </view>
      <text class="v6-topbar-title">卡集详情</text>
      <button class="v6-icon-btn v6-share-btn" open-type="share">
        <image class="v6-icon" src="/assets/icons/v6/share-2-ink.png" mode="aspectFit" />
      </button>
    </view>
  </view>

  <view class="screen">
    <view class="page v6-set-page" id="page-set">
      <include src="/templates/m-base.wxml"/>

      <view class="skel-hero" wx:if="{{booting}}">
        <view class="skel skel-hero-cover"></view>
        <view class="skel skel-hero-line" style="width:72%"></view>
        <view class="skel skel-hero-line" style="width:46%"></view>
      </view>

      <view id="setBody" class="v6-set-detail" wx:if="{{setPage.exists && setPage.id}}">
        <view class="v6-share-hint" wx:if="{{setPage.fromShare}}">朋友请你来抽一张</view>

        <view class="v6-detail-hero">
          <view class="v6-detail-cover">
            <template is="coverArt" data="{{item: setPage.coverArt}}" />
          </view>
          <view class="v6-detail-info">
            <text class="v6-detail-kicker">{{setPage.catChip}} · 共 {{setPage.count}} 张</text>
            <view class="v6-detail-title">{{setPage.title}}</view>
            <text class="v6-detail-sub" wx:if="{{setPage.covS}}">{{setPage.covS}}</text>
            <view class="v6-detail-creator" hover-class="hm-press" bindtap="openAuthorPage"
                  data-name="{{setPage.creator}}" data-from="set">{{setPage.creator}}</view>
            <view class="v6-detail-stats">
              <view><text class="v6-detail-num">{{setPage.fansShort}}</text><text class="v6-detail-l">订阅</text></view>
              <view><text class="v6-detail-num">{{setPage.social.likesShort}}</text><text class="v6-detail-l">心动</text></view>
            </view>
          </view>
        </view>

        <view class="v6-detail-actions {{setPage.own ? 'single' : ''}}">
          <view class="v6-btn primary" hover-class="hm-press" bindtap="tapSetCta">{{setPage.cta.text}}</view>
          <block wx:if="{{!setPage.own}}">
            <view wx:if="{{setPage.canSubscribe}}" class="v6-btn secondary" hover-class="hm-press" bindtap="subscribeSet">{{setPage.subBusy ? '订阅中…' : '订阅卡集'}}</view>
            <view wx:elif="{{setPage.subscribed}}" class="v6-btn secondary" hover-class="hm-press" bindtap="goSubsPage">
              <image class="v6-icon" src="/assets/icons/v6/check-ink.png" mode="aspectFit" /> 已订阅
            </view>
            <view wx:else class="v6-btn secondary is-static">待解锁</view>
          </block>
        </view>

        <view class="v6-detail-section" wx:if="{{setPage.prog}}" hover-class="hm-press" bindtap="openMap" data-id="{{setPage.id}}">
          <view class="v6-detail-sec-head">
            <text class="v6-detail-sec-t">我的收集</text>
            <text class="v6-detail-progress-n">{{setPage.prog.drawn}}<text wx:if="{{setPage.prog.count}}"> / {{setPage.prog.count}} 张</text></text>
          </view>
          <view class="v6-detail-progress"><view class="t-i" style="width:{{setPage.prog.pct}}%"></view></view>
          <text class="v6-detail-sec-sub">{{setPage.kind === '常驻集' ? '每天一签，抽到什么，就是什么。' : '每一次抽卡，都是往完整卡册走近一步。'}}</text>
        </view>
        <view class="v6-detail-section" wx:else>
          <view class="v6-detail-sec-head"><text class="v6-detail-sec-t">我的收集</text></view>
          <text class="v6-detail-sec-sub">订阅后，每天抽一张，慢慢收集。</text>
        </view>

        <view class="v6-detail-section" wx:if="{{setPage.intro}}">
          <text class="v6-detail-about-t">关于这个卡集</text>
          <text class="v6-detail-about-p">{{setPage.intro}}</text>
          <text class="v6-detail-disclaimer" wx:if="{{setPage.disclaimer}}">{{setPage.disclaimer}}</text>
        </view>

        <view class="v6-detail-section v6-detail-rule" hover-class="hm-press" bindtap="openRules">
          <text class="v6-detail-sec-t">怎么玩</text>
          <image class="v6-icon" src="/assets/icons/v6/chevron-right-ink.png" mode="aspectFit" />
        </view>

        <view class="v6-detail-section v6-detail-comments" hover-class="hm-press" bindtap="openComments">
          <view class="v6-detail-sec-head">
            <text class="v6-detail-comments-t">签友留言</text>
            <view class="v6-detail-comment-more">
              <text>{{setPage.social.commentCount ? '全部 ' + setPage.social.commentCount + ' 条' : '写第一条留言'}}</text>
              <image class="v6-icon" src="/assets/icons/v6/chevron-right-brand.png" mode="aspectFit" />
            </view>
          </view>
          <view class="v6-comment-teaser" wx:if="{{setPage.commentPreview}}">
            <view class="v6-comment-avatar">{{setPage.commentPreview.avatar}}</view>
            <view class="v6-comment-body">
              <view class="v6-comment-name">{{setPage.commentPreview.name}}</view>
              <view class="v6-comment-text">{{setPage.commentPreview.text}}</view>
            </view>
          </view>
          <view class="v6-comment-empty" wx:else>还没有人留言 · 第一个说话的人，会被看见。</view>
        </view>
      </view>
    </view>
  </view>

<!-- ═══════════════════ 怎么玩 · 完整规则 ═══════════════════ -->
  <view class="modal {{rulesSheet.show ? 'show' : ''}}" id="rulesModal">
    <view class="sheet rules-sheet">
      <button class="close-btn rules-close" bindtap="closeRules">✕</button>
      <view class="rules-kicker">抽 卡 说 明</view>
      <view class="rules-title">怎么玩</view>

      <view class="rules-block">
        <view class="rules-h">每天</view>
        <view class="rules-li"><text class="rules-n">1</text><text class="rules-tx">每天可抽 1 张，0 点重置（北京时间）</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">收藏集</view>
        <view class="rules-li"><text class="rules-n">2</text><text class="rules-tx">抽过的不再出现，抽完即空，留一张纪念</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">常驻集</view>
        <view class="rules-li"><text class="rules-n">3</text><text class="rules-tx">天天可抽，抽到就是答案</text></view>
      </view>
      <view class="rules-block">
        <view class="rules-h">付费集</view>
        <view class="rules-li"><text class="rules-n">4</text><text class="rules-tx">前 1 张免费试抽，试抽不占每日额度</text></view>
        <view class="rules-li"><text class="rules-n">5</text><text class="rules-tx">解锁是一次性的，之后每天照抽</text></view>
      </view>

      <view class="rules-foot">缺席不损失，卡不会过期</view>
    </view>
  </view>

  

<include src="/templates/m-flow.wxml"/>
<include src="/templates/m-set.wxml"/>
</view>
