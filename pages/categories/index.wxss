
#page-categories{padding-top:0;padding-bottom:36px}
.v6-cat-page{padding-top:0}
.v6-cat-lead{padding:18px 0 4px}
.v6-cat-lead .v6-muted{display:block;margin-top:4px;font-size:13px}
.v6-cat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 16px;padding-top:18px}
.v6-cat-card{min-width:0}
.v6-cat-name{margin-top:10px;font-size:15px;font-weight:600;color:var(--v6-ink);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.v6-cat-count{margin-top:3px;font-size:12px;color:var(--v6-ink-3)}