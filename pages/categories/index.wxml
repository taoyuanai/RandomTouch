<import src="/templates/cover.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
  <view class="v6-topbar" style="padding-top:{{statusBarHeight}}px">
    <view class="v6-topbar-inner">
      <view class="v6-icon-btn" hover-class="hm-press" bindtap="backCategories">
        <image class="v6-icon" src="/assets/icons/v6/arrow-left-ink.png" mode="aspectFit" />
      </view>
      <text class="v6-topbar-title">分类</text>
      <view class="v6-topbar-spacer"></view>
    </view>
  </view>

  <view class="page v6-cat-page" id="page-categories">
    <include src="/templates/m-base.wxml"/>

    <view class="v6-cat-lead">
      <view class="v6-h2">按主题找卡集</view>
      <text class="v6-muted">{{categories.total}} 个卡集 · 九类</text>
    </view>

    <view class="skel-list" wx:if="{{booting}}">
      <view class="skel-book" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
        <view class="skel skel-cover"></view>
        <view class="skel-book-txt">
          <view class="skel skel-line" style="width:70%"></view>
          <view class="skel skel-line" style="width:45%"></view>
        </view>
      </view>
    </view>

    <view class="v6-cat-grid" wx:else>
      <view class="v6-cat-card" wx:for="{{categories.items}}" wx:key="key"
            hover-class="hm-press" bindtap="tapCategory" data-key="{{item.key}}">
        <template is="coverArt" data="{{item: item.cover}}" />
        <view class="v6-cat-name">{{item.name}}</view>
        <view class="v6-cat-count">{{item.countText}}</view>
      </view>
    </view>
  </view>
</view>
