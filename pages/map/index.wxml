<import src="/templates/common.wxml"/>
<import src="/templates/card.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
  <view class="screen">
<view class="page" id="page-map">
<include src="/templates/m-base.wxml"/>

      <view id="mapBody">
        <view class="panel">
          <view class="panel-head"><text class="t-b">全图</text><text class="t-span">{{mapV.drawn}} / {{mapV.count}} 已抽到</text></view>
          <view class="progress"><view class="t-i" style="width:{{mapV.pct}}%"></view></view>
          <view class="t-p tiny" style="text-align:left;padding:0 2px;margin-top:8px">暗格不显示任何字——没抽到之前，它只是空的。</view>
          <view class="sheet">
            <view class="sheet-row" wx:for="{{mapV.rows}}" wx:key="index" wx:for-index="ri">
              <view class="stamp-cell {{cell.state}}" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="idx"
                    bindtap="mapCellTap" data-idx="{{cell.idx}}" hover-class="cell-press">
                <view class="cell-in" style="--cw:105px;--ch:148px;--ink:{{cell.ink}};--ink-line:{{cell.inkLine}};--ink-faint:{{cell.inkFaint}}">
                  <block wx:if="{{cell.state !== 'blank'}}">
                    <template is="cardFront" data="{{c: cell.card}}"/>
                  </block>
                  <view wx:else class="blank-cell"><text class="blank-no">{{cell.no}}</text></view>
                  <view class="cell-pmk {{cell.pmkState}}" wx:if="{{cell.pmkState}}"/>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ═══════════════════ 编辑器 / 审核 ═══════════════════ -->
      </view>


<include src="/templates/m-flow.wxml"/>
</view>
