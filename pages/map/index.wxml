<view class="phone" style="--statusbar:0px;--navtop:0px">
  <v6-topbar title="全图" status-bar-height="{{statusBarHeight}}" bind:back="backMap" />

  <view class="page v6-map-page" id="page-map">
    <include src="/templates/m-base.wxml"/>

    <view class="v6-map-summary">
      <view class="v6-map-sum-head">
        <text class="v6-h2">收集进度</text>
        <text class="v6-count">{{mapV.drawn}} / {{mapV.count}} 已抽到</text>
      </view>
      <view class="v6-progress"><view class="t-i" style="width:{{mapV.pct}}%"></view></view>
      <view class="v6-map-note">暗格不显示任何字——没抽到之前，它只是空的。</view>
      <view class="v6-map-drawn" wx:if="{{mapV.drawnWords.length}}">
        <text class="v6-map-drawn-label">已抽到</text>
        <view class="v6-map-drawn-chips">
          <text class="v6-map-drawn-chip" wx:for="{{mapV.drawnWords}}" wx:key="idx">{{item.w}}</text>
        </view>
      </view>
    </view>

    <view class="v6-map-grid">
      <view class="v6-map-cell {{cell.full ? 'is-full' : 'is-blank'}} {{cell.pmkState}}"
            wx:for="{{mapV.cells}}" wx:key="idx"
            data-idx="{{cell.idx}}" bindtap="mapCellTap" hover-class="hm-press">
        <view wx:if="{{cell.full}}" class="v6-map-word {{cell.card.wCls}}">{{cell.card.word}}</view>
        <view wx:else class="v6-map-no">{{cell.no}}</view>
        <view wx:if="{{cell.pmkState}}" class="v6-map-pmk"></view>
      </view>
    </view>
  </view>

<include src="/templates/m-flow.wxml"/>
</view>
