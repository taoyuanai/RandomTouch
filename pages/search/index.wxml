<import src="/templates/cover.wxml"/>
<view class="phone" style="--statusbar:0px;--navtop:0px">
  <view class="v6-search-head" style="padding-top:{{statusBarHeight}}px">
    <view class="v6-search-head-inner" style="padding-right:{{menuPad}}px">
      <view class="v6-icon-btn" hover-class="hm-press" bindtap="closeSearch">
        <image class="v6-icon" src="/assets/icons/v6/arrow-left-ink.png" mode="aspectFit" />
      </view>
      <view class="v6-search-box">
        <image class="v6-icon" src="/assets/icons/v6/search-ink.png" mode="aspectFit" />
        <input class="v6-search-input" value="{{search.q}}" focus="{{search.focus}}"
               placeholder="搜索卡集、做卡人或关键词" confirm-type="search" maxlength="30"
               bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
        <view wx:if="{{search.q}}" class="v6-search-clear" bindtap="clearSearch">
          <image class="v6-icon" src="/assets/icons/v6/x-ink.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view class="page v6-search-page" id="page-search">
    <include src="/templates/m-base.wxml"/>

    <view class="skel-list" wx:if="{{booting}}">
      <view class="skel-book" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skel skel-cover"></view>
        <view class="skel-book-txt">
          <view class="skel skel-line" style="width:70%"></view>
          <view class="skel skel-line" style="width:45%"></view>
        </view>
      </view>
    </view>

    <block wx:elif="{{!search.q}}">
      <view class="v6-hot">
        <view class="v6-hot-title">大家都在搜</view>
        <view class="v6-hot-chips">
          <view class="chip" wx:for="{{search.suggestions}}" wx:key="*this"
                hover-class="hm-press" data-q="{{item}}" bindtap="tapSearchWord">{{item}}</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{search.rows.length}}">
      <view class="v6-list-head">
        <text class="v6-h2">搜索结果</text>
        <text class="v6-count">{{search.rows.length}} 个卡集</text>
      </view>
      <view id="squareList" class="v6-set-list">
        <set-row wx:for="{{search.rows}}" wx:key="id" item="{{item}}" mode="public"
                 data-id="{{item.id}}" data-from="search" bind:rowtap="openSet" />
      </view>
    </block>

    <view class="v6-empty" wx:else>
      <view class="v6-empty-symbol">
        <image class="v6-icon" src="/assets/icons/v6/search-brand.png" mode="aspectFit" />
      </view>
      <view class="v6-empty-t">没有找到「{{search.q}}」</view>
      <view class="v6-empty-p">试试更短的关键词，或搜做卡人</view>
      <view class="v6-btn text" bindtap="clearSearch">清空重搜</view>
    </view>
  </view>
</view>
