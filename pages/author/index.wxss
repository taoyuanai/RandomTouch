.v6-author-page{padding-top:0}
.v6-author-profile{padding:22px 0 25px;text-align:center}
.v6-author-avatar{width:64px;height:64px;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--v6-orange);color:var(--v6-on-orange);font-size:27px;font-weight:700}
.v6-author-avatar-img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover}
.v6-author-name{margin-top:14px;font-size:20px;line-height:28px;font-weight:700;color:var(--v6-ink)}
.v6-author-role{margin-top:4px;font-size:13px;color:var(--v6-ink-3)}
.v6-author-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:20px;padding:19px 0;border-top:1px solid var(--v6-line);border-bottom:1px solid var(--v6-line)}
.v6-author-stats>view{display:flex;flex-direction:column;align-items:center;gap:3px;border-right:1px solid var(--v6-line)}
.v6-author-stats>view:last-child{border-right:0}
.v6-author-stats strong{font-size:26px;line-height:32px;font-weight:700;color:var(--v6-ink);font-variant-numeric:tabular-nums}
.v6-author-stats span{font-size:12px;color:var(--v6-ink-2)}
.v6-author-follow{padding:20px 0 4px}
.v6-author-note{padding:30px 0 10px;text-align:center;font-size:13px;color:var(--v6-ink-2)}
