# ==================== Flask 运行配置 ====================
FLASK_HOST=0.0.0.0
# macOS 上 5000 常被 AirPlay 占用，本机开发建议 5001
FLASK_PORT=5001
FLASK_DEBUG=false

# 会话密钥：生产环境必须设置为随机长字符串（python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=
SESSION_HOURS=8
# 可选：登录域名与回跳域名不同（如 www 与裸域）时，设 .example.com 共享会话 Cookie
# SESSION_COOKIE_DOMAIN=

# ==================== 目录 ====================
CSV_DIR=csv_files
HISTORY_DIR=history
USERS_DIR=users
LOGS_DIR=logs
LOG_LEVEL=INFO
MAX_SEARCH_WORKERS=5

# ==================== MySQL ====================
MySQL_Host=
MySQL_Port=3306
MySQL_User=
MySQL_Password=
MySQL_Db=

# ==================== AI 平台（按需填写） ====================
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
QIANWEN_API_KEY=
QIANWEN_MODEL=qwen3.8-flash
YUANBAO_API_KEY=
YUANBAO_MODEL=hy3
WENXIN_API_KEY=
WENXIN_MODEL=ernie-5.1  # 千帆 Model Builder 模型 ID（须该工作区已启用）
KIMI_API_KEY=
KIMI_MODEL=kimi-latest
DEEPSEEK_REASONING_EFFORT=minimal
YUANBAO_REASONING_EFFORT=no_think
YUANBAO_MAX_TOOL_CALLS=1

# ==================== 腾讯云短信（按需填写） ====================
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
